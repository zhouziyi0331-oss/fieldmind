        "project_id",
        "dimension_category",
        "speaker",
        "quality_score"
      ],
      "notes": [
        "chunk \u4ece\u8bde\u751f\u8d77\u5c31\u643a\u5e26\u5b8c\u6574\u4fe1\u606f",
        "\u5207\u5206\u65f6\u540c\u6b65\u5b8c\u6210\uff1a\u8bf4\u8bdd\u4eba\u6807\u6ce8\u3001\u60c5\u7eea\u91cf\u5316\u3001\u5b9e\u4f53\u8bc6\u522b\u3001\u7ef4\u5ea6\u5f52\u7c7b",
        "\u4efb\u4f55\u4e00\u4e2a chunk\uff0c\u90fd\u80fd\u76f4\u63a5\u56de\u7b54\uff1a\u8c01\u8bf4\u7684\u3001\u4ec0\u4e48\u60c5\u7eea\u3001\u5c5e\u4e8e\u4ec0\u4e48\u7ef4\u5ea6\u3001\u6d89\u53ca\u4ec0\u4e48\u5b9e\u4f53"
      ]
    },
    "entities": {
