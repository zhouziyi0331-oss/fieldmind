# FieldMind Production Environment Configuration
# 警告：此文件包含生产环境配置，请勿提交到版本控制

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
HOST=0.0.0.0
PORT=8000

# ============================================
# Database Configuration
# ============================================
# SQLite (开发/小规模部署)
DATABASE_URL=sqlite:////app/data/fieldmind.db

# PostgreSQL (生产环境推荐)
# DATABASE_URL=postgresql://fieldmind:password@postgres:5432/fieldmind

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ============================================
# Neo4j Configuration
# ============================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fieldmind_password_change_in_production

# ============================================
# CORS Settings
# ============================================
CORS_ORIGINS=["https://fieldmind.example.com","https://www.fieldmind.example.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ============================================
# Security Settings
# ============================================
# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码哈希
PASSWORD_HASH_ALGORITHM=bcrypt
PASSWORD_MIN_LENGTH=8

# API限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# File Upload Settings
# ============================================
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=["pdf","txt","doc","docx","md","csv"]
UPLOAD_DIR=/app/uploads
REPORT_OUTPUT_DIR=/app/reports

# ============================================
# AI/LLM Configuration
# ============================================
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama (本地模型)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ============================================
# Monitoring & Logging
# ============================================
# Sentry (错误追踪)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/fieldmind.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# Performance Settings
# ============================================
# 缓存
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=512

# 数据库连接池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Worker配置
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_TIMEOUT=120
WORKER_KEEPALIVE=5

# ============================================
# Backup Settings
# ============================================
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_CRON=0 2 * * *

# ============================================
# Email Settings (Optional)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@fieldmind.example.com
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=noreply@fieldmind.example.com

# ============================================
# External Services
# ============================================
# Firecrawl (网页爬取)
FIRECRAWL_API_KEY=

# S3 Storage (可选的文件存储)
S3_ENABLED=false
S3_BUCKET=fieldmind-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
