# FieldMind 环境配置文件
# 这是生产环境的配置模板，请根据实际情况修改

# ==================== 应用配置 ====================
APP_NAME=FieldMind
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ==================== 数据库配置 ====================
POSTGRES_USER=fieldmind_prod
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fieldmind_prod
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_PRE_PING=True
POSTGRES_QUERY_TIMEOUT=30
POSTGRES_ECHO_SQL=False

# ==================== Neo4j配置 ====================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_QUERY_TIMEOUT=60

# ==================== Redis配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<CHANGE_ME_IF_NEEDED>
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_KEEPALIVE=True
REDIS_RETRY_ON_TIMEOUT=True
REDIS_HEALTH_CHECK_INTERVAL=30

# ==================== ChromaDB配置 ====================
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_TIMEOUT=30

# ==================== AI服务配置 ====================
# OpenAI
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_ORGANIZATION=<YOUR_ORG_ID>
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=3

# Anthropic
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
ANTHROPIC_TIMEOUT=120

# Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=zh

# Embedding
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# RAGFlow
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=<YOUR_RAGFLOW_API_KEY>

# ==================== 文件存储配置 ====================
UPLOAD_DIR=./uploads
DATA_DIR=./data
TEMP_DIR=./temp
MAX_FILE_SIZE=524288000
MAX_VIDEO_SIZE=2147483648
MAX_AUDIO_SIZE=209715200
MAX_DOCUMENT_SIZE=104857600
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_PROCESSING=3

# ==================== 安全配置 ====================
# JWT - 生产环境必须使用强密钥！
SECRET_KEY=<GENERATE_STRONG_RANDOM_KEY_MIN_32_CHARS>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=True

# 速率限制
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# 安全选项
ALLOW_PASSWORD_RESET=True
REQUIRE_EMAIL_VERIFICATION=True
PASSWORD_MIN_LENGTH=12

# ==================== 处理配置 ====================
MAX_TEXT_LENGTH=1000000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_STRATEGY=semantic

# 网络分析
SIMILARITY_THRESHOLD=0.85
MIN_DOCUMENTS_FOR_NETWORK=2
MIN_DOCUMENTS_FOR_DEEP_ANALYSIS=3

# 实体提取
ENTITY_EXTRACTION_ENABLED=True
ENTITY_CONFIDENCE_THRESHOLD=0.7

# 批处理
BATCH_SIZE=100

# 并发控制
THREAD_POOL_WORKERS=4
PROCESS_POOL_WORKERS=2

# ==================== 监控配置 ====================
# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=True

# Metrics
METRICS_ENABLED=True
METRICS_PORT=9090

# 健康检查
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_INTERVAL=30

# Sentry (可选)
SENTRY_DSN=<YOUR_SENTRY_DSN>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
