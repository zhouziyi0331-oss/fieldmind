# FieldMind 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ============= 数据库配置 =============
DATABASE_URL=sqlite:///./data/fieldmind.db
# 或使用 PostgreSQL:
# DATABASE_URL=postgresql://fieldmind:fieldmind_pass@localhost:5432/fieldmind

# ============= AI API Keys =============
# OpenAI (用于 GPT 模型和 Whisper)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude (用于对话和长记忆)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# HuggingFace (可选，用于私有模型)
HUGGINGFACE_TOKEN=your-huggingface-token-here

# ============= 向量数据库 =============
# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=./chroma_db

# ============= Redis 缓存 (可选) =============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============= Neo4j 图数据库 (可选) =============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fieldmind123

# ============= RAGFlow 配置 (可选) =============
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=your-ragflow-key-here

# ============= 应用配置 =============
DEBUG=true
HOST=0.0.0.0
PORT=8000

# JWT 密钥 (生产环境务必更改!)
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ============= 语音识别 =============
# 选择引擎: whisper 或 funasr
ASR_ENGINE=funasr

# Whisper 配置
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# FunASR 配置
FUNASR_MODEL=paraformer-zh
FUNASR_HOTWORDS=口述历史 田野调查
