# ===================
# 应用配置
# ===================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-min-32-characters-long-change-in-production

# ===================
# 数据库配置
# ===================
# SQLite (开发环境)
DATABASE_URL=sqlite:///./data/fieldmind.db

# PostgreSQL (生产环境 - Docker)
# DATABASE_URL=postgresql://fieldmind:fieldmind_password@localhost:5432/fieldmind

# ===================
# Redis配置
# ===================
REDIS_URL=redis://localhost:6379/0

# ===================
# Neo4j图数据库配置
# ===================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ===================
# AI服务配置
# ===================
# Anthropic Claude API (必需)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API (可选)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# ===================
# JWT认证配置
# ===================
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================
# 文件存储配置
# ===================
UPLOAD_DIR=./uploads
SKILLS_DIR=./skills
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE=104857600  # 100MB

# ===================
# CORS配置
# ===================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ===================
# 向量数据库配置
# ===================
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ===================
# Mem0长期记忆配置
# ===================
MEM0_CHROMA_PATH=./data/mem0_chroma
MEM0_LLM_MODEL=claude-3-haiku-20240307

# ===================
# 音频处理配置
# ===================
WHISPER_MODEL=large-v3

# ===================
# Celery任务队列配置
# ===================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===================
# API配置
# ===================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ===================
# 日志配置
# ===================
LOG_LEVEL=INFO
LOG_FILE=./logs/fieldmind.log

# ===================
# LLM配置（本地模型 - 可选）
# ===================
# LLM_MODEL_PATH=./models/chatglm3-6b
# LLM_DEVICE=cuda  # cuda, cpu, mps
