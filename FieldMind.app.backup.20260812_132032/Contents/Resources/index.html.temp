                </button>
                <button class="btn btn-outline" onclick="showToast('工作流已复制','success')">复制</button>
                <button class="btn btn-ghost" onclick="showToast('编辑工作流','info')">编辑</button>
                <button class="btn btn-ghost" style="margin-left:auto;color:var(--text4);" onclick="showToast('已导出为 JSON','success')">导出</button>
              </div>
            </div>
          </div>

          <div class="workflow-card" data-type="analysis">
            <div class="workflow-card-hd" onclick="this.closest('.workflow-card').classList.toggle('open')">
              <div class="workflow-card-icon green">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
              </div>
              <div class="workflow-card-meta">
                <div class="workflow-card-name">费孝通框架深度分析</div>
                <div class="workflow-card-desc">差序格局 + 乡土中国理论应用 · 3步 · 已用7次</div>
              </div>
              <div class="workflow-card-badges">
                <span class="tag tag-green">分析框架</span>
                <span class="tag tag-sky">高频使用</span>
              </div>
            </div>
            <div class="workflow-card-body">
              <div class="workflow-steps">
                <div class="workflow-step">
                  <div class="workflow-step-num">1</div>
                  <div class="workflow-step-body">
                    <div class="workflow-step-title">识别差序格局层次</div>
                    <div class="workflow-step-desc">从材料中识别核心圈（家庭）、次级圈（宗族）、外围圈（村落）的人物关系</div>
