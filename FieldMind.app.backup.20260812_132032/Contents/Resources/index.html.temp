<!-- JavaScript函数 -->
<script>
function openKeywordModal(keyword) {
  document.getElementById('keyword-detail-modal').style.display = 'flex';
}

function closeKeywordModal() {
  document.getElementById('keyword-detail-modal').style.display = 'none';
}

function switchKeywordTab(tab) {
  // 隐藏所有tab内容
  document.querySelectorAll('.kw-tab-content').forEach(el => el.style.display = 'none');
  // 移除所有tab的active状态
  document.querySelectorAll('#keyword-detail-modal .tab').forEach(el => el.classList.remove('active'));
  // 显示选中的tab
  document.getElementById('kw-tab-' + tab).style.display = 'block';
  // 添加active状态到当前tab
  event.target.classList.add('active');
}

// 点击背景关闭弹窗
document.getElementById('keyword-detail-modal')?.addEventListener('click', function(e) {
  if (e.target === this) {
    closeKeywordModal();
  }
});
</script>
