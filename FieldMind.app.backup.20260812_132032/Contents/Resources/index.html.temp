<!-- 上传材料弹窗 -->
<div id="upload-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:var(--surface);border-radius:12px;width:90%;max-width:600px;box-shadow:0 20px 60px rgba(0,0,0,0.3);overflow:hidden;">
    <div style="padding:20px 24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
      <div style="font-size:16px;font-weight:700;color:var(--text);">上传材料</div>
      <button onclick="closeUploadModal()" style="background:var(--surface2);border:none;width:32px;height:32px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;">
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--text3);fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div style="padding:24px;">
      <!-- 上传区域 -->
      <div style="border:2px dashed var(--border2);border-radius:10px;padding:40px 20px;text-align:center;background:var(--surface2);cursor:pointer;margin-bottom:20px;" onclick="document.getElementById('file-input').click()">
        <svg viewBox="0 0 24 24" style="width:48px;height:48px;stroke:var(--a1);fill:none;stroke-width:2;margin:0 auto 16px;"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:6px;">点击上传或拖拽文件到此处</div>
        <div style="font-size:11px;color:var(--text3);">支持 MP3、MP4、PDF、DOCX、XLSX、TXT 等格式</div>
        <input type="file" id="file-input" multiple style="display:none;" onchange="handleFileSelect(event)">
      </div>

      <!-- 已选择文件列表 -->
      <div id="file-list" style="display:none;margin-bottom:20px;">
        <div style="font-size:12px;font-weight:700;color:var(--text);margin-bottom:10px;">已选择 <span id="file-count">0</span> 个文件</div>
        <div id="file-items" style="display:flex;flex-direction:column;gap:8px;max-height:200px;overflow-y:auto;"></div>
      </div>

      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button onclick="closeUploadModal()" style="padding:8px 16px;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--text2);font-size:12px;font-weight:600;cursor:pointer;">取消</button>
        <button id="upload-confirm-btn" onclick="startUpload()" disabled style="padding:8px 16px;border:none;border-radius:7px;background:var(--a1);color:white;font-size:12px;font-weight:600;cursor:pointer;opacity:0.5;">开始上传</button>
      </div>
    </div>
  </div>
</div>

<!-- 上传进度弹窗 -->
<div id="upload-progress-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:var(--surface);border-radius:12px;width:90%;max-width:480px;box-shadow:0 20px 60px rgba(0,0,0,0.3);overflow:hidden;">
    <div style="padding:20px 24px;border-bottom:1px solid var(--border);">
      <div style="font-size:16px;font-weight:700;color:var(--text);">正在上传</div>
    </div>
    <div style="padding:24px;">
      <div style="margin-bottom:20px;">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
          <span style="font-size:12px;color:var(--text2);">上传进度</span>
          <span id="upload-percentage" style="font-size:12px;color:var(--a1);font-weight:700;">0%</span>
        </div>
        <div style="height:8px;background:var(--surface3);border-radius:4px;overflow:hidden;">
          <div id="upload-progress-bar" style="height:100%;width:0%;background:var(--a1);border-radius:4px;transition:width 0.3s;"></div>
        </div>
      </div>
      <div style="font-size:11px;color:var(--text3);text-align:center;">
        已上传 <span id="uploaded-count">0</span> / <span id="total-count">0</span> 个文件
      </div>
    </div>
  </div>
</div>

<style>
@keyframes slideIn {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}
</style>

<script>
// 下载功能
// 已删除重复的 openDlModal 函数，使用全局统一的版本

// 上传功能
function openUploadModal() {
  document.getElementById('upload-modal').style.display = 'flex';
}

function closeUploadModal() {
  document.getElementById('upload-modal').style.display = 'none';
  document.getElementById('file-input').value = '';
  document.getElementById('file-list').style.display = 'none';
  document.getElementById('file-items').innerHTML = '';
}

let selectedFiles = [];

// ==========================================
// handleFileSelect 主函数
// 处理上传模态框和材料导入页面的文件选择
// ==========================================

function handleFileSelect(event) {
  selectedFiles = Array.from(event.target.files);
  if (selectedFiles.length > 0) {
    document.getElementById('file-list').style.display = 'block';
    document.getElementById('file-count').textContent = selectedFiles.length;
    document.getElementById('upload-confirm-btn').disabled = false;
    document.getElementById('upload-confirm-btn').style.opacity = '1';

    const fileItems = document.getElementById('file-items');
    fileItems.innerHTML = '';
    selectedFiles.forEach((file, index) => {
      const fileItem = document.createElement('div');
      fileItem.style.cssText = 'display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--surface);border:1px solid var(--border);border-radius:6px;';

      const fileIcon = getFileIcon(file.name);
      const fileSize = (file.size / 1024 / 1024).toFixed(2);

      fileItem.innerHTML = `
        <div style="width:32px;height:32px;border-radius:6px;background:var(--a1-dim2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          ${fileIcon}
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:11px;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${file.name}</div>
          <div style="font-size:10px;color:var(--text3);">${fileSize} MB</div>
        </div>
        <button onclick="removeFile(${index})" style="background:none;border:none;cursor:pointer;padding:4px;">
          <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:var(--text3);fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      `;
      fileItems.appendChild(fileItem);
    });
  }
}

function getFileIcon(filename) {
  const ext = filename.split('.').pop().toLowerCase();
  if (['mp3', 'wav', 'm4a'].includes(ext)) {
    return '<svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--a1);fill:none;stroke-width:2;"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/></svg>';
  } else if (['mp4', 'avi', 'mov'].includes(ext)) {
    return '<svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--a1);fill:none;stroke-width:2;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>';
  } else {
    return '<svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--a1);fill:none;stroke-width:2;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';
  }
}

function removeFile(index) {
  selectedFiles.splice(index, 1);
  handleFileSelect({ target: { files: selectedFiles } });
  if (selectedFiles.length === 0) {
    closeUploadModal();
  }
}

async function startUpload() {
  if (!selectedFiles || selectedFiles.length === 0) {
    showToast('请先选择文件', 'error');
    return;
  }

  closeUploadModal();

  const progressModal = document.getElementById('upload-progress-modal');
  const progressBar = document.getElementById('upload-progress-bar');
  const progressPercentage = document.getElementById('upload-percentage');
  const uploadedCount = document.getElementById('uploaded-count');
  const totalCount = document.getElementById('total-count');

  progressModal.style.display = 'flex';
  totalCount.textContent = selectedFiles.length;
  uploadedCount.textContent = '0';
  progressBar.style.width = '0%';
  progressPercentage.textContent = '0%';

  try {
    // 调用真实的上传API
    const result = await uploadFiles(selectedFiles, getCurrentProjectId(), (current, total) => {
      // 更新进度
      const percent = Math.round((current / total) * 100);
      progressBar.style.width = percent + '%';
      progressPercentage.textContent = percent + '%';
      uploadedCount.textContent = current;
    });

    // 统计处理结果
    let totalKeywords = 0;
    let totalInsights = 0;
    result.results.forEach(r => {
      if (r.keywords) totalKeywords += r.keywords.length;
      if (r.insights) totalInsights += r.insights.length;
    });

    // 上传完成
    setTimeout(() => {
      progressModal.style.display = 'none';

      if (result.success > 0) {
        showToast(`✅ 成功上传 ${result.success} 个文件，提取 ${totalKeywords} 个关键词`, 'success');

        // 刷新文件列表
        loadImportPage();

        // 显示详细结果
        showUploadResultModal(result);
      }

      if (result.failed > 0) {
        showToast(`${result.failed} 个文件上传失败`, 'error');
      }

      selectedFiles = [];
    }, 500);

  } catch (error) {
    console.error('❌ 上传失败:', error);
    progressModal.style.display = 'none';
    showToast(`上传失败: ${error.message}`, 'error');
    selectedFiles = [];
  }
}

// 点击背景关闭弹窗
['download-modal', 'upload-modal'].forEach(id => {
  document.getElementById(id)?.addEventListener('click', function(e) {
    if (e.target === this) {
      this.style.display = 'none';
    }
  });
});
</script>
