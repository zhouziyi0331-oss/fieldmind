<div class="page-section" id="page-photos">
  <div class="page-section-inner">
    <div class="section-hd" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="section-dot"></span>
        <span class="section-title">多媒体相册</span>
        <span style="font-size:11px;color:var(--text4);background:var(--bg2);padding:2px 8px;border-radius:10px;">共 47 张</span>
      </div>
      <div style="display:flex;gap:8px;align-items:center;">
        <!-- 视图切换 -->
        <div style="display:flex;border:1px solid var(--border);border-radius:8px;overflow:hidden;">
          <button id="view-grid-btn" onclick="setPhotoView('grid')" style="padding:5px 10px;background:var(--a1);border:none;cursor:pointer;color:white;" title="网格视图">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </button>
          <button id="view-list-btn" onclick="setPhotoView('list')" style="padding:5px 10px;background:var(--bg1);border:none;cursor:pointer;color:var(--text4);" title="列表视图">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>
        <!-- 筛选 -->
        <select onchange="filterPhotosByGroup(this.value)" style="padding:5px 10px;border:1px solid var(--border);border-radius:8px;font-size:12px;background:var(--bg1);color:var(--text2);outline:none;">
          <option value="all">全部</option>
          <option value="date">按日期</option>
          <option value="location">按地点</option>
          <option value="tagged">已标注</option>
        </select>
        <button class="btn btn-primary" onclick="document.getElementById('photo-input-hidden').click()" style="gap:6px;font-size:12px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          上传照片
        </button>
        <input type="file" id="photo-input-hidden" multiple accept="image/*,video/*" style="display:none" onchange="showToast('已选择 '+this.files.length+' 个文件，开始上传…','success')">
      </div>
    </div>

    <!-- 日期分组：2024-07 -->
