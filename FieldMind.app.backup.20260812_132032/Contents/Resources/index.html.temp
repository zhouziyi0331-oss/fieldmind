<script>
function openTimelineDetail(type, title, date, subtitle) {
  document.getElementById('timeline-detail-modal').style.display = 'flex';
  document.getElementById('tl-modal-title').textContent = title;
  document.getElementById('tl-modal-subtitle').textContent = date + ' · ' + subtitle;
}

function closeTimelineModal() {
  document.getElementById('timeline-detail-modal').style.display = 'none';
}

function exportTimeline() {
  openDlModal('编年史事件记录');
}

function playAudio() {
  alert('播放音频功能（需要集成音频播放器）');
}

// 点击背景关闭弹窗
document.getElementById('timeline-detail-modal')?.addEventListener('click', function(e) {
  if (e.target === this) {
    closeTimelineModal();
  }
});
</script>
