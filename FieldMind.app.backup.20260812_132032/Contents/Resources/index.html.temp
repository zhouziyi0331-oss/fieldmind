    <!-- page-workflow: 工作流复用 -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="page-section" id="page-workflow">
      <div class="section-hd" style="margin-bottom:12px;">
        <div>
          <div class="section-title"><span class="section-dot"></span>工作流复用</div>
          <div class="section-sub">从对话生成 SOP · 可复用流程库 · Skill 进化</div>
        </div>
        <div style="display:flex;gap:8px;">
          <button class="btn btn-ghost" onclick="showToast('导入工作流文件','info')">
            <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            导入
          </button>
          <button class="btn btn-primary" onclick="showToast('新建空白工作流','success')">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            新建工作流
          </button>
        </div>
      </div>

      <div class="workflow-layout">
        <!-- 左侧：工作流列表 -->
        <div class="workflow-left">

          <!-- 从对话生成 Skill 入口 -->
          <div class="chat-to-skill">
            <div class="chat-to-skill-hd">
              <div class="chat-to-skill-icon">
                <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </div>
              <div>
                <div class="chat-to-skill-title">从对话生成 Skill</div>
                <div class="chat-to-skill-sub">AI 检测到可复用流程 · 上次对话：贵州布依族山歌传承分析</div>
              </div>
              <span class="tag tag-green" style="margin-left:auto;">新检测到</span>
            </div>
            <div class="chat-to-skill-preview">
              <div class="chat-to-skill-preview-label">检测到的流程步骤（5步）</div>
              <div class="chat-to-skill-steps">
                <div class="chat-to-skill-step"><div class="chat-to-skill-step-num">1</div>导入田野音频材料，进行转录</div>
                <div class="chat-to-skill-step"><div class="chat-to-skill-step-num">2</div>提取关键词，按费孝通框架分类</div>
                <div class="chat-to-skill-step"><div class="chat-to-skill-step-num">3</div>识别差序格局中的核心人物关系</div>
                <div class="chat-to-skill-step"><div class="chat-to-skill-step-num">4</div>生成二度分析报告（框架层）</div>
                <div class="chat-to-skill-step"><div class="chat-to-skill-step-num">5</div>输出商业可行性推演（三度）</div>
              </div>
            </div>
            <div class="chat-to-skill-actions">
              <button class="btn btn-primary" onclick="showToast('工作流已保存为 Skill：布依族调研SOP','success')">
                <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                保存为 Skill
              </button>
              <button class="btn btn-outline" onclick="showToast('已跳转到 AI 对话页','info')">查看原对话</button>
              <button class="btn btn-ghost" onclick="this.closest('.chat-to-skill').style.display='none';showToast('已忽略','info')">忽略</button>
            </div>
          </div>

          <!-- 筛选栏 -->
          <div class="workflow-filter">
            <button class="workflow-filter-btn active" onclick="filterWorkflow('all',this)">全部</button>
            <button class="workflow-filter-btn" onclick="filterWorkflow('field',this)">田野调研</button>
            <button class="workflow-filter-btn" onclick="filterWorkflow('analysis',this)">分析框架</button>
            <button class="workflow-filter-btn" onclick="filterWorkflow('report',this)">报告生成</button>
            <button class="workflow-filter-btn" onclick="filterWorkflow('opc',this)">OPC孵化</button>
          </div>

          <!-- 工作流卡片列表 -->
          <div class="workflow-card open" data-type="field">
            <div class="workflow-card-hd" onclick="this.closest('.workflow-card').classList.toggle('open')">
              <div class="workflow-card-icon blue">
                <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <div class="workflow-card-meta">
                <div class="workflow-card-name">布依族文化调研 SOP</div>
                <div class="workflow-card-desc">从材料导入到三度报告的完整调研流程 · 5步 · 已用3次</div>
              </div>
              <div class="workflow-card-badges">
                <span class="tag tag-blue">田野调研</span>
                <span class="tag tag-green">已验证</span>
              </div>
            </div>
            <div class="workflow-card-body">
              <div class="workflow-steps">
                <div class="workflow-step">
                  <div class="workflow-step-num">1</div>
                  <div class="workflow-step-body">
                    <div class="workflow-step-title">材料导入与预处理</div>
                    <div class="workflow-step-desc">导入音频/视频/文字材料，AI自动转录，生成初始标签</div>
                    <span class="workflow-step-tool">材料导入模块</span>
                  </div>
                </div>
                <div class="workflow-step">
                  <div class="workflow-step-num">2</div>
                  <div class="workflow-step-body">
                    <div class="workflow-step-title">关键词提取与分类</div>
                    <div class="workflow-step-desc">按费孝通差序格局框架提取关键词，识别核心人物、地点、事件</div>
                    <span class="workflow-step-tool">关键词引擎</span>
                  </div>
                </div>
                <div class="workflow-step">
                  <div class="workflow-step-num">3</div>
                  <div class="workflow-step-body">
                    <div class="workflow-step-title">知识脉络梳理</div>
                    <div class="workflow-step-desc">构建6个主题脉络，识别知识节点间的关联关系</div>
                    <span class="workflow-step-tool">知识脉络页</span>
                  </div>
                </div>
                <div class="workflow-step">
                  <div class="workflow-step-num">4</div>
                  <div class="workflow-step-body">
                    <div class="workflow-step-title">三层报告生成</div>
                    <div class="workflow-step-desc">依次生成一度（信息梳理）→ 二度（框架分析）→ 三度（商业推演）</div>
                    <span class="workflow-step-tool">三层报告页</span>
                  </div>
                </div>
                <div class="workflow-step">
                  <div class="workflow-step-num">5</div>
                  <div class="workflow-step-body">
                    <div class="workflow-step-title">AI对话深化</div>
                    <div class="workflow-step-desc">基于报告与AI对话，提炼可操作建议，更新用户记忆</div>
                    <span class="workflow-step-tool">AI对话页</span>
                  </div>
                </div>
              </div>
              <div style="display:flex;gap:8px;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);">
                <button class="btn btn-primary" onclick="showToast('开始执行工作流：布依族文化调研SOP','success')">
                  <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
