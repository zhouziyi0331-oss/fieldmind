      <div class="card project-card" data-project-name="OPC孵化器评估" style="cursor:pointer;transition:box-shadow .2s,transform .2s;" onmouseenter="this.style.boxShadow='0 4px 20px rgba(23,138,183,.18)';this.style.transform='translateY(-2px)'" onmouseleave="this.style.boxShadow='';this.style.transform=''">
        <div style="padding:16px 16px 12px;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;">
