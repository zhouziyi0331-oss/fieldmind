                  <span style="font-size:9px;color:var(--text3);">来源：AI推断</span>
                  <span style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:20px;background:var(--text3);color:white;">待验证</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 记忆卡片 4 -->
