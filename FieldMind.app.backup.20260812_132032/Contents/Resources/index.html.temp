                  <div style="display:flex;gap:6px;align-items:center;font-size:9px;color:var(--text3);">
                    <svg viewBox="0 0 24 24" style="width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    预计完成：2024-03-25
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SOP步骤 4 -->
          <div class="card">
            <div class="card-body" style="padding:14px 16px;">
