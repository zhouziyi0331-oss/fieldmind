<!-- ══════════════════════════════════════
     PAGE: 表格智能查询 (M9)
══════════════════════════════════════ -->
<div class="page-section" id="page-tables">
  <div class="page-section-inner">
    <div class="section-hd" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="section-dot"></span>
        <span class="section-title">表格智能查询</span>
      </div>
      <button class="btn btn-outline" onclick="showToast('导出查询结果为 CSV','success')" style="font-size:12px;gap:6px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        导出结果
      </button>
    </div>

    <div style="display:grid;grid-template-columns:1fr 280px;gap:16px;align-items:start;">
      <!-- 主区域 -->
      <div style="display:flex;flex-direction:column;gap:14px;">
        <!-- 表格选择 + 查询输入 -->
        <div class="card">
          <div class="card-body" style="padding:14px 16px;display:flex;flex-direction:column;gap:12px;">
            <!-- 表格选择 -->
            <div>
              <label style="font-size:11px;font-weight:600;color:var(--text3);display:block;margin-bottom:6px;">选择数据表格</label>
              <select id="table-select" onchange="loadTablePreview(this.value)" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:8px;font-size:12px;background:var(--bg1);color:var(--text1);outline:none;">
                <option value="">— 请选择表格 —</option>
                <option value="survey">survey_results.xlsx（问卷调查数据）</option>
                <option value="interview">interview_records.csv（访谈记录）</option>
                <option value="entity">entity_list.xlsx（实体清单）</option>
              </select>
            </div>
            <!-- 自然语言查询 -->
            <div>
              <label style="font-size:11px;font-weight:600;color:var(--text3);display:block;margin-bottom:6px;">自然语言查询</label>
              <div style="display:flex;gap:8px;">
                <input type="text" id="nl-query-input" placeholder="例如：有多少受访者来自贵州省？" value="有多少受访者来自贵州省？"
                  style="flex:1;padding:8px 12px;border:1px solid var(--border);border-radius:8px;font-size:12px;background:var(--bg1);color:var(--text1);outline:none;"
                  onkeydown="if(event.key==='Enter')runNLQuery()">
                <button class="btn btn-primary" onclick="runNLQuery()" style="font-size:12px;gap:6px;white-space:nowrap;">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  查询
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- 查询结果 -->
        <div class="card" id="query-result-card">
          <div class="card-hd">
            <div class="card-title">
              <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              查询结果
            </div>
            <span style="font-size:11px;color:var(--a2);font-weight:600;">找到 7 条记录</span>
          </div>
          <div class="card-body" style="padding:10px 14px;">
            <!-- AI解读 -->
            <div style="background:rgba(23,138,183,.06);border:1px solid rgba(23,138,183,.15);border-radius:8px;padding:10px 12px;margin-bottom:12px;">
              <div style="font-size:11px;font-weight:600;color:var(--a1);margin-bottom:4px;">🤖 AI 解读</div>
              <div style="font-size:12px;color:var(--text2);line-height:1.6;">在 <strong>survey_results.xlsx</strong> 的 156 条记录中，共有 <strong>7 位受访者</strong>来自贵州省，占总样本的 <strong>4.5%</strong>。其中黔南州 3 人，贵阳市 2 人，遵义市 2 人。</div>
            </div>
            <!-- 数据表格 -->
            <div style="overflow-x:auto;">
              <table style="width:100%;border-collapse:collapse;font-size:11px;">
                <thead>
                  <tr style="background:var(--bg2);">
                    <th style="padding:7px 10px;text-align:left;font-weight:600;color:var(--text3);border-bottom:1px solid var(--border);">#</th>
                    <th style="padding:7px 10px;text-align:left;font-weight:600;color:var(--text3);border-bottom:1px solid var(--border);">姓名</th>
                    <th style="padding:7px 10px;text-align:left;font-weight:600;color:var(--text3);border-bottom:1px solid var(--border);">省份</th>
                    <th style="padding:7px 10px;text-align:left;font-weight:600;color:var(--text3);border-bottom:1px solid var(--border);">城市</th>
                    <th style="padding:7px 10px;text-align:left;font-weight:600;color:var(--text3);border-bottom:1px solid var(--border);">年龄</th>
                    <th style="padding:7px 10px;text-align:left;font-weight:600;color:var(--text3);border-bottom:1px solid var(--border);">职业</th>
                  </tr>
                </thead>
                <tbody>
                  <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:7px 10px;color:var(--text4);">1</td>
                    <td style="padding:7px 10px;color:var(--text1);font-weight:500;">张明</td>
                    <td style="padding:7px 10px;"><span style="background:rgba(23,138,183,.1);color:var(--a1);padding:2px 6px;border-radius:4px;font-size:10px;">贵州省</span></td>
                    <td style="padding:7px 10px;color:var(--text2);">黔南州</td>
                    <td style="padding:7px 10px;color:var(--text2);">42</td>
                    <td style="padding:7px 10px;color:var(--text2);">农民</td>
                  </tr>
                  <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:7px 10px;color:var(--text4);">2</td>
                    <td style="padding:7px 10px;color:var(--text1);font-weight:500;">李华</td>
                    <td style="padding:7px 10px;"><span style="background:rgba(23,138,183,.1);color:var(--a1);padding:2px 6px;border-radius:4px;font-size:10px;">贵州省</span></td>
                    <td style="padding:7px 10px;color:var(--text2);">贵阳市</td>
                    <td style="padding:7px 10px;color:var(--text2);">35</td>
                    <td style="padding:7px 10px;color:var(--text2);">教师</td>
                  </tr>
                  <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:7px 10px;color:var(--text4);">3</td>
                    <td style="padding:7px 10px;color:var(--text1);font-weight:500;">王芳</td>
                    <td style="padding:7px 10px;"><span style="background:rgba(23,138,183,.1);color:var(--a1);padding:2px 6px;border-radius:4px;font-size:10px;">贵州省</span></td>
                    <td style="padding:7px 10px;color:var(--text2);">遵义市</td>
                    <td style="padding:7px 10px;color:var(--text2);">28</td>
                    <td style="padding:7px 10px;color:var(--text2);">手工艺人</td>
                  </tr>
                  <tr>
                    <td style="padding:7px 10px;color:var(--text4);">…</td>
                    <td colspan="5" style="padding:7px 10px;color:var(--text4);font-size:10px;">还有 4 条记录</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- 右侧：常用查询 + 历史 -->
      <div style="display:flex;flex-direction:column;gap:12px;position:sticky;top:16px;">
        <!-- 常用查询 -->
        <div class="card">
          <div class="card-hd">
            <div class="card-title">
              <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              常用查询
            </div>
          </div>
          <div class="card-body" style="padding:8px 10px;display:flex;flex-direction:column;gap:5px;">
            <button class="btn btn-ghost" style="width:100%;justify-content:flex-start;font-size:11px;text-align:left;" onclick="setQuery('总共有多少受访者？')">总共有多少受访者？</button>
            <button class="btn btn-ghost" style="width:100%;justify-content:flex-start;font-size:11px;text-align:left;" onclick="setQuery('受访者的平均年龄是多少？')">受访者的平均年龄是多少？</button>
            <button class="btn btn-ghost" style="width:100%;justify-content:flex-start;font-size:11px;text-align:left;" onclick="setQuery('男女比例是多少？')">男女比例是多少？</button>
            <button class="btn btn-ghost" style="width:100%;justify-content:flex-start;font-size:11px;text-align:left;" onclick="setQuery('来自哪些省份？')">来自哪些省份？</button>
            <button class="btn btn-ghost" style="width:100%;justify-content:flex-start;font-size:11px;text-align:left;" onclick="setQuery('职业分布情况如何？')">职业分布情况如何？</button>
          </div>
        </div>

        <!-- 查询历史 -->
        <div class="card">
          <div class="card-hd">
            <div class="card-title">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              查询历史
            </div>
            <button onclick="showToast('已清空查询历史','info')" style="background:none;border:none;cursor:pointer;font-size:10px;color:var(--text4);">清空</button>
          </div>
          <div class="card-body" style="padding:6px 10px;display:flex;flex-direction:column;gap:4px;">
            <div style="padding:5px 6px;border-radius:6px;cursor:pointer;font-size:11px;color:var(--text2);" onmouseenter="this.style.background='var(--bg2)'" onmouseleave="this.style.background=''">有多少受访者来自贵州省？</div>
            <div style="padding:5px 6px;border-radius:6px;cursor:pointer;font-size:11px;color:var(--text2);" onmouseenter="this.style.background='var(--bg2)'" onmouseleave="this.style.background=''">总共有多少受访者？</div>
            <div style="padding:5px 6px;border-radius:6px;cursor:pointer;font-size:11px;color:var(--text4);" onmouseenter="this.style.background='var(--bg2)'" onmouseleave="this.style.background=''">男女比例是多少？</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════
     PAGE: SOP 流程管理
══════════════════════════════════════ -->
<div class="page-section" id="page-sop">
  <div class="page-section-inner">
    <div class="section-hd" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="section-dot"></span>
        <span class="section-title">SOP 流程管理</span>
        <span style="font-size:11px;color:var(--text4);background:var(--bg2);padding:2px 8px;border-radius:10px;">4 个模板</span>
      </div>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-outline" onclick="showToast('导入 SOP 模板','info')" style="font-size:12px;gap:6px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          导入模板
        </button>
        <button class="btn btn-primary" onclick="openNewSOPModal()" style="font-size:12px;gap:6px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          新建 SOP
        </button>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 320px;gap:16px;align-items:start;">
      <!-- SOP 模板列表 -->
      <div style="display:flex;flex-direction:column;gap:10px;">

        <!-- SOP 卡片 1：田野调查 -->
        <div class="card" style="overflow:hidden;">
          <div style="padding:14px 16px;display:flex;align-items:flex-start;gap:12px;cursor:pointer;" onclick="toggleSOPDetail('sop-1')">
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#178AB7,#6FA7B6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;">
                <div style="font-size:13px;font-weight:600;color:var(--text1);">田野调查标准流程</div>
                <span style="font-size:10px;padding:2px 6px;background:rgba(159,172,36,.15);color:var(--a2);border-radius:4px;">进行中</span>
              </div>
              <div style="font-size:11px;color:var(--text4);margin-bottom:6px;">8 个步骤 · 已完成 5/8 · 更新于 07-20</div>
              <!-- 进度条 -->
              <div style="height:4px;background:var(--bg2);border-radius:2px;overflow:hidden;">
                <div style="width:62.5%;height:100%;background:linear-gradient(90deg,var(--a1),var(--a4));border-radius:2px;"></div>
              </div>
            </div>
            <div style="display:flex;gap:6px;flex-shrink:0;">
              <button class="btn btn-primary" style="font-size:11px;padding:5px 10px;" onclick="event.stopPropagation();showToast('继续执行 SOP','success')">继续执行</button>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text4)" stroke-width="2" id="sop-1-arrow" style="margin-top:10px;transition:transform .2s;"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
          <!-- 步骤详情（可折叠） -->
          <div id="sop-1" style="display:none;border-top:1px solid var(--border);padding:12px 16px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span style="font-size:11px;color:var(--text3);text-decoration:line-through;">1. 确定调研目标与范围</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span style="font-size:11px;color:var(--text3);text-decoration:line-through;">2. 设计访谈提纲</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span style="font-size:11px;color:var(--text3);text-decoration:line-through;">3. 联系受访者</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span style="font-size:11px;color:var(--text3);text-decoration:line-through;">4. 开展田野访谈</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <span style="font-size:11px;color:var(--text3);text-decoration:line-through;">5. 上传录音与文件</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--a1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <span style="font-size:9px;color:white;font-weight:700;">6</span>
                </div>
                <span style="font-size:11px;color:var(--text1);font-weight:500;">6. 整理访谈记录</span>
                <span style="font-size:10px;padding:1px 5px;background:rgba(23,138,183,.1);color:var(--a1);border-radius:3px;">进行中</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <span style="font-size:9px;color:var(--text4);">7</span>
                </div>
                <span style="font-size:11px;color:var(--text4);">7. 数据分析与编码</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <span style="font-size:9px;color:var(--text4);">8</span>
                </div>
                <span style="font-size:11px;color:var(--text4);">8. 撰写调研报告</span>
              </div>
            </div>
          </div>
        </div>

        <!-- SOP 卡片 2：OPC评估 -->
        <div class="card" style="overflow:hidden;">
          <div style="padding:14px 16px;display:flex;align-items:flex-start;gap:12px;cursor:pointer;" onclick="toggleSOPDetail('sop-2')">
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#9FAC24,#45481D);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;">
                <div style="font-size:13px;font-weight:600;color:var(--text1);">OPC 孵化器评估 SOP</div>
                <span style="font-size:10px;padding:2px 6px;background:rgba(23,138,183,.1);color:var(--a1);border-radius:4px;">未开始</span>
              </div>
              <div style="font-size:11px;color:var(--text4);margin-bottom:6px;">6 个步骤 · 已完成 0/6 · 创建于 07-10</div>
              <div style="height:4px;background:var(--bg2);border-radius:2px;overflow:hidden;">
                <div style="width:0%;height:100%;background:linear-gradient(90deg,var(--a1),var(--a4));border-radius:2px;"></div>
              </div>
            </div>
            <div style="display:flex;gap:6px;flex-shrink:0;">
              <button class="btn btn-outline" style="font-size:11px;padding:5px 10px;" onclick="event.stopPropagation();showToast('开始执行 OPC 评估 SOP','success')">开始执行</button>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text4)" stroke-width="2" id="sop-2-arrow" style="margin-top:10px;transition:transform .2s;"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
          <div id="sop-2" style="display:none;border-top:1px solid var(--border);padding:12px 16px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:var(--text4);">1</span></div><span style="font-size:11px;color:var(--text4);">1. 收集 OPC 基础信息</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:var(--text4);">2</span></div><span style="font-size:11px;color:var(--text4);">2. 实地走访与观察</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:var(--text4);">3</span></div><span style="font-size:11px;color:var(--text4);">3. 访谈核心团队成员</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:var(--text4);">4</span></div><span style="font-size:11px;color:var(--text4);">4. 分析运营数据</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:var(--text4);">5</span></div><span style="font-size:11px;color:var(--text4);">5. 撰写评估报告</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--bg2);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:var(--text4);">6</span></div><span style="font-size:11px;color:var(--text4);">6. 反馈与跟进</span></div>
            </div>
          </div>
        </div>

        <!-- SOP 卡片 3：报告撰写 -->
        <div class="card" style="overflow:hidden;">
          <div style="padding:14px 16px;display:flex;align-items:flex-start;gap:12px;cursor:pointer;" onclick="toggleSOPDetail('sop-3')">
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#D9BC92,#9FAC24);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;">
                <div style="font-size:13px;font-weight:600;color:var(--text1);">调研报告撰写流程</div>
                <span style="font-size:10px;padding:2px 6px;background:rgba(159,172,36,.15);color:var(--a2);border-radius:4px;">已完成</span>
              </div>
              <div style="font-size:11px;color:var(--text4);margin-bottom:6px;">5 个步骤 · 已完成 5/5 · 完成于 06-30</div>
              <div style="height:4px;background:var(--bg2);border-radius:2px;overflow:hidden;">
                <div style="width:100%;height:100%;background:linear-gradient(90deg,var(--a2),var(--a1));border-radius:2px;"></div>
              </div>
            </div>
            <div style="display:flex;gap:6px;flex-shrink:0;">
              <button class="btn btn-ghost" style="font-size:11px;padding:5px 10px;" onclick="event.stopPropagation();showToast('已复制此 SOP 模板','success')">复制模板</button>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text4)" stroke-width="2" id="sop-3-arrow" style="margin-top:10px;transition:transform .2s;"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
          <div id="sop-3" style="display:none;border-top:1px solid var(--border);padding:12px 16px;">
            <div style="display:flex;flex-direction:column;gap:6px;">
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div><span style="font-size:11px;color:var(--text3);text-decoration:line-through;">1. 整理田野笔记</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div><span style="font-size:11px;color:var(--text3);text-decoration:line-through;">2. 构建分析框架</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div><span style="font-size:11px;color:var(--text3);text-decoration:line-through;">3. 撰写初稿</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div><span style="font-size:11px;color:var(--text3);text-decoration:line-through;">4. 内部审阅修改</span></div>
              <div style="display:flex;align-items:center;gap:8px;"><div style="width:20px;height:20px;border-radius:50%;background:var(--a2);display:flex;align-items:center;justify-content:center;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div><span style="font-size:11px;color:var(--text3);text-decoration:line-through;">5. 定稿发布</span></div>
            </div>
          </div>
        </div>

      </div>

      <!-- 右侧：统计 + 快速操作 -->
      <div style="display:flex;flex-direction:column;gap:12px;position:sticky;top:16px;">
        <!-- SOP 统计 -->
        <div class="card">
          <div class="card-hd">
            <div class="card-title">
              <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              执行统计
            </div>
          </div>
          <div class="card-body" style="padding:10px 12px;display:flex;flex-direction:column;gap:8px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:11px;color:var(--text3);">进行中</span>
              <span style="font-size:14px;font-weight:700;color:var(--a1);">1</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:11px;color:var(--text3);">未开始</span>
              <span style="font-size:14px;font-weight:700;color:var(--text4);">2</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:11px;color:var(--text3);">已完成</span>
              <span style="font-size:14px;font-weight:700;color:var(--a2);">1</span>
            </div>
            <div style="height:1px;background:var(--border);margin:2px 0;"></div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:11px;color:var(--text3);">总步骤数</span>
              <span style="font-size:14px;font-weight:700;color:var(--text1);">25</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:11px;color:var(--text3);">已完成步骤</span>
              <span style="font-size:14px;font-weight:700;color:var(--a2);">10</span>
            </div>
          </div>
        </div>

        <!-- 快速操作 -->
        <div class="card">
          <div class="card-hd">
            <div class="card-title">
              <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              快速操作
            </div>
          </div>
          <div class="card-body" style="padding:8px 10px;display:flex;flex-direction:column;gap:5px;">
            <button class="btn btn-outline" style="width:100%;justify-content:flex-start;font-size:11px;" onclick="openNewSOPModal()">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              新建 SOP 模板
            </button>
            <button class="btn btn-ghost" style="width:100%;justify-content:flex-start;font-size:11px;" onclick="showToast('导出全部 SOP 为 JSON','success')">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              导出全部 SOP
            </button>
            <button class="btn btn-ghost" style="width:100%;justify-content:flex-start;font-size:11px;" onclick="showPage('workflow',document.querySelector('.sb-item[onclick*=\'workflow\']'))">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              查看工作流配置
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

        <!-- 占位符已移除，真实页面在上方 -->
      </div>
    </div>
  </div>
</div>

