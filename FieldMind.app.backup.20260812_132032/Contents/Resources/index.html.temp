            <!-- 关系网络图（SVG） -->
            <svg width="100%" height="100%" style="position:absolute;top:0;left:0;">
              <!-- 连接线 -->
              <line x1="50%" y1="50%" x2="30%" y2="25%" stroke="var(--border2)" stroke-width="2" opacity="0.6"/>
              <line x1="50%" y1="50%" x2="70%" y2="25%" stroke="var(--border2)" stroke-width="2" opacity="0.6"/>
              <line x1="50%" y1="50%" x2="25%" y2="55%" stroke="var(--border2)" stroke-width="2" opacity="0.6"/>
              <line x1="50%" y1="50%" x2="75%" y2="55%" stroke="var(--border2)" stroke-width="2" opacity="0.6"/>
              <line x1="50%" y1="50%" x2="30%" y2="75%" stroke="var(--border2)" stroke-width="2" opacity="0.6"/>
              <line x1="50%" y1="50%" x2="70%" y2="75%" stroke="var(--border2)" stroke-width="2" opacity="0.6"/>
              <line x1="30%" y1="25%" x2="70%" y2="25%" stroke="var(--border2)" stroke-width="1" opacity="0.3"/>
