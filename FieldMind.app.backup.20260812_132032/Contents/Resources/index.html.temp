<!-- ══════════════════════════════════════
     PAGE: 文献引用管理 (M10)
══════════════════════════════════════ -->
<div class="page-section" id="page-citations">
  <div class="page-section-inner">
    <div class="section-hd" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="section-dot"></span>
        <span class="section-title">文献引用管理</span>
        <span style="font-size:11px;color:var(--text4);background:var(--bg2);padding:2px 8px;border-radius:10px;">共 12 条</span>
      </div>
      <div style="display:flex;gap:8px;">
        <select id="citation-format" style="padding:5px 10px;border:1px solid var(--border);border-radius:8px;font-size:12px;background:var(--bg1);color:var(--text2);outline:none;">
          <option value="gb7714">GB/T 7714</option>
          <option value="apa">APA 7th</option>
          <option value="mla">MLA 9th</option>
        </select>
        <button class="btn btn-outline" onclick="generateRefList()" style="font-size:12px;gap:6px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          生成参考文献
        </button>
        <button class="btn btn-primary" onclick="openAddCitationModal()" style="font-size:12px;gap:6px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          添加文献
        </button>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 300px;gap:16px;align-items:start;">
      <!-- 文献列表 -->
      <div style="display:flex;flex-direction:column;gap:8px;">
        <!-- 搜索 + 筛选 -->
        <div style="display:flex;gap:8px;margin-bottom:4px;">
          <div style="position:relative;flex:1;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text4)" stroke-width="2" style="position:absolute;left:9px;top:50%;transform:translateY(-50%);pointer-events:none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" placeholder="搜索文献标题、作者…" style="width:100%;padding:7px 12px 7px 28px;border:1px solid var(--border);border-radius:8px;font-size:12px;background:var(--bg1);color:var(--text1);outline:none;box-sizing:border-box;">
          </div>
