            </div>
            <div class="card-body" style="padding:8px 12px;display:flex;flex-direction:column;gap:6px;">
              <button class="btn btn-outline" style="width:100%;justify-content:flex-start;" onclick="showPage('chat',document.querySelector('.sb-item[onclick*=\'chat\']'))">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
