<div class="page-section" id="page-projects">
  <div class="page-section-inner">
    <!-- 页头 -->
    <div class="section-hd" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="section-dot"></span>
        <span class="section-title">项目管理</span>
        <span style="font-size:11px;color:var(--text4);background:var(--bg2);padding:2px 8px;border-radius:10px;" id="projects-count">共 3 个项目</span>
      </div>
      <button class="btn btn-primary" onclick="openNewProjectModal()" style="gap:6px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        新建项目
      </button>
    </div>

    <!-- 搜索栏 -->
    <div style="margin-bottom:16px;">
      <div style="position:relative;max-width:320px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text4)" stroke-width="2" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);pointer-events:none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" placeholder="搜索项目名称…" oninput="filterProjects(this.value)"
          style="width:100%;padding:7px 12px 7px 32px;border:1px solid var(--border);border-radius:8px;font-size:12px;background:var(--bg1);color:var(--text1);outline:none;box-sizing:border-box;">
      </div>
    </div>

    <!-- 项目卡片网格 -->
    <div id="projects-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;">

      <!-- 项目卡片示例 -->
      <div class="card project-card" data-project-name="布依族文化调研" style="cursor:pointer;transition:box-shadow .2s,transform .2s;" onmouseenter="this.style.boxShadow='0 4px 20px rgba(23,138,183,.18)';this.style.transform='translateY(-2px)'" onmouseleave="this.style.boxShadow='';this.style.transform=''">
        <div style="padding:16px 16px 12px;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;">
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#178AB7,#6FA7B6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
            </div>
            <div style="position:relative;">
              <button onclick="event.stopPropagation();toggleProjectMenu(this)" style="background:none;border:none;cursor:pointer;color:var(--text4);padding:4px;border-radius:6px;" title="更多操作">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
              </button>
              <div class="project-menu" style="display:none;position:absolute;right:0;top:28px;background:var(--bg1);border:1px solid var(--border);border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,.12);z-index:100;min-width:120px;overflow:hidden;">
                <button onclick="event.stopPropagation();showToast('项目设置功能开发中','info')" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 12px;background:none;border:none;cursor:pointer;font-size:12px;color:var(--text2);">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
                  项目设置
                </button>
                <button onclick="event.stopPropagation();showToast('导出功能开发中','info')" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 12px;background:none;border:none;cursor:pointer;font-size:12px;color:var(--text2);">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  导出数据
                </button>
                <button onclick="event.stopPropagation();openConfirmModal('deleteProject')" style="display:flex;align-items:center;gap:8px;width:100%;padding:8px 12px;background:none;border:none;cursor:pointer;font-size:12px;color:#e05252;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                  删除项目
                </button>
              </div>
            </div>
          </div>
          <div style="font-size:14px;font-weight:600;color:var(--text1);margin-bottom:4px;">布依族文化调研</div>
          <div style="font-size:11px;color:var(--text4);margin-bottom:12px;">创建于 2024-01-15</div>
          <div style="display:flex;gap:12px;margin-bottom:14px;">
            <div style="text-align:center;">
              <div style="font-size:18px;font-weight:700;color:var(--a1);">10</div>
              <div style="font-size:10px;color:var(--text4);">文件</div>
            </div>
            <div style="text-align:center;">
              <div style="font-size:18px;font-weight:700;color:var(--a2);">8</div>
              <div style="font-size:10px;color:var(--text4);">文档</div>
            </div>
            <div style="text-align:center;">
              <div style="font-size:18px;font-weight:700;color:var(--a3);">120</div>
              <div style="font-size:10px;color:var(--text4);">实体</div>
            </div>
          </div>
          <div style="display:flex;gap:6px;">
            <button class="btn btn-primary" style="flex:1;font-size:11px;padding:6px 0;" onclick="event.stopPropagation();showToast('进入项目：布依族文化调研','success')">
              进入项目
            </button>
            <button class="btn btn-outline" style="font-size:11px;padding:6px 10px;" onclick="event.stopPropagation();showPage('upload',document.querySelector('.sb-item[onclick*=\'upload\']'))">
              上传文件
            </button>
          </div>
        </div>
      </div>

      <div class="card project-card" data-project-name="苗族手工艺记录" style="cursor:pointer;transition:box-shadow .2s,transform .2s;" onmouseenter="this.style.boxShadow='0 4px 20px rgba(23,138,183,.18)';this.style.transform='translateY(-2px)'" onmouseleave="this.style.boxShadow='';this.style.transform=''">
        <div style="padding:16px 16px 12px;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;">
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#9FAC24,#45481D);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
            </div>
            <button onclick="event.stopPropagation();toggleProjectMenu(this)" style="background:none;border:none;cursor:pointer;color:var(--text4);padding:4px;border-radius:6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </button>
          </div>
          <div style="font-size:14px;font-weight:600;color:var(--text1);margin-bottom:4px;">苗族手工艺记录</div>
          <div style="font-size:11px;color:var(--text4);margin-bottom:12px;">创建于 2024-03-08</div>
