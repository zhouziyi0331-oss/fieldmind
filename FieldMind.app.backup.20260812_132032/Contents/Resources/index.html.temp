                <div style="display:flex;gap:8px;align-items:flex-start;">
                  <div style="width:6px;height:6px;border-radius:50%;background:var(--a1);margin-top:5px;flex-shrink:0;"></div>
                  <div>
                    <div style="font-size:11px;font-weight:600;color:var(--text2);">费孝通框架 v2.0</div>
                    <div style="font-size:9px;color:var(--text4);">合并项飙理论，优化分析路径 · 07-20</div>
                  </div>
                </div>
                <div style="display:flex;gap:8px;align-items:flex-start;">
                  <div style="width:6px;height:6px;border-radius:50%;background:var(--a5);margin-top:5px;flex-shrink:0;"></div>
                  <div>
                    <div style="font-size:11px;font-weight:600;color:var(--text2);">快速报告流程 v1.0</div>
                    <div style="font-size:9px;color:var(--text4);">从对话自动生成 · 07-15</div>
                  </div>
                </div>
                <div style="display:flex;gap:8px;align-items:flex-start;">
                  <div style="width:6px;height:6px;border-radius:50%;background:var(--a3);margin-top:5px;flex-shrink:0;"></div>
                  <div>
                    <div style="font-size:11px;font-weight:600;color:var(--text2);">OPC评估SOP v1.0</div>
                    <div style="font-size:9px;color:var(--text4);">手动创建 · 07-10</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 快速操作 -->
          <div class="card">
