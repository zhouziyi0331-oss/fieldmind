            </div>
          </div>

          <!-- 进化记录 -->
          <div class="card" style="margin-bottom:12px;">
            <div class="card-hd">
              <div class="card-title">
                <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Skill 进化记录
              </div>
            </div>
            <div class="card-body" style="padding:8px 12px;">
              <div style="display:flex;flex-direction:column;gap:8px;">
                <div style="display:flex;gap:8px;align-items:flex-start;">
                  <div style="width:6px;height:6px;border-radius:50%;background:var(--a2);margin-top:5px;flex-shrink:0;"></div>
                  <div>
                    <div style="font-size:11px;font-weight:600;color:var(--text2);">布依族调研SOP v1.2</div>
                    <div style="font-size:9px;color:var(--text4);">新增「现代性冲突分析」步骤 · 07-25</div>
