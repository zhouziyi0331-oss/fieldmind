            <div style="text-align:center;"><div style="font-size:18px;font-weight:700;color:var(--a1);">5</div><div style="font-size:10px;color:var(--text4);">文件</div></div>
            <div style="text-align:center;"><div style="font-size:18px;font-weight:700;color:var(--a2);">4</div><div style="font-size:10px;color:var(--text4);">文档</div></div>
            <div style="text-align:center;"><div style="font-size:18px;font-weight:700;color:var(--a3);">67</div><div style="font-size:10px;color:var(--text4);">实体</div></div>
          </div>
          <div style="display:flex;gap:6px;">
            <button class="btn btn-primary" style="flex:1;font-size:11px;padding:6px 0;" onclick="event.stopPropagation();showToast('进入项目：苗族手工艺记录','success')">进入项目</button>
            <button class="btn btn-outline" style="font-size:11px;padding:6px 10px;" onclick="event.stopPropagation();showPage('upload',document.querySelector('.sb-item[onclick*=\'upload\']'))">上传文件</button>
          </div>
        </div>
