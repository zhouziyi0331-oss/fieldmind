<!-- ══════════════════════════════════════
     PAGE: 文件上传 (M2)
══════════════════════════════════════ -->
<div class="page-section" id="page-upload">
  <div class="page-section-inner">
    <div class="section-hd" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="section-dot"></span>
        <span class="section-title">文件上传</span>
        <span style="font-size:11px;color:var(--text4);background:var(--bg2);padding:2px 8px;border-radius:10px;">当前项目：布依族文化调研</span>
      </div>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-ghost" onclick="showToast('已清空上传队列','info')" style="font-size:12px;">清空队列</button>
        <button class="btn btn-primary" onclick="document.getElementById('file-input-hidden').click()" style="gap:6px;font-size:12px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          选择文件
        </button>
        <input type="file" id="file-input-hidden" multiple accept=".pdf,.jpg,.jpeg,.png,.wav,.mp3,.xlsx,.csv,.docx,.txt" style="display:none" onchange="handleFileSelect(event)">
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start;">
      <!-- 左列：拖拽区 + 上传队列 -->
      <div style="display:flex;flex-direction:column;gap:14px;">
        <!-- 拖拽上传区 -->
        <div id="drop-zone"
          ondragover="event.preventDefault();this.classList.add('drag-over')"
          ondragleave="this.classList.remove('drag-over')"
          ondrop="event.preventDefault();this.classList.remove('drag-over');handleFileSelect(event)"
          onclick="document.getElementById('file-input-hidden').click()"
          style="border:2px dashed var(--border);border-radius:14px;padding:40px 24px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s;background:var(--bg1);">
          <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,rgba(23,138,183,.12),rgba(111,167,182,.12));display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--a1)" stroke-width="1.8"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </div>
          <div style="font-size:14px;font-weight:600;color:var(--text1);margin-bottom:6px;">拖拽文件到这里上传</div>
          <div style="font-size:12px;color:var(--text4);margin-bottom:14px;">或点击选择文件</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;">
