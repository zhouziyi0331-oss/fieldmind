    <script>
    // ── PAGE NAV ──
const PAGE_TITLES={overview:'概览',import:'材料导入',keyword:'关键词引擎',busi:'在地业态分析',dashboard:'可视化看板',model:'思维模型',skill:'Skill 生态',timeline:'编年史',report:'调研报告',vein:'知识脉络',chronicle:'编年史',report3:'三层报告',chat:'AI 对话',newproject:'新建项目',workflow:'工作流复用',settings:'设置',projects:'项目管理',upload:'文件上传',photos:'多媒体相册',citations:'文献引用',tables:'表格查询',sop:'SOP 流程'};
function showPage(id,el){
  document.querySelectorAll('.page-section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.sb-item').forEach(n=>n.classList.remove('active'));
  const target=document.getElementById('page-'+id);
  if(!target){console.warn('Page not found: page-'+id);return;}
  target.classList.add('active');
  if(el)el.classList.add('active');
  document.getElementById('topbar-title').textContent=PAGE_TITLES[id]||id;
  if(id==='dashboard')initCharts();
}

// ── KW ──
function showKw(id,el){
  document.querySelectorAll('.kw-panel').forEach(p=>p.classList.remove('show'));
  document.querySelectorAll('.kw-tag').forEach(t=>t.classList.remove('on'));
  const p=document.getElementById('kw-'+id);
  if(p){p.classList.toggle('show');el.classList.toggle('on');}
}

// ── MODEL ──
function toggleLayer(el){el.classList.toggle('open');}

// ── LIVE CLOCK ──
function updateClock(){
  const now=new Date();
  const s=now.toTimeString().slice(0,8);
  document.getElementById('live-clock').textContent=s;
  document.getElementById('tick-time').textContent=s;
}
setInterval(updateClock,1000);
updateClock();

// ── FLICKER ──
function flicker(){
  const kw=document.getElementById('tick-kw');
  if(kw&&Math.random()>.85){
    const v=parseInt(kw.textContent);
    kw.textContent=v+(Math.random()>.5?1:0);
    kw.style.color='#9FAC24';
    setTimeout(()=>kw.style.color='',400);
  }
}
setInterval(flicker,3000);

// ── UPLOAD DRAG & DROP ──
function handleDragOver(e){e.preventDefault();document.getElementById('upload-zone').classList.add('drag-over');}
function handleDragLeave(e){document.getElementById('upload-zone').classList.remove('drag-over');}
function handleDrop(e){
  e.preventDefault();
  const zone=document.getElementById('upload-zone');
  zone.classList.remove('drag-over');
  const files=e.dataTransfer.files;
  if(files.length>0) realUpload(files);
}
function triggerUpload(){document.getElementById('file-input').click();}
function handleFileSelect_zone2_DEPRECATED(e){
  const files=e.target.files;
  if(files.length>0) realUpload(files);
}

// 真实上传函数
async function realUpload(files){
  const zone=document.getElementById('upload-zone');
  const progress=document.getElementById('upload-progress');
  const fill=document.getElementById('upload-prog-fill');
  const label=document.getElementById('upload-prog-label');
  const title=document.getElementById('upload-title');
  const sub=document.getElementById('upload-sub');

  zone.classList.add('uploading');
  progress.classList.add('show');
  title.textContent='正在上传 ' + files.length + ' 个文件...';
  sub.textContent='AI 处理中，请稍候...';

  fill.style.width = '0%';
  label.textContent = '正在上传文件...';

  try {
    // 调用真实API上传
    const result = await uploadFiles(Array.from(files), getCurrentProjectId(), (current, total) => {
      const pct = Math.round((current / total) * 100);
      fill.style.width = pct + '%';
      label.textContent = `正在上传 ${current}/${total} 个文件...`;
    });

    // 上传完成
    fill.style.width = '100%';
    label.textContent = 'AI处理完成';

    // 显示处理结果摘要
    let totalKeywords = 0;
    let totalInsights = 0;
    result.results.forEach(r => {
      if (r.keywords) totalKeywords += r.keywords.length;
      if (r.insights) totalInsights += r.insights.length;
    });

    setTimeout(() => {
      zone.classList.remove('uploading');
      progress.classList.remove('show');
      title.textContent = '✅ 处理完成';
      sub.textContent = `已上传 ${result.success} 个文件 · 提取 ${totalKeywords} 个关键词 · 生成 ${totalInsights} 条洞察`;
      fill.style.width = '0%';

      // 刷新文件列表
      loadImportPage();

      // 显示详细结果
      showUploadResultModal(result);

      setTimeout(() => {
        title.textContent = '拖拽文件到此处';
        sub.textContent = '或点击选择文件上传';
      }, 5000);

      showToast(`✅ 成功上传 ${result.success} 个文件，已自动提取关键词`, 'success');
    }, 500);

  } catch (error) {
    console.error('上传失败:', error);
    zone.classList.remove('uploading');
    progress.classList.remove('show');
    title.textContent = '❌ 上传失败';
    sub.textContent = error.message || '请重试';
    fill.style.width = '0%';

    setTimeout(() => {
      title.textContent = '拖拽文件到此处';
      sub.textContent = '或点击选择文件上传';
    }, 3000);

    showToast('上传失败: ' + error.message, 'error');
  }
}

// 显示上传结果详情弹窗
function showUploadResultModal(result) {
  // 创建弹窗
  const modal = document.createElement('div');
  modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:10000;display:flex;align-items:center;justify-content:center;';

  let detailsHTML = '';
  result.results.forEach((r, i) => {
    if (!r.error) {
      const keywords = r.keywords ? r.keywords.join('、') : '无';
      const insights = r.insights && r.insights.length > 0 ? r.insights[0] : '正在分析...';
      detailsHTML += `
        <div style="padding:12px;border-bottom:1px solid var(--border);background:var(--surface2);border-radius:8px;margin-bottom:8px;">
          <div style="font-weight:600;color:var(--text);margin-bottom:6px;">📄 ${r.filename}</div>
          <div style="font-size:11px;color:var(--text3);margin-bottom:4px;">关键词：<span style="color:var(--a1);">${keywords}</span></div>
          ${insights ? `<div style="font-size:10px;color:var(--text2);background:var(--a1-dim);padding:6px 8px;border-radius:4px;margin-top:4px;">💡 ${insights}</div>` : ''}
        </div>
      `;
    }
  });

  modal.innerHTML = `
    <div style="background:var(--surface);border-radius:16px;width:90%;max-width:700px;max-height:80vh;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
      <div style="padding:20px 24px;border-bottom:1px solid var(--border);background:linear-gradient(135deg, var(--a1) 0%, var(--a5) 100%);">
        <div style="font-size:18px;font-weight:800;color:white;">🎉 文件上传成功</div>
        <div style="font-size:12px;color:rgba(255,255,255,0.9);margin-top:6px;">AI已自动处理并提取关键信息</div>
      </div>
      <div style="padding:20px 24px;max-height:400px;overflow-y:auto;">
        ${detailsHTML}
      </div>
      <div style="padding:16px 24px;border-top:1px solid var(--border);display:flex;gap:12px;justify-content:flex-end;">
        <button onclick="this.closest('[style*=fixed]').remove();showPage('keyword',document.querySelector('.sb-item[onclick*=keyword]'))" style="padding:10px 20px;background:var(--a1);color:white;border:none;border-radius:8px;cursor:pointer;font-weight:600;font-size:12px;">
          查看关键词 →
        </button>
        <button onclick="this.closest('[style*=fixed]').remove()" style="padding:10px 20px;background:var(--surface2);color:var(--text);border:none;border-radius:8px;cursor:pointer;font-weight:600;font-size:12px;">
          关闭
        </button>
      </div>
    </div>
  `;

  document.body.appendChild(modal);

  // 点击背景关闭
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.remove();
  });
}
function addFileToList(name){
  const list=document.getElementById('file-list-main');
  const ext=name.split('.').pop().toLowerCase();
  const typeMap={mp3:'audio',mp4:'video',wav:'audio',md:'doc',pdf:'doc',xlsx:'sheet'};
  const type=typeMap[ext]||'doc';
  const iconMap={
    audio:'<path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/>',
    video:'<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>',
    doc:'<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/>',
    sheet:'<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>'
  };
  const item=document.createElement('div');
  item.className='file-item';
  item.style.animation='countUp .4s ease';
  item.innerHTML=`<div class="file-icon ${type}"><svg viewBox="0 0 24 24">${iconMap[type]}</svg></div><div class="file-info"><div class="file-name">${name}</div><div class="file-meta">刚刚上传 · AI 处理中</div></div><div class="file-status proc">处理中</div>`;
  list.insertBefore(item,list.firstChild);
}

// ── BIZ DRAWER ──
const BIZ_DATA={
  agri:{title:'传统农业',sub:'现有业态 · 可持续性评估',score:62,scoreColor:'var(--a2)',dims:[{label:'资源禀赋',val:75,color:'var(--a2)'},{label:'市场需求',val:55,color:'var(--a1)'},{label:'启动门槛',val:80,color:'var(--a5)'},{label:'可持续性',val:62,color:'var(--a2)'},{label:'社区参与',val:70,color:'var(--a3)'}],summary:'传统农业是村庄最稳定的经济基础，但受山地地形限制，机械化程度低，收益有限。水稻、玉米为主，部分种植辣椒等经济作物。',opportunity:'有机农业转型潜力较大，贵州山地农产品具备差异化优势，可探索与研学营结合的农耕体验业态。',steps:[{title:'有机认证申请',desc:'申请有机农产品认证，提升产品附加值，目标价格提升 30—50%'},{title:'农耕体验设计',desc:'结合研学营，设计插秧、收割等农耕体验课程，增加非农收入'},{title:'特色农产品开发',desc:'开发布依族传统食品（如糯米酒、腌菜）的标准化产品'}],risks:[{level:'mid',text:'山地地形限制规模化生产，机械化改造成本高'},{level:'low',text:'有机认证周期较长（约 3 年），短期收益提升有限'}]},
  batik:{title:'蜡染手工艺',sub:'文化资产 · 濒危传承',score:45,scoreColor:'var(--a5)',dims:[{label:'文化价值',val:92,color:'var(--a2)'},{label:'市场需求',val:60,color:'var(--a1)'},{label:'传承现状',val:20,color:'var(--red)'},{label:'商业潜力',val:65,color:'var(--a5)'},{label:'启动门槛',val:55,color:'var(--a3)'}],summary:'蜡染工艺是布依族最具代表性的非物质文化遗产之一，但传承状况极为危急。仅 3 位老人（平均年龄 64 岁）掌握完整工艺，年轻人几乎无人学习。',opportunity:'蜡染工艺具备极高的文创转化潜力。与山歌元素结合，可开发独特的布依族文化IP，在文创市场具备差异化竞争优势。',steps:[{title:'紧急数字化存档',desc:'对 3 位传承人的完整工艺进行视频记录，建立数字档案，防止技艺失传'},{title:'引入设计师合作',desc:'与高校设计专业或独立设计师合作，将传统图案转化为现代文创产品'},{title:'建立传承工坊',desc:'申请非遗保护资金，建立蜡染传承工坊，招募村内青少年学习'}],risks:[{level:'high',text:'传承人年龄偏大，若不立即行动，完整工艺将在 5—10 年内失传'},{level:'mid',text:'文创产品开发需要外部设计力量，本地缺乏相关人才'},{level:'low',text:'市场对手工艺品的价格接受度存在不确定性'}]},
  labor:{title:'外出务工',sub:'现有业态 · 主要收入来源',score:78,scoreColor:'var(--a1)',dims:[{label:'收入稳定性',val:82,color:'var(--a1)'},{label:'可持续性',val:55,color:'var(--a5)'},{label:'社区影响',val:25,color:'var(--red)'},{label:'返乡意愿',val:60,color:'var(--a2)'},{label:'政策支持',val:70,color:'var(--a3)'}],summary:'外出务工是村庄最主要的收入来源，约 60% 青壮年在外务工，汇款占家庭收入约 65%。短期内难以改变，但长期来看导致村庄空心化加剧。',opportunity:'部分外出务工青年有返乡意愿，可通过政策引导和业态孵化，将其转化为村庄发展的核心力量。返乡创业政策支持力度较大。',steps:[{title:'摸底返乡意愿',desc:'对外出务工青年进行问卷调查，了解返乡意愿、技能储备和资金情况'},{title:'对接返乡创业政策',desc:'协助有意愿者申请贵州省返乡创业补贴、小额贷款等政策支持'},{title:'业态孵化对接',desc:'将有返乡意愿的青年与研学营、文创等业态孵化计划对接'}],risks:[{level:'mid',text:'外出务工收入稳定，返乡创业风险较高，需要足够的政策和资金支持'},{level:'low',text:'部分青年已在城市安家，返乡意愿受家庭因素影响较大'}]},
  study:{title:'山歌研学营',sub:'推演业态 · 最高可行性',score:82,scoreColor:'#6B7A1A',dims:[{label:'资源匹配',val:88,color:'var(--a2)'},{label:'市场需求',val:80,color:'var(--a1)'},{label:'政策支持',val:85,color:'var(--a2)'},{label:'启动门槛',val:75,color:'var(--a5)'},{label:'社区参与',val:82,color:'var(--a3)'}],summary:'山歌研学营是当前可行性最高的业态推演。以布依族山歌为核心，面向中小学生开展非遗研学活动，传承人可直接参与，与国家非遗教育政策高度契合。',opportunity:'研学旅行市场规模持续增长，非遗类研学产品稀缺性强。贵州省对非遗研学有专项政策支持，启动门槛相对较低，可作为第一步切入点。',steps:[{title:'课程体系设计',desc:'以王大爷为核心，设计 1 日/2 日/3 日研学课程，包含山歌学习、蜡染体验、农耕体验等模块'},{title:'试点合作学校',desc:'与贵阳、都匀等周边城市的 3—5 所学校建立合作，开展 2—3 次试点活动'},{title:'基础设施建设',desc:'改造村内闲置房屋为研学接待中心，建设简单的住宿和餐饮设施'},{title:'品牌与推广',desc:'建立"布依山歌研学营"品牌，通过研学平台和社交媒体进行推广'}],risks:[{level:'mid',text:'研学市场竞争激烈，需要差异化的产品设计和有效的渠道推广'},{level:'mid',text:'传承人年龄偏大，需要提前培养年轻的辅助讲师'},{level:'low',text:'季节性较强，需要设计全年课程以保证稳定收入'}]},
  creative:{title:'山歌×蜡染文创',sub:'推演业态 · 跨界融合',score:71,scoreColor:'var(--a1)',dims:[{label:'文化独特性',val:90,color:'var(--a2)'},{label:'市场潜力',val:72,color:'var(--a1)'},{label:'设计能力',val:35,color:'var(--red)'},{label:'供应链',val:55,color:'var(--a5)'},{label:'品牌潜力',val:80,color:'var(--a3)'}],summary:'将布依族山歌的歌词、旋律元素与蜡染传统图案融合，开发具有独特文化IP的文创产品。文化独特性极强，但需要外部设计力量介入。',opportunity:'布依族文化IP在文创市场具备稀缺性，山歌×蜡染的跨界融合是独特的差异化定位。可通过电商平台触达全国市场。',steps:[{title:'IP设计开发',desc:'与高校设计专业合作，将山歌元素（歌词、音符、演唱场景）与蜡染图案融合，开发系列文创产品'},{title:'小批量试产',desc:'选择 3—5 款核心产品进行小批量试产，通过线上平台测试市场反应'},{title:'建立供应链',desc:'与贵州本地工厂合作，建立稳定的生产供应链，控制产品质量'}],risks:[{level:'high',text:'本地缺乏设计人才，外部合作成本较高，需要前期投入'},{level:'mid',text:'文创产品市场竞争激烈，品牌建设需要持续投入'},{level:'low',text:'蜡染传承人产能有限，手工产品规模化存在瓶颈'}]},
  inn:{title:'山歌主题民宿',sub:'推演业态 · 长期价值',score:58,scoreColor:'#8A6A3A',dims:[{label:'差异化程度',val:88,color:'var(--a2)'},{label:'市场需求',val:65,color:'var(--a1)'},{label:'启动资金',val:25,color:'var(--red)'},{label:'运营能力',val:40,color:'var(--a5)'},{label:'长期价值',val:80,color:'var(--a3)'}],summary:'以布依族山歌文化为主题的特色民宿，差异化定位明显，长期价值高。但前期投入较大，运营能力要求高，建议在研学营成功运营后再考虑。',opportunity:'民宿市场对文化主题产品需求旺盛，布依族山歌主题具备独特吸引力。可与研学营形成联动，提供住宿配套服务。',steps:[{title:'可行性评估',desc:'在研学营运营 6 个月后，根据客流数据评估民宿需求，再决定是否启动'},{title:'改造方案设计',desc:'选择 3—5 栋闲置民居进行改造，保留布依族建筑风格，融入山歌文化元素'},{title:'运营团队培训',desc:'培训本地村民掌握民宿运营基本技能，优先使用本地人才'}],risks:[{level:'high',text:'前期改造投入较大（预估 50—100 万元），资金来源需要提前规划'},{level:'high',text:'运营能力要求高，本地缺乏相关经验，需要引入外部运营支持'},{level:'mid',text:'民宿市场受政策和疫情等外部因素影响较大'}]}
};

function openDrawer(id){
  const d=BIZ_DATA[id];
  if(!d)return;
  document.getElementById('drawer-title').textContent=d.title;
  document.getElementById('drawer-sub').textContent=d.sub;
  let html=`
    <div style="display:flex;align-items:flex-end;gap:12px;margin-bottom:20px;padding:16px;background:var(--surface2);border-radius:10px;border:1px solid var(--border);">
      <div><div style="font-size:10px;color:var(--text3);margin-bottom:4px;">综合可行性评分</div><div class="drawer-score-big" style="color:${d.scoreColor};">${d.score}</div></div>
      <div style="font-size:14px;color:var(--text3);margin-bottom:8px;">/100</div>
      <div style="flex:1;margin-left:8px;">
        <div style="height:8px;background:var(--surface3);border-radius:4px;overflow:hidden;"><div style="height:100%;width:${d.score}%;background:${d.scoreColor};border-radius:4px;transition:width .8s ease;"></div></div>
        <div style="font-size:10px;color:var(--text3);margin-top:5px;">${d.score>=80?'高可行性':d.score>=60?'中等可行性':'需要更多条件'}</div>
      </div>
    </div>
    <div class="drawer-section">
      <div class="drawer-section-title">多维度评估</div>
      ${d.dims.map(dim=>`<div class="dim-row"><div class="dim-label">${dim.label}</div><div class="dim-track"><div class="dim-fill" style="width:${dim.val}%;background:${dim.color};"></div></div><div class="dim-val">${dim.val}</div></div>`).join('')}
    </div>
    <div class="drawer-section">
      <div class="drawer-section-title">现状分析</div>
      <div style="font-size:11px;color:var(--text2);line-height:1.75;">${d.summary}</div>
    </div>
    <div class="drawer-section">
      <div class="drawer-section-title">机会点</div>
      <div class="ai-box" style="margin:0;"><div class="ai-body" style="font-size:11px;">${d.opportunity}</div></div>
    </div>
    <div class="drawer-section">
      <div class="drawer-section-title">行动步骤</div>
      ${d.steps.map((s,i)=>`<div class="action-step"><div class="action-step-num">${i+1}</div><div class="action-step-body"><div class="action-step-title">${s.title}</div><div class="action-step-desc">${s.desc}</div></div></div>`).join('')}
    </div>
    <div class="drawer-section">
      <div class="drawer-section-title">风险识别</div>
      ${d.risks.map(r=>`<div class="risk-item ${r.level}"><span class="risk-label">${r.level==='high'?'高风险':r.level==='mid'?'中风险':'低风险'}</span><div class="risk-text">${r.text}</div></div>`).join('')}
    </div>
  `;
  document.getElementById('drawer-body').innerHTML=html;
  document.getElementById('drawer-overlay').classList.add('open');
  document.getElementById('biz-drawer').classList.add('open');
}
function closeDrawer(){
  document.getElementById('drawer-overlay').classList.remove('open');
  document.getElementById('biz-drawer').classList.remove('open');
}

// ── SKILL MODAL ──
function openSkillModal(){document.getElementById('skill-modal').classList.add('open');}
function closeSkillModal(){document.getElementById('skill-modal').classList.remove('open');}
function createSkill(){
  closeSkillModal();
  // 简单反馈
  const toast=document.createElement('div');
  toast.style.cssText='position:fixed;bottom:24px;right:24px;background:var(--a2);color:#fff;padding:10px 18px;border-radius:8px;font-size:12px;font-weight:700;z-index:999;box-shadow:0 4px 20px rgba(159,172,36,.4);animation:countUp .3s ease;';
  toast.textContent='Skill 创建成功';
  document.body.appendChild(toast);
  setTimeout(()=>toast.remove(),2500);
}

// ── SKILL TOGGLE ──
function toggleSkill(el,e){
  e.stopPropagation();
  const isOn=el.classList.contains('on');
  el.classList.toggle('on',!isOn);
  el.classList.toggle('off',isOn);
  el.textContent=isOn?'未激活':'已激活';
  el.title=isOn?'点击激活':'点击停用';
  const toast=document.createElement('div');
  const card=el.closest('.skill-card');
  const name=card.querySelector('.skill-name').textContent;
  toast.style.cssText='position:fixed;bottom:24px;right:24px;padding:10px 18px;border-radius:8px;font-size:12px;font-weight:700;z-index:999;animation:countUp .3s ease;';
  if(!isOn){
    toast.style.background='var(--a2)';toast.style.color='#fff';
    toast.style.boxShadow='0 4px 20px rgba(159,172,36,.4)';
    toast.textContent=name+' 已激活';
  }else{
    toast.style.background='var(--surface)';toast.style.color='var(--text2)';
    toast.style.border='1px solid var(--border2)';
    toast.style.boxShadow='var(--shadow-lg)';
    toast.textContent=name+' 已停用';
  }
  document.body.appendChild(toast);
  setTimeout(()=>toast.remove(),2000);
}

// ── CHARTS ──
let chartsInited=false;
function initCharts(){
  if(chartsInited)return;
  chartsInited=true;
  const A1='#178AB7',A2='#9FAC24',A3='#D9BC92',A4='#45481D',A5='#6FA7B6';
  const RED='#C0392B';
  const GRID='rgba(23,138,183,.07)';
  const TICK={color:'#5A6A7A',font:{size:10,family:"'Inter Tight',sans-serif"}};

  new Chart(document.getElementById('chart-trend'),{type:'line',data:{labels:['1月','2月','3月','4月','5月','6月'],datasets:[{label:'布依族山歌',data:[4,7,12,18,26,34],borderColor:A1,backgroundColor:'rgba(23,138,183,.07)',fill:true,tension:0.4,pointRadius:3,pointBackgroundColor:A1,borderWidth:2},{label:'土地流转',data:[6,9,14,19,23,28],borderColor:A2,backgroundColor:'rgba(159,172,36,.05)',fill:true,tension:0.4,pointRadius:3,pointBackgroundColor:A2,borderWidth:2},{label:'蜡染工艺',data:[3,5,8,12,16,21],borderColor:A5,backgroundColor:'rgba(111,167,182,.05)',fill:true,tension:0.4,pointRadius:3,pointBackgroundColor:A5,borderWidth:2},{label:'外出务工',data:[8,10,13,15,17,19],borderColor:A3,backgroundColor:'rgba(217,188,146,.05)',fill:true,tension:0.4,pointRadius:3,pointBackgroundColor:A3,borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:TICK},y:{grid:{color:GRID},ticks:{...TICK,callback:v=>v+'次'}}}}});

  new Chart(document.getElementById('chart-biz'),{type:'bar',data:{labels:['山歌研学营','外出务工','山歌×蜡染','传统农业','主题民宿','蜡染手工艺'],datasets:[{data:[82,78,71,62,58,45],backgroundColor:[A2,A1,A1,A5,A3,A5],borderRadius:3,borderWidth:0}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:GRID},ticks:{...TICK,callback:v=>v+'%'},max:100},y:{grid:{display:false},ticks:TICK}}}});

  new Chart(document.getElementById('chart-type'),{type:'doughnut',data:{labels:['音频','视频','文档','表格'],datasets:[{data:[23,12,8,4],backgroundColor:[A1,A2,A5,A3],borderWidth:0,hoverOffset:4}]},options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{display:false}}}});

  new Chart(document.getElementById('chart-kw'),{type:'polarArea',data:{labels:['文化传承','经济生产','社会结构','政策制度','生态环境'],datasets:[{data:[38,31,24,19,16],backgroundColor:['rgba(23,138,183,.65)','rgba(159,172,36,.65)','rgba(111,167,182,.65)','rgba(217,188,146,.7)','rgba(69,72,29,.45)'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{r:{grid:{color:GRID},ticks:{display:false}}}}});

  new Chart(document.getElementById('chart-verify'),{type:'doughnut',data:{labels:['材料支撑','待验证','认知被推翻'],datasets:[{data:[3,2,1],backgroundColor:[A2,A1,RED],borderWidth:0,hoverOffset:4}]},options:{responsive:true,maintainAspectRatio:false,cutout:'58%',plugins:{legend:{display:false}}}});

  new Chart(document.getElementById('chart-sop'),{type:'radar',data:{labels:['社区调研','文化盘点','利益相关方','业态评估','风险识别','行动规划'],datasets:[{label:'完成度',data:[92,78,65,71,45,30],backgroundColor:'rgba(23,138,183,.09)',borderColor:A1,pointBackgroundColor:A1,pointRadius:3,borderWidth:1.5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{r:{grid:{color:GRID},angleLines:{color:GRID},ticks:{display:false,stepSize:20},pointLabels:{color:'#5A6A7A',font:{size:9,family:"'Inter Tight',sans-serif"}},min:0,max:100}}}});

  new Chart(document.getElementById('chart-weekly'),{type:'bar',data:{labels:['第1周','第2周','第3周','第4周','第5周','第6周'],datasets:[{label:'音频',data:[3,4,5,4,5,2],backgroundColor:A1,borderRadius:2,borderWidth:0},{label:'视频',data:[1,2,2,2,3,2],backgroundColor:A2,borderRadius:2,borderWidth:0},{label:'文档',data:[1,1,2,1,2,1],backgroundColor:A5,borderRadius:2,borderWidth:0},{label:'表格',data:[0,1,0,1,1,1],backgroundColor:A3,borderRadius:2,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{stacked:true,grid:{display:false},ticks:TICK},y:{stacked:true,grid:{color:GRID},ticks:{...TICK,callback:v=>v+'份'}}}}});
}

document.addEventListener('DOMContentLoaded',()=>{
  if(document.getElementById('page-dashboard').classList.contains('active'))initCharts();
});





// ── VEIN PAGE ──
let currentVein='culture';
function selectVein(id,el){
  document.querySelectorAll('.vein-main-item').forEach(i=>i.classList.remove('active'));
  el.classList.add('active');
  // 隐藏所有脉络内容
  ['culture','economy','society','policy','biz','ecology'].forEach(v=>{
    const el=document.getElementById('vein-'+v);
    if(el)el.style.display='none';
  });
  const target=document.getElementById('vein-'+id);
  if(target){target.style.display='block';target.classList.add('fade-in');setTimeout(()=>target.classList.remove('fade-in'),300);}
  currentVein=id;
}

function toggleSubVein(card){
  const wasExpanded=card.classList.contains('expanded');
  // 收起同级所有
  card.closest('.sub-vein-grid').querySelectorAll('.sub-vein-card').forEach(c=>c.classList.remove('expanded'));
  if(!wasExpanded)card.classList.add('expanded');
}

function switchVeinView(view,el){
  document.querySelectorAll('.tabs .tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  // 关系图视图占位
  if(view==='map'){showToast('关系图视图开发中，敬请期待','info');}
}

function goToReport(reportId,e){
  e.stopPropagation();
  showPage('report3',document.querySelector('.sb-item[onclick*="report3"]'));
  setTimeout(()=>switchReport(reportId,document.querySelectorAll('.report3-nav-item')[{r1:0,r2:1,r3:2}[reportId]]),100);
}

// ── CHRONICLE PAGE ──
function scrollToYear(year,btn){
  document.querySelectorAll('.chronicle-year-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const target=document.getElementById('year-'+year);
  if(target)target.scrollIntoView({behavior:'smooth',block:'start'});
}

let activeFilter='all';
function toggleFilter(chip,type){
  document.querySelectorAll('.filter-chip').forEach(c=>c.classList.remove('active'));
  chip.classList.add('active');
  activeFilter=type;
  document.querySelectorAll('.chronicle-entry').forEach(entry=>{
    if(type==='all'){entry.style.display='';}
    else{entry.style.display=entry.dataset.type===type?'':'none';}
  });
}

// ── REPORT3 PAGE ──
function switchReport(id,el){
  document.querySelectorAll('.report3-nav-item').forEach(i=>i.classList.remove('active'));
  document.querySelectorAll('.report3-content').forEach(c=>c.classList.remove('active'));
  if(el)el.classList.add('active');
  const content=document.getElementById('report-'+id);
  if(content){content.classList.add('active');content.classList.add('fade-in');setTimeout(()=>content.classList.remove('fade-in'),300);}
}

// ── DOWNLOAD MODAL ──
let currentDlTarget='';
function openDlModal(title){
  currentDlTarget=title;
  document.getElementById('dl-modal-title').textContent='下载 · '+title;
  document.getElementById('dl-modal').classList.add('open');
}
function closeDlModal(){document.getElementById('dl-modal').classList.remove('open');}
function downloadReport(format){
  closeDlModal();
  if(format==='html'){
    showToast('正在生成 '+currentDlTarget+' HTML 文件...','success');
    // 实际项目中调用后端 API: POST /api/reports/export {type, format}
    setTimeout(()=>showToast(currentDlTarget+' 已下载到本地','success'),1500);
  }else if(format==='pdf'){
    showToast('正在调用打印功能...','info');
    setTimeout(()=>window.print(),500);
  }
}

// ── 知识图谱交互功能 ──
function switchGraphView(viewType, btn) {
  // 切换tab状态
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');

  // 显示切换提示
  const viewNames = {
    'network': '网络图',
    'tree': '树形图',
    'timeline': '时间轴'
  };
  showToast(`已切换到${viewNames[viewType]}视图`, 'success');

  // 实际项目中这里会重新渲染图谱
  console.log('切换到视图:', viewType);
}

function addGraphNode() {
  const nodeName = prompt('请输入新节点名称：');
  if (!nodeName) return;

  showToast(`节点"${nodeName}"已添加到知识图谱`, 'success');

  // 实际项目中调用API: POST /api/graph/nodes {name, type}
  console.log('添加节点:', nodeName);
}

// ── CHAT ──
const CHAT_RESPONSES={
  '土地流转':'根据土地流转现状调研笔记及村委会座谈记录，土地流转矛盾的根本原因有三：①价格机制不透明（农户对流转收益的预期与实际落差大）；②利益分配不公平（流转方获益远高于农户）；③农户缺乏议价能力（信息不对称，法律意识薄弱）。\n\n最深层的矛盾是：农户将土地视为"保障"而非"资产"，流转方将土地视为"生产要素"，两种土地观念的冲突是所有纠纷的根源。',
  '蜡染':'根据蜡染工艺传承人访谈（2023-11-08），3位传承人平均年龄64岁，最年轻者58岁。按正常传承周期，完整工艺的传授需要3—5年。若不立即启动传承计划，在10—15年内，完整工艺将面临失传风险。\n\n但"失传"不是唯一结局。数字化存档（视频记录完整工艺流程）可以保留技艺信息，即使传承人离世，工艺也不会完全消失。关键是现在就要行动。',
  '风险':'三度报告中识别了研学营的三个主要风险：\n\n① 市场风险（中等）：研学市场竞争激烈，需要差异化产品设计和有效渠道推广。建议先通过试点积累口碑，再扩大规模。\n\n② 传承人风险（高）：传承人年龄偏大，健康状况是最大变量。建议尽快培养2—3名年轻辅助讲师，降低对单一传承人的依赖。\n\n③ 季节性风险（低）：研学市场有明显的寒暑假高峰，需要设计全年课程保证稳定收入。',
  '费孝通':'二度报告从费孝通差序格局视角分析了村庄的核心发现：\n\n村庄社会关系以王、李、张三大姓氏为骨架，形成典型的差序格局。村支书王某的权威来源不仅是行政职位，更是建立在王姓宗族网络之上的社会资本。\n\n关键洞察：山歌传承的困境，部分原因在于传承关系的"差序化"——传承人倾向于在家族内部传承。打破这一逻辑，需要建立超越血缘的传承机制（如研学营），将传承关系从"差序"转向"团体"。',
  '材料':'当前47份材料中，已完成AI处理44份（93.6%），处理中2份（村委会座谈记录_20240320.mp3、村庄经济数据汇总表.xlsx），待处理1份。\n\n处理中的村委会座谈记录是本次调研最重要的集体访谈材料，预计处理完成后将新增15—20个关键词。建议优先跟进这份材料的处理进度。'
};

function sendMessage(){
  const input=document.getElementById('chat-input');
  const msg=input.value.trim();
  if(!msg)return;
  addUserMessage(msg);
  input.value='';
  autoResize(input);
  showThinking();
  setTimeout(()=>{
    removeThinking();
    const response=getResponse(msg);
    addAIMessage(response);
  },1200+Math.random()*800);
}

function sendSuggestion(el){
  const msg=el.textContent;
  document.getElementById('chat-input').value=msg;
  sendMessage();
}

function getResponse(msg){
  for(const key in CHAT_RESPONSES){
    if(msg.includes(key))return CHAT_RESPONSES[key];
  }
  return '根据当前知识库，我找到了与"'+msg+'"相关的内容。这个问题涉及多个维度，建议结合一度报告的信息梳理和二度报告的框架分析来理解。\n\n如果你想深入了解某个具体方面，可以更具体地提问，例如指定材料来源或报告章节。';
}

function addUserMessage(msg){
  const container=document.getElementById('chat-messages');
  const div=document.createElement('div');
  div.className='chat-msg user fade-in';
  div.innerHTML=`<div class="chat-msg-avatar">田</div><div><div class="chat-msg-bubble">${escapeHtml(msg)}</div><div class="chat-msg-meta">${new Date().toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'})}</div></div>`;
  container.appendChild(div);
  container.scrollTop=container.scrollHeight;
}

function addAIMessage(msg){
  const container=document.getElementById('chat-messages');
  const div=document.createElement('div');
  div.className='chat-msg ai fade-in';
  const formatted=msg.replace(/\n\n/g,'<br><br>').replace(/\n/g,'<br>').replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>');
  div.innerHTML=`<div class="chat-msg-avatar">AI</div><div><div class="chat-msg-bubble">${formatted}</div><div class="chat-msg-meta">FieldMind AI · ${new Date().toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'})}</div></div>`;
  container.appendChild(div);
  container.scrollTop=container.scrollHeight;
}

function showThinking(){
  const container=document.getElementById('chat-messages');
  const div=document.createElement('div');
  div.className='chat-msg ai';div.id='thinking-indicator';
  div.innerHTML=`<div class="chat-msg-avatar">AI</div><div><div class="chat-msg-bubble"><div class="chat-thinking"><div class="chat-thinking-dot"></div><div class="chat-thinking-dot"></div><div class="chat-thinking-dot"></div></div></div></div>`;
  container.appendChild(div);
  container.scrollTop=container.scrollHeight;
}

function removeThinking(){
  const el=document.getElementById('thinking-indicator');
  if(el)el.remove();
}

function handleChatKey(e){
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage();}
}

function autoResize(el){
  el.style.height='auto';
  el.style.height=Math.min(el.scrollHeight,120)+'px';
}

function escapeHtml(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}



// ── INIT ──
// 默认显示知识脉络页
document.addEventListener('DOMContentLoaded',()=>{
  // 激活第一个侧边栏项（知识脉络）
  const veinBtn=document.querySelector('.sb-item[onclick*="vein"]');
  if(veinBtn)veinBtn.classList.add('active');
});

// ── DEMO SECTION SWITCH ──
function showDemo(id){
  document.querySelectorAll('.demo-section').forEach(s=>s.style.display='none');
  document.querySelectorAll('.demo-btn').forEach(b=>b.classList.remove('active'));
  const sec=document.getElementById('demo-'+id);
  if(sec)sec.style.display='block';
  const btn=document.querySelector(`.demo-btn[onclick="showDemo('${id}')"]`);
  if(btn)btn.classList.add('active');
}





// ── LOGIN ──
function doLogin(){
  const btn=document.getElementById('login-btn');
  const user=document.getElementById('login-user').value;
  const pass=document.getElementById('login-pass').value;
  const err=document.getElementById('login-error');
  err.classList.remove('show');
  btn.textContent='登录中...';btn.classList.add('loading');
  setTimeout(()=>{
    btn.textContent='登 录';btn.classList.remove('loading');
    if(user&&pass){
      showToast('登录成功，欢迎回来 '+user,'success');
      setTimeout(()=>showPage('overview', document.querySelector('.sb-item[onclick*="overview"]')),800);
    }else{
      err.classList.add('show');
      document.getElementById('login-user').classList.add('error');
    }
  },1200);
}
function doLocalLogin(){
  showToast('本地模式启动中...','info');
  setTimeout(()=>showPage('overview', document.querySelector('.sb-item[onclick*="overview"]')),800);
}
function togglePwd(){
  const input=document.getElementById('login-pass');
  input.type=input.type==='password'?'text':'password';
}

// ── ONBOARDING STEPS ──
let currentStep=1;
function goStep(n){
  // 更新步骤面板
  document.querySelectorAll('.step-panel').forEach(p=>p.classList.remove('active'));
  const panel=document.getElementById('step-'+n);
  if(panel){panel.classList.add('active');panel.classList.add('fade-in');setTimeout(()=>panel.classList.remove('fade-in'),300);}
  // 更新步骤条
  for(let i=1;i<=5;i++){
    const circle=document.getElementById('sc-'+i);
    const label=document.getElementById('sl-'+i);
    const conn=document.getElementById('conn-'+i);
    if(!circle)continue;
    if(i<n){
      circle.className='step-circle done';
      circle.textContent='✓';
      label.className='step-label done';
      if(conn)conn.className='step-connector done';
    }else if(i===n){
      circle.className='step-circle active';
      circle.textContent=i;
      label.className='step-label active';
    }else{
      circle.className='step-circle pending';
      circle.textContent=i===5?'✓':i;
      label.className='step-label pending';
    }
  }
  currentStep=n;
  // 步骤4：模拟进度
  if(n===4)simulateProgress();
  // 步骤5：完成
  if(n===5){
    document.getElementById('sc-5').className='step-circle done';
    document.getElementById('sl-5').className='step-label done';
  }
}

// 模拟处理进度
let procInterval=null;
function simulateProgress(){
  let pct=38;
  if(procInterval)clearInterval(procInterval);
  procInterval=setInterval(()=>{
    pct=Math.min(pct+Math.random()*3,100);
    document.getElementById('proc-bar').style.width=pct+'%';
    document.getElementById('proc-pct').textContent=Math.round(pct)+'%';
    if(pct>=100){
      clearInterval(procInterval);
      setTimeout(()=>goStep(5),800);
    }
  },400);
}

// ── TAG INPUT ──
function addTag(e){
  if(e.key!=='Enter')return;
  e.preventDefault();
  const field=document.getElementById('tag-field');
  const val=field.value.trim();
  if(!val)return;
  const wrap=document.getElementById('tag-wrap');
  const pill=document.createElement('span');
  pill.className='tag-pill';
  pill.innerHTML=val+' <span class="tag-pill-del" onclick="removeTag(this)">×</span>';
  wrap.insertBefore(pill,field);
  field.value='';
}
function removeTag(el){el.closest('.tag-pill').remove();}

// ── FILE IMPORT ──
function handleFileSelect_newProject(e){
  const files=Array.from(e.target.files);
  files.forEach(f=>addFileToList(f));
}
function handleDrop(e){
  e.preventDefault();
  document.getElementById('import-zone').classList.remove('drag-over');
  const files=Array.from(e.dataTransfer.files);
  files.forEach(f=>addFileToList(f));
}
function getFileType(name){
  const ext=name.split('.').pop().toLowerCase();
  if(['mp3','wav','m4a','aac'].includes(ext))return 'audio';
  if(['mp4','mov','avi','mkv'].includes(ext))return 'video';
  if(['jpg','jpeg','png','gif','webp'].includes(ext))return 'img';
  return 'doc';
}
function getFileIcon(type){
  const icons={
    audio:'<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
    video:'<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>',
    doc:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>',
    img:'<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>'
  };
  return icons[type]||icons.doc;
}
function formatSize(bytes){
  if(bytes>1e9)return (bytes/1e9).toFixed(1)+' GB';
  if(bytes>1e6)return (bytes/1e6).toFixed(1)+' MB';
  return (bytes/1e3).toFixed(0)+' KB';
}
function addFileToList(file){
  const type=getFileType(file.name);
  const list=document.getElementById('import-list');
  const id='file-'+Date.now()+Math.random().toString(36).slice(2);
  const item=document.createElement('div');
  item.className='import-file-item';item.id=id;
  item.innerHTML=`
    <div class="import-file-icon ${type}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${getFileIcon(type)}</svg></div>
    <div class="import-file-info">
      <div class="import-file-name">${file.name}</div>
      <div class="import-file-meta">${type==='audio'?'音频':type==='video'?'视频':type==='img'?'图片':'文档'} · ${formatSize(file.size)}</div>
    </div>
    <div class="import-file-status">
      <div class="import-progress"><div class="import-progress-fill uploading" id="prog-${id}" style="width:0%"></div></div>
      <span class="import-file-pct" id="pct-${id}">0%</span>
    </div>
    <button class="import-file-del" onclick="document.getElementById('${id}').remove()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg></button>
  `;
  list.appendChild(item);
  // 模拟上传进度
  let pct=0;
  const interval=setInterval(()=>{
    pct=Math.min(pct+Math.random()*15,100);
    const bar=document.getElementById('prog-'+id);
    const label=document.getElementById('pct-'+id);
    if(bar)bar.style.width=pct+'%';
    if(label)label.textContent=Math.round(pct)+'%';
    if(pct>=100){
      clearInterval(interval);
      if(bar){bar.classList.remove('uploading');bar.classList.add('done');}
      if(label){label.textContent='完成';label.style.color='var(--a2)';}
    }
  },200);
}

// ── PROCESS TOGGLE ──
function toggleProcess(btn){
  const isOn=btn.classList.contains('on');
  btn.classList.toggle('on',!isOn);
  btn.classList.toggle('off',isOn);
  const icon=btn.closest('.process-item').querySelector('.process-item-icon');
  if(icon){icon.classList.toggle('on',!isOn);icon.classList.toggle('off',isOn);}
}

