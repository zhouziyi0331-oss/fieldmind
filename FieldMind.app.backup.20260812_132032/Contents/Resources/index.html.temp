      <div class="export-status-title">正在生成报告文件</div>
      <div class="export-status-sub">请稍候，通常需要 10–30 秒</div>
      <div style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:14px 16px;margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:11px;color:var(--text3);">
          <span>生成进度</span><span id="export-pct-label" style="font-family:'JetBrains Mono',monospace;color:var(--a1);">62%</span>
        </div>
        <div style="height:6px;background:var(--surface3);border-radius:3px;overflow:hidden;">
          <div id="export-loading-bar" style="height:100%;width:62%;background:linear-gradient(90deg,var(--a1),var(--a2));border-radius:3px;transition:width .4s ease;"></div>
        </div>
        <div style="font-size:10px;color:var(--text4);margin-top:8px;">正在处理：三度报告 · 商业推演章节...</div>
      </div>
    `,
    ft:`<button class="btn btn-ghost" onclick="closeExportModal()">后台运行</button>
        <button class="btn btn-danger" onclick="openConfirmModal('cancel-process');closeExportModal()">取消导出</button>`
  }
};

function openExportModal(state){
  const cfg=EXPORT_STATES[state];
  if(!cfg)return;
  document.getElementById('export-modal-title').textContent=cfg.title;
  document.getElementById('export-status-wrap').innerHTML=cfg.wrap;
  document.getElementById('export-modal-ft').innerHTML=cfg.ft;
  document.getElementById('export-modal').classList.add('open');
  // 模拟loading进度
  if(state==='loading'){
    let pct=62;
    const interval=setInterval(()=>{
      pct=Math.min(pct+Math.random()*4,100);
      const bar=document.getElementById('export-loading-bar');
      const label=document.getElementById('export-pct-label');
      if(bar)bar.style.width=pct+'%';
      if(label)label.textContent=Math.round(pct)+'%';
      if(pct>=100){
        clearInterval(interval);
        setTimeout(()=>{
          closeExportModal();
          openExportModal('success');
        },500);
      }
    },300);
  }
}
function closeExportModal(){document.getElementById('export-modal').classList.remove('open');}



// ── INIT ──
document.addEventListener('DOMContentLoaded',()=>{
  updateClock();
});


    // ── LOGIN ──
    function showLoginPage(){
      document.getElementById('login-overlay').style.display='flex';
      document.querySelector('.app').style.display='none';
    }
    function hideLoginPage(){
      document.getElementById('login-overlay').style.display='none';
      document.querySelector('.app').style.display='flex';
    }
    function doLogin(){
      const btn=document.getElementById('login-btn');
      const user=document.getElementById('login-user').value;
      const pass=document.getElementById('login-pass').value;
      const err=document.getElementById('login-error');
      err.classList.remove('show');
      document.getElementById('login-user').classList.remove('error');
      btn.textContent='登录中...';btn.classList.add('loading');
      setTimeout(()=>{
        btn.textContent='登 录';btn.classList.remove('loading');
        if(user&&pass){
          showToast('登录成功，欢迎回来 '+user,'success');
          setTimeout(()=>hideLoginPage(),800);
        }else{
          err.classList.add('show');
          document.getElementById('login-user').classList.add('error');
        }
      },1200);
    }
    function doLocalLogin(){
      showToast('本地模式启动中...','info');
      setTimeout(()=>hideLoginPage(),800);
    }
    function togglePwd(){
      const input=document.getElementById('login-pass');
      input.type=input.type==='password'?'text':'password';
    }

// ── PROJECT MANAGEMENT ──
function openNewProjectModal(){showToast('新建项目功能开发中','info');}
function filterProjects(value){
  const cards=document.querySelectorAll('.project-card');
  cards.forEach(card=>{
    const name=(card.dataset.projectName||card.querySelector('[data-project-name]')?.textContent||card.textContent||'').toLowerCase();
    card.style.display=(!value||name.includes(value.toLowerCase()))?'':'none';
  });
}
function toggleProjectMenu(btn){
  const menu=btn.nextElementSibling;
  if(!menu)return;
  const isOpen=menu.style.display==='block';
  document.querySelectorAll('.project-menu').forEach(m=>m.style.display='none');
  menu.style.display=isOpen?'none':'block';
  if(!isOpen){
    setTimeout(()=>document.addEventListener('click',function handler(){
      menu.style.display='none';
      document.removeEventListener('click',handler);
    }),0);
  }
}

// ── FILE UPLOAD (page-upload) ──
// 兼容两种调用方式：handleFileSelect(event) 和 handleFileSelect(fileList)
(function(){
  const _orig=window.handleFileSelect;
  window.handleFileSelect=function(input){
    let files;
    if(input instanceof FileList){files=Array.from(input);}
    else if(input&&input.target){files=Array.from(input.target.files||[]);}
    else if(input&&input.dataTransfer){files=Array.from(input.dataTransfer.files||[]);}
    else{files=[];}
    if(files.length===0)return;
    // 尝试新版上传列表（page-upload）
    const newList=document.getElementById('upload-file-list');
    if(newList&&document.getElementById('page-upload')?.classList.contains('active')){
      files.forEach(f=>addUploadFileItem(f,newList));
    } else {
      // 回退到旧版 import 列表
      files.forEach(f=>addFileToList(f));
    }
  };
})();

function addUploadFileItem(file,listEl){
  const type=getFileType(file.name);
  const id='uf-'+Date.now()+Math.random().toString(36).slice(2,7);
  const item=document.createElement('div');
  item.id=id;
  item.style.cssText='display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--surface1);border:1px solid var(--border);border-radius:10px;margin-bottom:8px;';
  item.innerHTML=`
    <div style="width:36px;height:36px;border-radius:8px;background:var(--a1-light,#e8f4f8);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--a1)" stroke-width="2">${getFileIcon(type)}</svg>
    </div>
    <div style="flex:1;min-width:0;">
      <div style="font-size:13px;font-weight:500;color:var(--text1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${file.name}</div>
      <div style="font-size:11px;color:var(--text3);margin-top:2px;">${formatSize(file.size)} · ${type==='audio'?'音频':type==='video'?'视频':type==='img'?'图片':'文档'}</div>
      <div style="height:4px;background:var(--surface3);border-radius:2px;margin-top:6px;overflow:hidden;">
        <div id="uprog-${id}" style="height:100%;width:0%;background:var(--a1);border-radius:2px;transition:width .3s;"></div>
      </div>
    </div>
    <span id="upct-${id}" style="font-size:11px;color:var(--text3);flex-shrink:0;">0%</span>
    <button onclick="document.getElementById('${id}').remove()" style="background:none;border:none;cursor:pointer;color:var(--text4);padding:4px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  `;
  listEl.appendChild(item);
  let pct=0;
  const iv=setInterval(()=>{
    pct=Math.min(pct+Math.random()*18,100);
    const bar=document.getElementById('uprog-'+id);
    const lbl=document.getElementById('upct-'+id);
    if(bar)bar.style.width=pct+'%';
    if(lbl)lbl.textContent=Math.round(pct)+'%';
    if(pct>=100){
      clearInterval(iv);
      if(bar)bar.style.background='var(--a2)';
      if(lbl){lbl.textContent='完成';lbl.style.color='var(--a2)';}
    }
  },180);
}

// ── PHOTOS ──
function openPhotoDetail(id){
  showToast('照片 #'+id+' 详情查看（功能开发中）','info');
}
function setPhotoView(view){
  const gridBtn=document.getElementById('view-grid-btn');
  const listBtn=document.getElementById('view-list-btn');
  const grid=document.getElementById('photos-grid');
  if(view==='grid'){
    if(gridBtn){gridBtn.style.background='var(--a1)';gridBtn.style.color='white';}
    if(listBtn){listBtn.style.background='transparent';listBtn.style.color='var(--text3)';}
    if(grid)grid.style.gridTemplateColumns='repeat(auto-fill,minmax(140px,1fr))';
  }else{
    if(listBtn){listBtn.style.background='var(--a1)';listBtn.style.color='white';}
    if(gridBtn){gridBtn.style.background='transparent';gridBtn.style.color='var(--text3)';}
    if(grid)grid.style.gridTemplateColumns='1fr';
  }
}
function filterPhotosByGroup(value){
  showToast(value?'筛选分组：'+value:'已显示全部照片','info');
}

// ── CITATIONS ──
function generateRefList(){
  const sel=document.getElementById('citation-format');
  const fmt=sel?sel.value:'gb7714';
  const label=document.getElementById('format-label');
  const fmtName=fmt==='gb7714'?'GB/T 7714':fmt==='apa'?'APA 7th':'MLA 9th';
  if(label)label.textContent=fmtName;
  showToast('参考文献列表已生成（'+fmtName+' 格式）','success');
}
function openAddCitationModal(){showToast('添加文献功能开发中','info');}
function copyCitation(id){
  const citations={
    1:'张明, 李华. 布依族传统文化的现代传承与保护研究[J]. 贵州民族研究, 2023, (4): 45-58.',
    2:'费孝通. 乡土中国[M]. 北京: 北京大学出版社, 2012.',
    3:'贵州省文化厅. 贵州省少数民族文化保护现状调查报告[R]. 2023.'
  };
  const text=citations[id]||'引用内容';
  if(navigator.clipboard){
    navigator.clipboard.writeText(text).then(()=>showToast('引用已复制到剪贴板','success')).catch(()=>showToast('引用已复制','success'));
  }else{showToast('引用已复制','success');}
}

// ── TABLES ──
function loadTablePreview(value){
  if(!value)return;
  const preview=document.getElementById('table-preview-area');
  if(preview){
    preview.innerHTML='<div style="padding:20px;text-align:center;color:var(--text3);font-size:13px;">正在加载表格：'+value+'...</div>';
    setTimeout(()=>{
      preview.innerHTML='<div style="padding:16px;font-size:12px;color:var(--text2);">已加载：<strong>'+value+'</strong>（示例数据）</div>';
    },600);
  }
  showToast('已加载表格：'+value,'info');
}
function runNLQuery(){
  const input=document.getElementById('nl-query-input');
  if(!input||!input.value.trim()){showToast('请输入查询内容','warn');return;}
  const q=input.value.trim();
  showToast('正在查询：'+q,'info');
  const result=document.getElementById('nl-query-result');
  if(result){
    result.style.display='block';
    result.innerHTML='<div style="padding:12px 16px;font-size:12px;color:var(--text2);">查询中：<em>'+q+'</em>…</div>';
    setTimeout(()=>{
      result.innerHTML='<div style="padding:12px 16px;font-size:12px;color:var(--text2);">✅ 查询完成，共找到 <strong>3</strong> 条匹配记录。</div>';
    },800);
  }
}
function setQuery(text){
  const input=document.getElementById('nl-query-input');
  if(input){input.value=text;input.focus();}
}

// ── SOP ──
function openNewSOPModal(){showToast('新建 SOP 功能开发中','info');}
function toggleSOPDetail(id){
  const detail=document.getElementById(id+'-detail');
  const arrow=document.getElementById(id+'-arrow');
  // 兼容直接传 id 或 id-detail
  const el=detail||document.getElementById(id);
  if(!el)return;
  const isOpen=el.style.display!=='none'&&el.style.display!=='';
  el.style.display=isOpen?'none':'block';
  if(arrow)arrow.style.transform=isOpen?'rotate(0deg)':'rotate(180deg)';
}

</script>
</div><!-- /page-content -->
</main>
</div><!-- /app -->
