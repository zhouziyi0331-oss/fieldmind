.kw-sub{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;}
.kw-sub-title{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;}
.tl-item{display:flex;gap:9px;padding:6px 0;border-bottom:1px solid var(--border);font-size:11px;}
.tl-item:last-child{border-bottom:none;}
.tl-date{color:var(--a1);font-weight:700;min-width:52px;flex-shrink:0;font-family:'JetBrains Mono',monospace;font-size:10px;}
.tl-text{color:var(--text2);line-height:1.5;}
.src-item{display:flex;align-items:flex-start;gap:7px;padding:6px 0;border-bottom:1px solid var(--border);font-size:11px;}
.src-item:last-child{border-bottom:none;}
.src-type{padding:1px 6px;border-radius:3px;font-size:9px;font-weight:700;flex-shrink:0;margin-top:1px;letter-spacing:.04em;text-transform:uppercase;}
.src-type.audio{background:var(--a1-dim2);color:var(--a1);}
.src-type.video{background:var(--a2-dim2);color:#6B7A1A;}
.src-type.note{background:var(--a5-dim2);color:#3A7A8C;}
.src-name{color:var(--text);font-weight:600;}
.src-loc{color:var(--text3);margin-top:1px;font-size:10px;font-family:'JetBrains Mono',monospace;}

/* ── BIZ CARDS ── */
.biz-card{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:13px;transition:all .2s;box-shadow:var(--shadow);cursor:pointer;}
.biz-card:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);transform:translateY(-2px);}
.biz-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;}
.biz-name{font-size:12px;font-weight:700;color:var(--text);}
.biz-score{font-size:20px;font-weight:900;color:var(--a1);letter-spacing:-.03em;font-variant-numeric:tabular-nums;}
.biz-score span{font-size:10px;font-weight:500;color:var(--text3);}
.biz-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:7px;}
.biz-tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;letter-spacing:.03em;}
.biz-tag.g{background:var(--a2-dim2);color:#6B7A1A;}
.biz-tag.b{background:var(--a1-dim2);color:var(--a1);}
.biz-tag.t{background:var(--a5-dim2);color:#3A7A8C;}
.biz-tag.s{background:var(--a3-dim2);color:#8A6A3A;}
.biz-desc{font-size:10px;color:var(--text3);line-height:1.6;margin-bottom:9px;}
.biz-bar-lbl{display:flex;justify-content:space-between;font-size:9px;color:var(--text3);margin-bottom:3px;}
.biz-bar-track{height:3px;background:var(--surface3);border-radius:2px;overflow:hidden;}
.biz-bar-fill{height:100%;border-radius:2px;transition:width .7s ease;}
.biz-expand-hint{font-size:9px;color:var(--a1);margin-top:7px;display:flex;align-items:center;gap:3px;opacity:.7;}

/* ── AI BOX ── */
.ai-box{background:linear-gradient(135deg,rgba(23,138,183,.05),rgba(159,172,36,.03));border:1px solid var(--border2);border-radius:9px;padding:14px 16px;position:relative;overflow:hidden;}
.ai-box::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--a1),var(--a2),transparent);}
.ai-box-hd{display:flex;align-items:center;gap:7px;margin-bottom:9px;}
.ai-badge{background:linear-gradient(90deg,var(--a1),var(--a5));color:#fff;font-size:9px;font-weight:700;padding:2px 8px;border-radius:3px;letter-spacing:.06em;}
.ai-box-title{font-size:12px;font-weight:700;color:var(--text);}
.ai-body{font-size:11px;color:var(--text2);line-height:1.75;}
.ai-body strong{color:var(--a1);}
.ai-evidence{margin-top:9px;padding-top:9px;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:4px;}
.ai-ev-label{font-size:9px;color:var(--text3);width:100%;margin-bottom:2px;}
.ev-pill{font-size:9px;font-weight:600;padding:2px 8px;border-radius:20px;background:var(--a1-dim2);color:var(--a1);border:1px solid var(--border2);font-family:'JetBrains Mono',monospace;}

/* ── FILE LIST ── */
.file-list{display:flex;flex-direction:column;gap:5px;}
.file-item{display:flex;align-items:center;gap:9px;padding:8px 11px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;transition:all .15s;}
.file-item:hover{border-color:var(--border2);background:var(--surface);}
.file-icon{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.file-icon svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;}
.file-icon.audio{background:var(--a1-dim2);color:var(--a1);}
.file-icon.video{background:var(--a2-dim2);color:#6B7A1A;}
.file-icon.doc{background:var(--a5-dim2);color:#3A7A8C;}
.file-icon.sheet{background:var(--a3-dim2);color:#8A6A3A;}
.file-info{flex:1;}
.file-name{font-size:11px;font-weight:600;color:var(--text);}
.file-meta{font-size:9px;color:var(--text3);margin-top:1px;font-family:'JetBrains Mono',monospace;}
.file-status{font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;letter-spacing:.03em;}
.file-status.done{background:var(--a2-dim2);color:#6B7A1A;}
.file-status.proc{background:var(--a1-dim2);color:var(--a1);}
.file-status.pend{background:var(--surface3);color:var(--text3);}

/* ── MODEL LAYERS ── */
.model-layer{border:1px solid var(--border);border-radius:9px;overflow:hidden;margin-bottom:9px;transition:border-color .2s;box-shadow:var(--shadow);}
.model-layer:hover{border-color:var(--border2);}
.model-layer-hd{display:flex;align-items:center;gap:9px;padding:11px 14px;cursor:pointer;background:var(--surface);transition:background .15s;}
.model-layer-hd:hover{background:var(--surface2);}
.ml-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ml-icon svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;}
.ml-icon.must{background:var(--a1-dim2);color:var(--a1);}
.ml-icon.verify{background:var(--a2-dim2);color:#6B7A1A;}
.ml-icon.opt{background:var(--a5-dim2);color:#3A7A8C;}
.ml-info{flex:1;}
.ml-name{font-size:12px;font-weight:700;color:var(--text);}
.ml-desc{font-size:10px;color:var(--text3);margin-top:1px;}
.ml-badge{font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;letter-spacing:.04em;}
.ml-badge.must{background:var(--a1-dim2);color:var(--a1);border:1px solid var(--border2);}
.ml-badge.verify{background:var(--a2-dim2);color:#6B7A1A;border:1px solid rgba(159,172,36,.3);}
.ml-badge.opt{background:var(--a5-dim2);color:#3A7A8C;border:1px solid rgba(111,167,182,.3);}
.ml-arrow{font-size:10px;color:var(--text3);transition:transform .2s;}
.model-layer.open .ml-arrow{transform:rotate(180deg);}
.model-layer-body{display:none;padding:0 14px 12px;background:var(--surface2);border-top:1px solid var(--border);}
.model-layer.open .model-layer-body{display:block;}
.ml-items{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;padding-top:10px;}
.ml-item{background:var(--surface);border:1px solid var(--border);border-radius:7px;padding:9px 11px;}
.ml-item-name{font-size:11px;font-weight:700;color:var(--text);margin-bottom:3px;}
.ml-item-desc{font-size:10px;color:var(--text3);line-height:1.5;}

/* ── SKILL CARDS ── */
.skill-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;transition:all .2s;cursor:pointer;position:relative;overflow:hidden;box-shadow:var(--shadow);}
.skill-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.skill-card.built::before{background:linear-gradient(90deg,var(--a1),var(--a5));}
.skill-card.opt::before{background:linear-gradient(90deg,var(--a2),#6B7A1A);}
.skill-card.add::before{background:linear-gradient(90deg,var(--a3),var(--a5));}
.skill-card:hover{box-shadow:var(--shadow-lg);transform:translateY(-2px);border-color:var(--border2);}
.skill-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
.skill-icon svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.6;}
.skill-icon.a1{background:var(--a1-dim2);color:var(--a1);}
.skill-icon.a2{background:var(--a2-dim2);color:#6B7A1A;}
.skill-icon.a5{background:var(--a5-dim2);color:#3A7A8C;}
.skill-name{font-size:12px;font-weight:700;color:var(--text);margin-bottom:5px;}
.skill-desc{font-size:10px;color:var(--text3);line-height:1.6;margin-bottom:9px;}
.skill-tags{display:flex;flex-wrap:wrap;gap:4px;}
.skill-tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;letter-spacing:.03em;}
.skill-tag.a1{background:var(--a1-dim);color:var(--a1);}
.skill-tag.a2{background:var(--a2-dim);color:#6B7A1A;}
.skill-tag.a5{background:var(--a5-dim);color:#3A7A8C;}
.skill-status{position:absolute;top:12px;right:12px;font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;cursor:pointer;transition:all .2s;}
.skill-status.on{background:var(--a2-dim2);color:#6B7A1A;border:1px solid rgba(159,172,36,.3);}
.skill-status.on:hover{background:var(--red-dim);color:var(--red);border-color:rgba(192,57,43,.3);}
.skill-status.off{background:var(--surface3);color:var(--text3);border:1px solid var(--border);}
.skill-status.off:hover{background:var(--a2-dim2);color:#6B7A1A;border-color:rgba(159,172,36,.3);}

/* ── UPLOAD ZONE ── */
.upload-zone{border:2px dashed var(--border2);border-radius:10px;padding:32px 24px;text-align:center;background:var(--surface2);transition:all .2s;cursor:pointer;position:relative;}
.upload-zone:hover,.upload-zone.drag-over{border-color:var(--a1);background:var(--a1-dim);border-style:solid;}
.upload-zone.uploading{border-color:var(--a2);background:rgba(159,172,36,.05);}
.upload-icon{width:44px;height:44px;border-radius:10px;background:var(--a1-dim2);color:var(--a1);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;box-shadow:var(--glow-a1);}
.upload-icon svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.6;}
.upload-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:4px;}
.upload-sub{font-size:10px;color:var(--text3);}
.upload-types{display:flex;justify-content:center;gap:5px;margin-top:12px;flex-wrap:wrap;}
.upload-type{font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;background:var(--surface3);border:1px solid var(--border);color:var(--text3);font-family:'JetBrains Mono',monospace;}
.upload-progress{margin-top:14px;display:none;}
.upload-progress.show{display:block;}
.upload-prog-bar{height:4px;background:var(--surface3);border-radius:2px;overflow:hidden;margin-top:6px;}
.upload-prog-fill{height:100%;background:linear-gradient(90deg,var(--a1),var(--a2));border-radius:2px;transition:width .3s ease;width:0%;}
.upload-prog-label{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;}

/* ── HERO ── */
.hero{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 60%,rgba(23,138,183,.05) 100%);border:1px solid var(--border2);padding:28px 24px;border-radius:12px;margin-bottom:20px;position:relative;overflow:hidden;box-shadow:var(--shadow-lg);}
.hero::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--a1),var(--a2),transparent);}
.hero::after{content:'';position:absolute;top:-60px;right:-40px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(23,138,183,.05),transparent 70%);pointer-events:none;}
.hero-eyebrow{font-size:9px;font-weight:700;color:var(--a1);letter-spacing:.12em;text-transform:uppercase;margin-bottom:7px;display:flex;align-items:center;gap:6px;}
.hero-eyebrow::before{content:'';width:16px;height:1px;background:var(--a1);}
.hero-title{font-size:22px;font-weight:900;color:var(--text);letter-spacing:-.02em;line-height:1.2;margin-bottom:6px;}
.hero-sub{font-size:11px;color:var(--text3);max-width:460px;line-height:1.65;}
.hero-stats{display:flex;gap:24px;margin-top:18px;padding-top:16px;border-top:1px solid var(--border);}
.hero-stat-val{font-size:20px;font-weight:900;color:var(--text);letter-spacing:-.03em;font-variant-numeric:tabular-nums;}
.hero-stat-label{font-size:9px;color:var(--text3);margin-top:1px;letter-spacing:.04em;}

/* ── STEPS ── */
.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;position:relative;}
.steps::before{content:'';position:absolute;top:24px;left:10%;right:10%;height:1px;background:linear-gradient(90deg,var(--a1),var(--a2));z-index:0;opacity:.3;}
.step{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 5px;position:relative;z-index:1;}
.step-num{width:48px;height:48px;border-radius:50%;background:var(--surface);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;margin-bottom:9px;transition:all .2s;box-shadow:var(--shadow);}
.step-num svg{width:18px;height:18px;stroke:var(--a1);fill:none;stroke-width:1.6;}
.step:hover .step-num{border-color:var(--a1);background:var(--a1-dim);box-shadow:var(--glow-a1);transform:scale(1.06);}
.step-title{font-size:10px;font-weight:700;color:var(--text);margin-bottom:2px;}
.step-desc{font-size:9px;color:var(--text3);line-height:1.5;}

/* ── VERIFY BLOCKS ── */
.verify-block{padding:9px 11px;border-radius:7px;margin-bottom:7px;}
.verify-block:last-child{margin-bottom:0;}
.verify-block.ok{background:rgba(159,172,36,.07);border-left:2px solid var(--a2);}
.verify-block.pending{background:var(--a1-dim);border-left:2px solid var(--a1);}
.verify-block.fail{background:var(--red-dim);border-left:2px solid var(--red);}
.verify-block-title{font-size:9px;font-weight:700;margin-bottom:3px;letter-spacing:.04em;}
.verify-block.ok .verify-block-title{color:#6B7A1A;}
.verify-block.pending .verify-block-title{color:var(--a1);}
.verify-block.fail .verify-block-title{color:var(--red);}
.verify-block-body{font-size:10px;color:var(--text2);line-height:1.6;}

/* ── LEGEND ── */
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;}
.legend-item{display:flex;align-items:center;gap:4px;font-size:10px;color:var(--text3);}
.legend-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;}
.legend-line{width:12px;height:2px;border-radius:1px;flex-shrink:0;}

/* ── DATA TICKER ── */
.data-ticker{display:flex;align-items:center;gap:16px;padding:7px 16px;background:var(--surface);border-bottom:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:10px;overflow:hidden;box-shadow:0 1px 4px rgba(23,138,183,.05);}
.ticker-item{display:flex;align-items:center;gap:5px;white-space:nowrap;color:var(--text3);}
.ticker-item .val{color:var(--a1);font-weight:700;}
.ticker-item .up{color:var(--a2);}
.ticker-sep{color:var(--text4);}
.rt-indicator{display:flex;align-items:center;gap:5px;font-size:9px;font-weight:700;color:#6B7A1A;letter-spacing:.06em;text-transform:uppercase;}
.rt-dot{width:5px;height:5px;border-radius:50%;background:var(--a2);animation:livePulse 1.5s ease-in-out infinite;box-shadow:0 0 5px var(--a2);}

/* ── TABLE ── */
.table-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
th{font-size:9px;font-weight:700;color:var(--text3);text-align:left;padding:6px 10px;border-bottom:1px solid var(--border2);white-space:nowrap;letter-spacing:.06em;text-transform:uppercase;}
td{font-size:11px;color:var(--text2);padding:8px 10px;border-bottom:1px solid var(--border);}
tr:last-child td{border-bottom:none;}
tr:hover td{background:var(--surface2);}

/* ── TAGS ── */
.tag-sand{background:var(--a3-dim2);color:#8A6A3A;border:1px solid rgba(217,188,146,.4);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}
.tag-sky{background:var(--a5-dim2);color:#3A7A8C;border:1px solid rgba(111,167,182,.3);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}
.tag-green{background:var(--a2-dim2);color:#6B7A1A;border:1px solid rgba(159,172,36,.3);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}
.tag-blue{background:var(--a1-dim2);color:var(--a1);border:1px solid rgba(23,138,183,.25);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}

/* ── SCAN LINE ── */
@keyframes scanLine{0%{transform:translateY(-100%);}100%{transform:translateY(100vh);}}
.scan-overlay{position:fixed;top:0;left:210px;right:0;bottom:0;pointer-events:none;z-index:998;overflow:hidden;}
.scan-line{position:absolute;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(23,138,183,.04),transparent);animation:scanLine 10s linear infinite;}

/* ══════════════════════════════════════
   TIMELINE PAGE
══════════════════════════════════════ */
.timeline-wrap{position:relative;padding-left:28px;}
.timeline-wrap::before{content:'';position:absolute;left:10px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--a1),var(--a2),var(--a5));opacity:.3;border-radius:1px;}
.tl-group{margin-bottom:28px;}
.tl-group-label{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.tl-group-label::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--a1);flex-shrink:0;margin-left:-24px;box-shadow:0 0 8px var(--a1);}
.tl-entry{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:13px 15px;margin-bottom:8px;transition:all .2s;box-shadow:var(--shadow);position:relative;}
.tl-entry:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);}
.tl-entry::before{content:'';position:absolute;left:-22px;top:18px;width:8px;height:8px;border-radius:50%;background:var(--surface);border:2px solid var(--a1);}
.tl-entry.audio::before{border-color:var(--a1);}
.tl-entry.video::before{border-color:var(--a2);}
.tl-entry.doc::before{border-color:var(--a5);}
.tl-entry.event::before{border-color:var(--a3);background:var(--a3);}
.tl-entry-hd{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
.tl-entry-date{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--a1);}
.tl-entry-type{font-size:9px;font-weight:700;padding:1px 6px;border-radius:3px;letter-spacing:.04em;text-transform:uppercase;}
.tl-entry-type.audio{background:var(--a1-dim2);color:var(--a1);}
.tl-entry-type.video{background:var(--a2-dim2);color:#6B7A1A;}
.tl-entry-type.doc{background:var(--a5-dim2);color:#3A7A8C;}
.tl-entry-type.event{background:var(--a3-dim2);color:#8A6A3A;}
.tl-entry-title{font-size:12px;font-weight:700;color:var(--text);flex:1;}
.tl-entry-body{font-size:11px;color:var(--text2);line-height:1.65;}
.tl-entry-kws{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;}
.tl-kw{font-size:9px;font-weight:600;padding:2px 7px;border-radius:20px;background:var(--a1-dim);color:var(--a1);border:1px solid var(--border2);}
.tl-kw.g{background:var(--a2-dim);color:#6B7A1A;border-color:rgba(159,172,36,.2);}
.tl-kw.s{background:var(--a5-dim);color:#3A7A8C;border-color:rgba(111,167,182,.2);}

/* ══════════════════════════════════════
   REPORT PAGE
══════════════════════════════════════ */
.report-wrap{max-width:860px;}
.report-cover{background:linear-gradient(135deg,var(--a1) 0%,var(--sb-bg2) 100%);border-radius:12px;padding:36px 40px;margin-bottom:24px;color:#fff;position:relative;overflow:hidden;}
.report-cover::after{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.06);pointer-events:none;}
.report-cover-eyebrow{font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin-bottom:10px;}
.report-cover-title{font-size:26px;font-weight:900;letter-spacing:-.02em;line-height:1.2;margin-bottom:8px;}
.report-cover-sub{font-size:12px;opacity:.8;line-height:1.6;max-width:480px;}
.report-cover-meta{display:flex;gap:20px;margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,.2);}
.report-cover-meta-item{font-size:10px;opacity:.75;}
.report-cover-meta-item strong{display:block;font-size:14px;font-weight:800;opacity:1;margin-bottom:1px;}
.report-section{margin-bottom:24px;}
.report-section-title{font-size:13px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:8px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border2);}
.report-section-num{width:20px;height:20px;border-radius:5px;background:var(--a1);color:#fff;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.report-section-num.g{background:var(--a2);}
.report-section-num.s{background:var(--a5);}
.report-section-num.d{background:var(--a3);color:var(--a4);}
.report-p{font-size:11px;color:var(--text2);line-height:1.8;margin-bottom:10px;}
.report-p strong{color:var(--text);font-weight:700;}
.report-highlight{background:linear-gradient(135deg,rgba(23,138,183,.06),rgba(159,172,36,.04));border:1px solid var(--border2);border-radius:8px;padding:12px 16px;margin-bottom:12px;position:relative;}
.report-highlight::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--a1);border-radius:3px 0 0 3px;}
.report-highlight.green::before{background:var(--a2);}
.report-highlight.sand::before{background:var(--a3);}
.report-highlight.sky::before{background:var(--a5);}
.report-highlight-title{font-size:10px;font-weight:700;color:var(--a1);margin-bottom:5px;letter-spacing:.04em;}
.report-highlight.green .report-highlight-title{color:#6B7A1A;}
.report-highlight.sand .report-highlight-title{color:#8A6A3A;}
.report-highlight.sky .report-highlight-title{color:#3A7A8C;}
.report-highlight-body{font-size:11px;color:var(--text2);line-height:1.7;}
.report-table{width:100%;border-collapse:collapse;margin-bottom:12px;font-size:11px;}
.report-table th{background:var(--surface2);font-size:9px;font-weight:700;color:var(--text3);padding:7px 10px;text-align:left;border-bottom:1px solid var(--border2);letter-spacing:.06em;text-transform:uppercase;}
.report-table td{padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text2);}
.report-table tr:last-child td{border-bottom:none;}
.report-table tr:hover td{background:var(--surface2);}
.report-actions{display:flex;gap:8px;margin-bottom:20px;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:9px;align-items:center;}
.report-actions-label{font-size:11px;font-weight:600;color:var(--text2);flex:1;}

/* ══════════════════════════════════════
   BIZ DETAIL DRAWER
══════════════════════════════════════ */
.drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:200;display:none;backdrop-filter:blur(2px);}
.drawer-overlay.open{display:block;}
.drawer{position:fixed;right:0;top:0;bottom:0;width:520px;background:var(--surface);z-index:201;display:flex;flex-direction:column;box-shadow:-8px 0 40px rgba(23,138,183,.15);transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);}
.drawer.open{transform:translateX(0);}
.drawer-hd{padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;gap:12px;}
.drawer-close{width:28px;height:28px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all .15s;margin-left:auto;}
.drawer-close:hover{background:var(--red-dim);border-color:rgba(192,57,43,.3);}
.drawer-close svg{width:12px;height:12px;stroke:var(--text3);fill:none;stroke-width:2;}
.drawer-body{flex:1;overflow-y:auto;padding:20px 24px;}
.drawer-title{font-size:18px;font-weight:900;color:var(--text);letter-spacing:-.02em;}
.drawer-sub{font-size:11px;color:var(--text3);margin-top:3px;}
.drawer-score-big{font-size:48px;font-weight:900;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums;}
.drawer-section{margin-bottom:20px;}
.drawer-section-title{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.drawer-section-title::before{content:'';width:12px;height:2px;background:var(--a1);border-radius:1px;}
.dim-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.dim-label{font-size:11px;color:var(--text2);width:80px;flex-shrink:0;}
.dim-track{flex:1;height:6px;background:var(--surface3);border-radius:3px;overflow:hidden;}
.dim-fill{height:100%;border-radius:3px;transition:width .8s ease;}
.dim-val{font-size:11px;font-weight:700;color:var(--text);width:32px;text-align:right;font-family:'JetBrains Mono',monospace;}
.action-step{display:flex;gap:10px;padding:10px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;margin-bottom:7px;}
.action-step-num{width:20px;height:20px;border-radius:50%;background:var(--a1);color:#fff;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.action-step-body{flex:1;}
.action-step-title{font-size:11px;font-weight:700;color:var(--text);margin-bottom:2px;}
.action-step-desc{font-size:10px;color:var(--text3);line-height:1.5;}
.risk-item{display:flex;gap:8px;padding:8px 10px;border-radius:6px;margin-bottom:6px;}
.risk-item.high{background:var(--red-dim);border-left:2px solid var(--red);}
.risk-item.mid{background:rgba(184,134,11,.08);border-left:2px solid #B8860B;}
.risk-item.low{background:var(--a2-dim);border-left:2px solid var(--a2);}
.risk-label{font-size:9px;font-weight:700;padding:1px 5px;border-radius:3px;flex-shrink:0;margin-top:1px;}
.risk-item.high .risk-label{background:var(--red-dim);color:var(--red);}
.risk-item.mid .risk-label{background:rgba(184,134,11,.12);color:#B8860B;}
.risk-item.low .risk-label{background:var(--a2-dim2);color:#6B7A1A;}
.risk-text{font-size:10px;color:var(--text2);line-height:1.5;}

/* ══════════════════════════════════════
   SKILL MODAL
══════════════════════════════════════ */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;display:none;align-items:center;justify-content:center;backdrop-filter:blur(3px);}
.modal-overlay.open{display:flex;}
.modal{background:var(--surface);border-radius:14px;width:520px;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(23,138,183,.2);border:1px solid var(--border2);animation:modalIn .25s cubic-bezier(.4,0,.2,1);}
@keyframes modalIn{from{opacity:0;transform:scale(.95) translateY(10px);}to{opacity:1;transform:scale(1) translateY(0);}}
.modal-hd{padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;}
.modal-title{font-size:14px;font-weight:800;color:var(--text);flex:1;}
.modal-close{width:28px;height:28px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;}
.modal-close:hover{background:var(--red-dim);}
.modal-close svg{width:12px;height:12px;stroke:var(--text3);fill:none;stroke-width:2;}
.modal-body{padding:20px 24px;overflow-y:auto;flex:1;}
.modal-ft{padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;}
.form-group{margin-bottom:14px;}
.form-label{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;display:block;}
.form-input{width:100%;padding:8px 11px;border:1px solid var(--border2);border-radius:6px;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text);background:var(--surface);transition:border-color .15s;outline:none;}
.form-input:focus{border-color:var(--a1);box-shadow:0 0 0 3px var(--a1-dim);}
.form-textarea{width:100%;padding:8px 11px;border:1px solid var(--border2);border-radius:6px;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text);background:var(--surface);resize:vertical;min-height:80px;outline:none;transition:border-color .15s;}
.form-textarea:focus{border-color:var(--a1);box-shadow:0 0 0 3px var(--a1-dim);}
.form-select{width:100%;padding:8px 11px;border:1px solid var(--border2);border-radius:6px;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text);background:var(--surface);outline:none;cursor:pointer;}
.form-select:focus{border-color:var(--a1);}
.upload-skill-zone{border:1px dashed var(--border2);border-radius:8px;padding:20px;text-align:center;background:var(--surface2);cursor:pointer;transition:all .2s;margin-top:6px;}
.upload-skill-zone:hover{border-color:var(--a1);background:var(--a1-dim);}
.upload-skill-zone p{font-size:11px;color:var(--text3);margin-top:6px;}

/* ── ANIMATIONS ── */
@keyframes countUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
.count-anim{animation:countUp .5s ease forwards;}

    /* ═══════════════════════════════════════
       NEW PAGES: 知识脉络 / 编年史 / 三层报告 / AI对话
    ═══════════════════════════════════════ */
    /* ═══════════════════════════════════════
   PAGE: 知识脉络
═══════════════════════════════════════ */

/* 脉络树容器 */
.vein-layout{display:grid;grid-template-columns:280px 1fr;gap:0;height:calc(100vh - 130px);overflow:hidden;}

/* 左侧大脉络列表 */
.vein-sidebar{border-right:1px solid var(--border);overflow-y:auto;background:var(--surface);}
.vein-sidebar-hd{padding:14px 16px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.vein-sidebar-title{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;}
.vein-count{font-size:10px;font-family:'JetBrains Mono',monospace;color:var(--a1);font-weight:700;}

.vein-main-item{padding:12px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:all .15s;position:relative;}
.vein-main-item:hover{background:var(--surface2);}
.vein-main-item.active{background:var(--a1-dim);border-left:3px solid var(--a1);}
.vein-main-item.active .vein-main-name{color:var(--a1);}
.vein-main-name{font-size:12px;font-weight:700;color:var(--text);margin-bottom:4px;display:flex;align-items:center;gap:6px;}
.vein-main-kw-count{font-size:9px;font-family:'JetBrains Mono',monospace;color:var(--text4);margin-left:auto;}
.vein-main-desc{font-size:10px;color:var(--text3);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.vein-main-tags{display:flex;flex-wrap:wrap;gap:3px;margin-top:6px;}

/* 右侧子脉络详情 */
.vein-detail{overflow-y:auto;padding:20px 24px;background:var(--bg);}
.vein-detail-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--text4);gap:10px;}
.vein-detail-empty svg{width:40px;height:40px;stroke:var(--text4);fill:none;stroke-width:1.2;opacity:.4;}

/* 大脉络标题区 */
.vein-hero{background:linear-gradient(135deg,var(--surface),rgba(23,138,183,.04));border:1px solid var(--border2);border-radius:12px;padding:20px 24px;margin-bottom:18px;position:relative;overflow:hidden;}
.vein-hero::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--a1),var(--a2),transparent);}
.vein-hero-eyebrow{font-size:9px;font-weight:700;color:var(--a1);letter-spacing:.12em;text-transform:uppercase;margin-bottom:6px;}
.vein-hero-title{font-size:18px;font-weight:900;color:var(--text);letter-spacing:-.02em;margin-bottom:6px;}
.vein-hero-desc{font-size:11px;color:var(--text2);line-height:1.7;max-width:600px;}
.vein-hero-meta{display:flex;gap:16px;margin-top:14px;padding-top:12px;border-top:1px solid var(--border);}
.vein-hero-stat{font-size:10px;color:var(--text3);}
.vein-hero-stat strong{display:block;font-size:16px;font-weight:900;color:var(--text);letter-spacing:-.02em;}

/* 子脉络卡片 */
.sub-vein-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px;}
.sub-vein-card{background:var(--surface);border:1px solid var(--border);border-radius:9px;overflow:hidden;transition:all .2s;box-shadow:var(--shadow);cursor:pointer;}
.sub-vein-card:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);transform:translateY(-1px);}
.sub-vein-card.expanded{border-color:var(--a1);box-shadow:0 0 0 2px var(--a1-dim);}
.sub-vein-hd{padding:12px 14px;display:flex;align-items:flex-start;gap:10px;}
.sub-vein-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.sub-vein-icon svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.8;}
.sub-vein-icon.a1{background:var(--a1-dim2);color:var(--a1);}
.sub-vein-icon.a2{background:var(--a2-dim2);color:#6B7A1A;}
.sub-vein-icon.a5{background:var(--a5-dim2);color:#3A7A8C;}
.sub-vein-icon.a3{background:var(--a3-dim2);color:#8A6A3A;}
.sub-vein-info{flex:1;}
.sub-vein-name{font-size:12px;font-weight:700;color:var(--text);margin-bottom:3px;}
.sub-vein-kws{display:flex;flex-wrap:wrap;gap:3px;margin-bottom:5px;}
.sub-vein-kw{font-size:9px;font-weight:600;padding:1px 6px;border-radius:20px;background:var(--a1-dim);color:var(--a1);border:1px solid var(--border2);}
.sub-vein-kw.g{background:var(--a2-dim);color:#6B7A1A;border-color:rgba(159,172,36,.2);}
.sub-vein-kw.s{background:var(--a5-dim);color:#3A7A8C;border-color:rgba(111,167,182,.2);}
.sub-vein-desc{font-size:10px;color:var(--text3);line-height:1.6;}
.sub-vein-expand{display:none;padding:0 14px 14px;border-top:1px solid var(--border);background:var(--surface2);}
.sub-vein-card.expanded .sub-vein-expand{display:block;}
.sub-vein-expand-body{padding-top:12px;font-size:11px;color:var(--text2);line-height:1.75;}
.sub-vein-expand-body strong{color:var(--a1);}

/* 关联报告区 */
.vein-reports{margin-top:14px;}
.vein-reports-title{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.vein-reports-title::before{content:'';width:12px;height:2px;background:var(--a1);border-radius:1px;}
.vein-report-links{display:flex;flex-wrap:wrap;gap:6px;}
.vein-report-link{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;border-radius:6px;font-size:10px;font-weight:600;cursor:pointer;transition:all .15s;border:1px solid var(--border2);background:var(--surface);}
.vein-report-link:hover{border-color:var(--a1);background:var(--a1-dim);color:var(--a1);}
.vein-report-link svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2;}
.vein-report-link.r1{color:var(--a1);}
.vein-report-link.r2{color:#6B7A1A;}
.vein-report-link.r3{color:#8A6A3A;}

/* 材料溯源 */
.vein-sources{margin-top:14px;}
.vein-source-item{display:flex;align-items:center;gap:8px;padding:7px 10px;background:var(--surface);border:1px solid var(--border);border-radius:6px;margin-bottom:5px;font-size:10px;}
.vein-source-type{font-size:8px;font-weight:700;padding:1px 5px;border-radius:3px;letter-spacing:.04em;text-transform:uppercase;flex-shrink:0;}
.vein-source-type.audio{background:var(--a1-dim2);color:var(--a1);}
.vein-source-type.video{background:var(--a2-dim2);color:#6B7A1A;}
.vein-source-type.doc{background:var(--a5-dim2);color:#3A7A8C;}
.vein-source-name{font-weight:600;color:var(--text);flex:1;}
.vein-source-loc{font-family:'JetBrains Mono',monospace;color:var(--text4);font-size:9px;}

/* ═══════════════════════════════════════
   PAGE: 编年史（增强版）
═══════════════════════════════════════ */
.chronicle-layout{display:grid;grid-template-columns:200px 1fr;gap:0;min-height:calc(100vh - 130px);}
.chronicle-nav{border-right:1px solid var(--border);background:var(--surface);padding:16px 0;}
.chronicle-nav-title{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;padding:0 16px 8px;}
.chronicle-year-btn{display:flex;align-items:center;gap:8px;padding:8px 16px;font-size:12px;font-weight:600;color:var(--text3);cursor:pointer;transition:all .15s;border:none;background:none;width:100%;text-align:left;font-family:'Inter Tight',sans-serif;position:relative;}
.chronicle-year-btn:hover{background:var(--surface2);color:var(--text);}
.chronicle-year-btn.active{color:var(--a1);background:var(--a1-dim);}
.chronicle-year-btn.active::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:16px;background:var(--a1);border-radius:0 2px 2px 0;}
.chronicle-year-count{margin-left:auto;font-size:9px;font-family:'JetBrains Mono',monospace;background:var(--surface3);padding:1px 5px;border-radius:3px;}
.chronicle-year-btn.active .chronicle-year-count{background:var(--a1-dim2);color:var(--a1);}

.chronicle-main{padding:20px 24px;overflow-y:auto;}
.chronicle-year-section{margin-bottom:32px;}
.chronicle-year-hd{display:flex;align-items:center;gap:12px;margin-bottom:16px;padding-bottom:10px;border-bottom:2px solid var(--border2);}
.chronicle-year-num{font-size:28px;font-weight:900;color:var(--a1);letter-spacing:-.04em;font-variant-numeric:tabular-nums;}
.chronicle-year-label{font-size:11px;color:var(--text3);font-weight:500;}
.chronicle-year-stats{display:flex;gap:10px;margin-left:auto;}
.chronicle-year-stat{font-size:9px;font-family:'JetBrains Mono',monospace;color:var(--text4);background:var(--surface2);padding:2px 7px;border-radius:3px;border:1px solid var(--border);}

/* 时间线条目 */
.chronicle-timeline{position:relative;padding-left:32px;}
.chronicle-timeline::before{content:'';position:absolute;left:12px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--a1),var(--a2),var(--a5));opacity:.25;border-radius:1px;}
.chronicle-entry{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:14px 16px;margin-bottom:10px;transition:all .2s;box-shadow:var(--shadow);position:relative;}
.chronicle-entry:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);}
.chronicle-entry::before{content:'';position:absolute;left:-24px;top:18px;width:10px;height:10px;border-radius:50%;background:var(--surface);border:2px solid var(--a1);}
.chronicle-entry.audio::before{border-color:var(--a1);background:var(--a1);}
.chronicle-entry.video::before{border-color:var(--a2);background:var(--a2);}
.chronicle-entry.doc::before{border-color:var(--a5);background:var(--a5);}
.chronicle-entry.event::before{border-color:var(--a3);background:var(--a3);}
.chronicle-entry.milestone::before{border-color:var(--a4);background:var(--a4);width:14px;height:14px;left:-26px;top:16px;}
.chronicle-entry-hd{display:flex;align-items:center;gap:8px;margin-bottom:7px;flex-wrap:wrap;}
.chronicle-entry-date{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--a1);}
.chronicle-entry-type{font-size:8px;font-weight:700;padding:1px 6px;border-radius:3px;letter-spacing:.04em;text-transform:uppercase;}
.chronicle-entry-type.audio{background:var(--a1-dim2);color:var(--a1);}
.chronicle-entry-type.video{background:var(--a2-dim2);color:#6B7A1A;}
.chronicle-entry-type.doc{background:var(--a5-dim2);color:#3A7A8C;}
.chronicle-entry-type.event{background:var(--a3-dim2);color:#8A6A3A;}
.chronicle-entry-type.milestone{background:rgba(69,72,29,.12);color:var(--a4);}
.chronicle-entry-title{font-size:12px;font-weight:700;color:var(--text);flex:1;}
.chronicle-entry-status{margin-left:auto;}
.chronicle-entry-body{font-size:11px;color:var(--text2);line-height:1.7;margin-bottom:8px;}
.chronicle-entry-kws{display:flex;flex-wrap:wrap;gap:4px;}
.chronicle-entry-kw{font-size:9px;font-weight:600;padding:2px 7px;border-radius:20px;background:var(--a1-dim);color:var(--a1);border:1px solid var(--border2);}
.chronicle-entry-kw.g{background:var(--a2-dim);color:#6B7A1A;border-color:rgba(159,172,36,.2);}
.chronicle-entry-kw.s{background:var(--a5-dim);color:#3A7A8C;border-color:rgba(111,167,182,.2);}
.chronicle-entry-kw.d{background:var(--a3-dim);color:#8A6A3A;border-color:rgba(217,188,146,.2);}

/* 编年史筛选栏 */
.chronicle-filter{display:flex;align-items:center;gap:8px;padding:12px 0;margin-bottom:16px;border-bottom:1px solid var(--border);}
.chronicle-filter-label{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.06em;text-transform:uppercase;}
.filter-chip{padding:3px 10px;border-radius:20px;font-size:10px;font-weight:600;cursor:pointer;transition:all .15s;border:1px solid var(--border);background:var(--surface);color:var(--text3);}
.filter-chip:hover{border-color:var(--border2);color:var(--text);}
.filter-chip.active{background:var(--a1);color:#fff;border-color:var(--a1);}
.filter-chip.audio.active{background:var(--a1);}
.filter-chip.video.active{background:var(--a2);color:#fff;}
.filter-chip.doc.active{background:var(--a5);color:#fff;}
.filter-chip.event.active{background:var(--a3);color:var(--a4);}

/* ═══════════════════════════════════════
   PAGE: 三层报告
═══════════════════════════════════════ */
.report3-layout{display:grid;grid-template-columns:220px 1fr;gap:0;min-height:calc(100vh - 130px);}
.report3-nav{border-right:1px solid var(--border);background:var(--surface);padding:16px 0;overflow-y:auto;}
.report3-nav-section{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;padding:10px 16px 5px;}
.report3-nav-item{display:flex;align-items:center;gap:8px;padding:9px 16px;cursor:pointer;transition:all .15s;border:none;background:none;width:100%;text-align:left;font-family:'Inter Tight',sans-serif;position:relative;}
.report3-nav-item:hover{background:var(--surface2);}
.report3-nav-item.active{background:var(--a1-dim);border-left:3px solid var(--a1);}
.report3-nav-item.active .r3-nav-name{color:var(--a1);}
.r3-nav-badge{width:18px;height:18px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;flex-shrink:0;}
.r3-nav-badge.l1{background:var(--a1-dim2);color:var(--a1);}
.r3-nav-badge.l2{background:var(--a2-dim2);color:#6B7A1A;}
.r3-nav-badge.l3{background:var(--a3-dim2);color:#8A6A3A;}
.r3-nav-name{font-size:11px;font-weight:600;color:var(--text2);}
.r3-nav-sub{font-size:9px;color:var(--text4);margin-top:1px;}
.r3-nav-status{margin-left:auto;font-size:8px;font-weight:700;padding:1px 5px;border-radius:3px;}
.r3-nav-status.ready{background:var(--a2-dim2);color:#6B7A1A;}
.r3-nav-status.pending{background:var(--surface3);color:var(--text4);}
.r3-nav-divider{height:1px;background:var(--border);margin:8px 16px;}

.report3-main{overflow-y:auto;background:var(--bg);}

/* 报告内容区 */
.report3-content{display:none;padding:24px 28px;}
.report3-content.active{display:block;}

/* 报告顶部操作栏 */
.report3-toolbar{display:flex;align-items:center;gap:8px;padding:12px 16px;background:var(--surface);border:1px solid var(--border);border-radius:9px;margin-bottom:20px;}
.report3-toolbar-info{flex:1;}
.report3-toolbar-title{font-size:12px;font-weight:700;color:var(--text);}
.report3-toolbar-meta{font-size:10px;color:var(--text3);margin-top:1px;}

/* 报告封面 */
.report3-cover{border-radius:12px;padding:32px 36px;margin-bottom:24px;color:#fff;position:relative;overflow:hidden;}
.report3-cover.l1{background:linear-gradient(135deg,var(--a1) 0%,var(--sb-bg2) 100%);}
.report3-cover.l2{background:linear-gradient(135deg,#6B7A1A 0%,#9FAC24 100%);}
.report3-cover.l3{background:linear-gradient(135deg,#8A6A3A 0%,#D9BC92 100%);}
.report3-cover::after{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.06);pointer-events:none;}
.report3-cover-layer{font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin-bottom:8px;display:flex;align-items:center;gap:8px;}
.report3-cover-layer-badge{background:rgba(255,255,255,.2);padding:2px 8px;border-radius:3px;}
.report3-cover-title{font-size:22px;font-weight:900;letter-spacing:-.02em;line-height:1.2;margin-bottom:8px;}
.report3-cover-desc{font-size:11px;opacity:.8;line-height:1.65;max-width:500px;}
.report3-cover-meta{display:flex;gap:20px;margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,.2);}
.report3-cover-meta-item{font-size:10px;opacity:.75;}
.report3-cover-meta-item strong{display:block;font-size:13px;font-weight:800;opacity:1;margin-bottom:1px;}

/* Skill选择器（二度/三度报告） */
.skill-selector{background:var(--surface);border:1px solid var(--border2);border-radius:9px;padding:14px 16px;margin-bottom:20px;}
.skill-selector-title{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.skill-selector-title::before{content:'';width:12px;height:2px;background:var(--a2);border-radius:1px;}
.skill-chips{display:flex;flex-wrap:wrap;gap:6px;}
.skill-chip{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;border-radius:6px;font-size:10px;font-weight:600;cursor:pointer;transition:all .15s;border:1px solid var(--border);background:var(--surface2);color:var(--text3);}
.skill-chip:hover{border-color:var(--border2);color:var(--text);}
.skill-chip.active{background:var(--a2-dim2);color:#6B7A1A;border-color:rgba(159,172,36,.4);}
.skill-chip svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2;}
.skill-chip-dot{width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0;}

/* 报告正文 */
.report3-body{max-width:820px;}
.report3-section{margin-bottom:24px;}
.report3-section-title{font-size:13px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:8px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border2);}
.report3-section-num{width:22px;height:22px;border-radius:5px;color:#fff;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.report3-section-num.l1{background:var(--a1);}
.report3-section-num.l2{background:#6B7A1A;}
.report3-section-num.l3{background:#8A6A3A;}
.report3-p{font-size:11px;color:var(--text2);line-height:1.85;margin-bottom:12px;}
.report3-p strong{color:var(--text);font-weight:700;}
.report3-highlight{background:linear-gradient(135deg,rgba(23,138,183,.05),rgba(159,172,36,.03));border:1px solid var(--border2);border-radius:8px;padding:13px 16px;margin-bottom:12px;position:relative;}
.report3-highlight::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:3px 0 0 3px;}
.report3-highlight.l1::before{background:var(--a1);}
.report3-highlight.l2::before{background:var(--a2);}
.report3-highlight.l3::before{background:var(--a3);}
.report3-highlight-title{font-size:10px;font-weight:700;margin-bottom:5px;letter-spacing:.04em;}
.report3-highlight.l1 .report3-highlight-title{color:var(--a1);}
.report3-highlight.l2 .report3-highlight-title{color:#6B7A1A;}
.report3-highlight.l3 .report3-highlight-title{color:#8A6A3A;}
.report3-highlight-body{font-size:11px;color:var(--text2);line-height:1.75;}
.report3-quote{border-left:3px solid var(--a3);padding:10px 14px;background:var(--a3-dim);border-radius:0 6px 6px 0;margin-bottom:12px;font-size:11px;color:var(--text2);line-height:1.7;font-style:italic;}
.report3-quote cite{display:block;font-size:9px;font-style:normal;color:var(--text4);margin-top:5px;font-family:'JetBrains Mono',monospace;}

/* 报告表格 */
.report3-table{width:100%;border-collapse:collapse;margin-bottom:14px;font-size:11px;}
.report3-table th{background:var(--surface2);font-size:9px;font-weight:700;color:var(--text3);padding:7px 10px;text-align:left;border-bottom:1px solid var(--border2);letter-spacing:.06em;text-transform:uppercase;}
.report3-table td{padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text2);}
.report3-table tr:last-child td{border-bottom:none;}
.report3-table tr:hover td{background:var(--surface2);}

/* 生成状态 */
.report3-generating{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 24px;gap:16px;}
.report3-gen-icon{width:56px;height:56px;border-radius:14px;background:var(--a1-dim2);display:flex;align-items:center;justify-content:center;}
.report3-gen-icon svg{width:24px;height:24px;stroke:var(--a1);fill:none;stroke-width:1.6;}
.report3-gen-title{font-size:14px;font-weight:800;color:var(--text);}
.report3-gen-desc{font-size:11px;color:var(--text3);text-align:center;max-width:360px;line-height:1.65;}
.report3-gen-progress{width:280px;height:4px;background:var(--surface3);border-radius:2px;overflow:hidden;}
.report3-gen-fill{height:100%;background:linear-gradient(90deg,var(--a1),var(--a2));border-radius:2px;animation:genProgress 2.5s ease-in-out infinite;}
@keyframes genProgress{0%{width:0%;}60%{width:85%;}100%{width:100%;}}

/* ═══════════════════════════════════════
   PAGE: AI 对话
═══════════════════════════════════════ */
.chat-layout{display:grid;grid-template-columns:260px 1fr;gap:0;height:calc(100vh - 130px);overflow:hidden;}

/* 左侧知识库面板 */
.chat-kb{border-right:1px solid var(--border);background:var(--surface);display:flex;flex-direction:column;overflow:hidden;}
.chat-kb-hd{padding:14px 16px 10px;border-bottom:1px solid var(--border);}
.chat-kb-title{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;}
.chat-kb-stats{display:flex;gap:8px;}
.chat-kb-stat{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:6px 8px;text-align:center;}
.chat-kb-stat-val{font-size:14px;font-weight:900;color:var(--a1);font-variant-numeric:tabular-nums;}
.chat-kb-stat-label{font-size:8px;color:var(--text4);margin-top:1px;}
.chat-kb-body{flex:1;overflow-y:auto;padding:10px 12px;}
.chat-kb-section{margin-bottom:12px;}
.chat-kb-section-title{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;padding:4px 4px 6px;display:flex;align-items:center;gap:5px;}
.chat-kb-section-title::before{content:'';width:8px;height:2px;background:var(--a1);border-radius:1px;}
.chat-kb-item{display:flex;align-items:center;gap:6px;padding:5px 7px;border-radius:5px;font-size:10px;color:var(--text2);cursor:pointer;transition:all .12s;}
.chat-kb-item:hover{background:var(--surface2);}
.chat-kb-item-dot{width:5px;height:5px;border-radius:50%;flex-shrink:0;}
.chat-kb-item-dot.a1{background:var(--a1);}
.chat-kb-item-dot.a2{background:var(--a2);}
.chat-kb-item-dot.a5{background:var(--a5);}
.chat-kb-item-dot.a3{background:var(--a3);}
.chat-kb-item-name{flex:1;font-weight:500;}
.chat-kb-item-count{font-size:9px;font-family:'JetBrains Mono',monospace;color:var(--text4);}
.chat-kb-toggle{display:flex;align-items:center;gap:5px;padding:5px 7px;border-radius:5px;font-size:10px;color:var(--text3);cursor:pointer;transition:all .12s;border:1px solid var(--border);background:var(--surface2);margin-top:4px;}
.chat-kb-toggle:hover{border-color:var(--border2);}
.chat-kb-toggle.on{background:var(--a2-dim2);color:#6B7A1A;border-color:rgba(159,172,36,.3);}
.chat-kb-toggle-dot{width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0;}

/* 右侧对话区 */
.chat-main{display:flex;flex-direction:column;overflow:hidden;background:var(--bg);}
.chat-messages{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:14px;}
.chat-msg{display:flex;gap:10px;max-width:100%;}
.chat-msg.user{flex-direction:row-reverse;}
.chat-msg-avatar{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;margin-top:2px;}
.chat-msg.user .chat-msg-avatar{background:var(--a1);color:#fff;}
.chat-msg.ai .chat-msg-avatar{background:linear-gradient(135deg,var(--a1),var(--a5));color:#fff;}
.chat-msg-bubble{max-width:72%;padding:11px 14px;border-radius:10px;font-size:12px;line-height:1.7;}
.chat-msg.user .chat-msg-bubble{background:var(--a1);color:#fff;border-radius:10px 2px 10px 10px;}
.chat-msg.ai .chat-msg-bubble{background:var(--surface);border:1px solid var(--border);color:var(--text2);border-radius:2px 10px 10px 10px;box-shadow:var(--shadow);}
.chat-msg.ai .chat-msg-bubble strong{color:var(--a1);}
.chat-msg-meta{font-size:9px;color:var(--text4);margin-top:4px;font-family:'JetBrains Mono',monospace;}
.chat-msg.user .chat-msg-meta{text-align:right;}

/* 引用来源 */
.chat-sources{margin-top:8px;padding-top:8px;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:4px;}
.chat-source-pill{display:inline-flex;align-items:center;gap:3px;font-size:9px;font-weight:600;padding:2px 7px;border-radius:20px;background:var(--a1-dim);color:var(--a1);border:1px solid var(--border2);cursor:pointer;transition:all .12s;}
.chat-source-pill:hover{background:var(--a1-dim2);}
.chat-source-pill svg{width:8px;height:8px;stroke:currentColor;fill:none;stroke-width:2;}

/* 快捷问题 */
.chat-suggestions{padding:10px 24px;border-top:1px solid var(--border);background:var(--surface);display:flex;gap:6px;flex-wrap:wrap;}
.chat-suggestion{padding:5px 11px;border-radius:20px;font-size:10px;font-weight:600;cursor:pointer;transition:all .15s;border:1px solid var(--border2);background:var(--surface2);color:var(--text2);}
.chat-suggestion:hover{border-color:var(--a1);color:var(--a1);background:var(--a1-dim);}

/* 输入框 */
.chat-input-area{padding:12px 24px 16px;background:var(--surface);border-top:1px solid var(--border);}
.chat-input-wrap{display:flex;gap:8px;align-items:flex-end;background:var(--surface2);border:1px solid var(--border2);border-radius:10px;padding:8px 12px;transition:border-color .15s;}
.chat-input-wrap:focus-within{border-color:var(--a1);box-shadow:0 0 0 3px var(--a1-dim);}
.chat-input{flex:1;border:none;background:none;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text);resize:none;outline:none;min-height:20px;max-height:120px;line-height:1.5;}
.chat-input::placeholder{color:var(--text4);}
.chat-send-btn{width:32px;height:32px;border-radius:7px;background:var(--a1);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s;}
.chat-send-btn:hover{background:#1299CC;transform:scale(1.05);}
.chat-send-btn svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2;}
.chat-send-btn:disabled{background:var(--surface3);cursor:not-allowed;transform:none;}
.chat-input-meta{display:flex;align-items:center;gap:8px;margin-top:6px;font-size:9px;color:var(--text4);}
.chat-input-meta-item{display:flex;align-items:center;gap:3px;}

/* AI 思考动画 */
.chat-thinking{display:flex;gap:4px;align-items:center;padding:8px 0;}
.chat-thinking-dot{width:6px;height:6px;border-radius:50%;background:var(--a1);animation:thinkDot 1.2s ease-in-out infinite;}
.chat-thinking-dot:nth-child(2){animation-delay:.2s;}
.chat-thinking-dot:nth-child(3){animation-delay:.4s;}
@keyframes thinkDot{0%,80%,100%{transform:scale(.6);opacity:.4;}40%{transform:scale(1);opacity:1;}}

/* ═══════════════════════════════════════
   MODAL: 报告下载预览
═══════════════════════════════════════ */
.dl-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:400;display:none;align-items:center;justify-content:center;backdrop-filter:blur(3px);}
.dl-modal-overlay.open{display:flex;}
.dl-modal{background:var(--surface);border-radius:14px;width:480px;box-shadow:0 20px 60px rgba(23,138,183,.2);border:1px solid var(--border2);animation:modalIn .25s cubic-bezier(.4,0,.2,1);}
@keyframes modalIn{from{opacity:0;transform:scale(.95) translateY(10px);}to{opacity:1;transform:scale(1) translateY(0);}}
.dl-modal-hd{padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;}
.dl-modal-title{font-size:14px;font-weight:800;color:var(--text);flex:1;}
.dl-modal-close{width:28px;height:28px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;}
.dl-modal-close svg{width:12px;height:12px;stroke:var(--text3);fill:none;stroke-width:2;}
.dl-modal-body{padding:20px 24px;}
.dl-option{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;cursor:pointer;transition:all .15s;}
.dl-option:hover{border-color:var(--border2);background:var(--surface2);}
.dl-option-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.dl-option-icon svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;}
.dl-option-icon.html{background:var(--a1-dim2);color:var(--a1);}
.dl-option-icon.pdf{background:var(--red-dim);color:var(--red);}
.dl-option-info{flex:1;}
.dl-option-name{font-size:12px;font-weight:700;color:var(--text);}
.dl-option-desc{font-size:10px;color:var(--text3);margin-top:1px;}
.dl-modal-ft{padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;}

/* ── ANIMATIONS ── */
@keyframes fadeIn{from{opacity:0;transform:translateY(-5px);}to{opacity:1;transform:translateY(0);}}
@keyframes countUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
.fade-in{animation:fadeIn .2s ease;}

    /* ═══════════════════════════════════════
       FLOWS: 登录 / 新建项目 / 弹窗
    ═══════════════════════════════════════ */
    /* ═══════════════════════════════════════
   PAGE: 登录
═══════════════════════════════════════ */
.login-page{min-height:calc(100vh - 44px);background:linear-gradient(135deg,#0E6A8F 0%,#178AB7 40%,#1278A0 70%,#0D5A7A 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.login-bg-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;}
.login-bg-glow{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(159,172,36,.12) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;}
.login-card{background:rgba(255,255,255,.97);border-radius:18px;padding:44px 48px;width:420px;box-shadow:0 24px 80px rgba(0,0,0,.25),0 0 0 1px rgba(255,255,255,.3);position:relative;z-index:1;}
.login-logo{display:flex;align-items:center;gap:12px;margin-bottom:32px;}
.login-logo-mark{width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#178AB7,#1278A0);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(23,138,183,.4);}
.login-logo-mark svg{width:20px;height:20px;fill:none;stroke:#fff;stroke-width:2;}
.login-logo-text{font-size:20px;font-weight:900;color:var(--text);letter-spacing:-.02em;}
.login-logo-sub{font-size:10px;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;margin-top:1px;}
.login-title{font-size:22px;font-weight:800;color:var(--text);margin-bottom:6px;}
.login-sub{font-size:12px;color:var(--text3);margin-bottom:28px;}
.form-group{margin-bottom:16px;}
.form-label{font-size:11px;font-weight:700;color:var(--text2);margin-bottom:6px;display:block;letter-spacing:.03em;}
.form-input{width:100%;padding:10px 14px;border:1.5px solid var(--border2);border-radius:8px;font-size:13px;font-family:'Inter Tight',sans-serif;color:var(--text);background:var(--surface);transition:all .15s;outline:none;}
.form-input:focus{border-color:var(--a1);box-shadow:0 0 0 3px rgba(23,138,183,.12);}
.form-input.error{border-color:var(--red);box-shadow:0 0 0 3px rgba(192,57,43,.1);}
.form-input-wrap{position:relative;}
.form-input-icon{position:absolute;right:12px;top:50%;transform:translateY(-50%);cursor:pointer;color:var(--text4);}
.form-input-icon svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;}
.form-error{font-size:10px;color:var(--red);margin-top:5px;display:none;}
.form-error.show{display:block;}
.login-options{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
