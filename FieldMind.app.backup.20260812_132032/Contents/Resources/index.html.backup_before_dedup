<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FieldMind · 田野知识引擎</title>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --a1:#178AB7; --a2:#9FAC24; --a3:#D9BC92; --a4:#45481D; --a5:#6FA7B6;
  --bg:#F7F9FB; --bg2:#EEF1F5;
  --surface:#FFFFFF; --surface2:#F4F6F8; --surface3:#E8EDF2;
  --sb-bg:#178AB7; --sb-bg2:#1278A0;
  --sb-text:#FFFFFF; --sb-text2:rgba(255,255,255,.88); --sb-text3:rgba(255,255,255,.52);
  --sb-border:rgba(255,255,255,.14); --sb-active-bg:rgba(255,255,255,.18);
  --sb-active-border:rgba(255,255,255,.38); --sb-hover:rgba(255,255,255,.1);
  --border:rgba(23,138,183,.1); --border2:rgba(23,138,183,.22); --border3:rgba(23,138,183,.42);
  --text:#2A2D0F; --text2:#45481D; --text3:#5A6A7A; --text4:#8A9AAA;
  --a1-dim:rgba(23,138,183,.07); --a1-dim2:rgba(23,138,183,.14); --a1-glow:rgba(23,138,183,.28);
  --a2-dim:rgba(159,172,36,.08); --a2-dim2:rgba(159,172,36,.16); --a2-glow:rgba(159,172,36,.26);
  --a3-dim:rgba(217,188,146,.15); --a3-dim2:rgba(217,188,146,.28);
  --a5-dim:rgba(111,167,182,.09); --a5-dim2:rgba(111,167,182,.17);
  --red:#C0392B; --red-dim:rgba(192,57,43,.1);
  --shadow:0 2px 12px rgba(23,138,183,.07); --shadow-lg:0 6px 28px rgba(23,138,183,.12);
  --glow-a1:0 0 16px rgba(23,138,183,.2); --glow-a2:0 0 16px rgba(159,172,36,.18);
}
html{scroll-behavior:smooth;}
body{font-family:'Inter Tight',sans-serif;background:var(--bg);color:var(--text);font-size:13px;line-height:1.6;overflow-x:hidden;}
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:var(--bg2);}
::-webkit-scrollbar-thumb{background:var(--a5);border-radius:2px;}

/* ── LAYOUT ── */
/* ── LAYOUT ── */
body { margin: 0; padding: 0; overflow: hidden; }
.app { display: flex; width: 100%; height: 100vh; overflow: hidden; }

/* ── SIDEBAR ── */
.sidebar {
  flex-shrink: 0;
  width: 240px;
  height: 100%;
  background: linear-gradient(180deg,#178AB7 0%,#1278A0 100%);
  border-right: 1px solid var(--sb-border);
  display: flex;
  flex-direction: column;
  transition: width 0.3s ease;
  overflow: hidden;
  position: relative;
}

.sidebar.collapsed {
  width: 60px;
}

.sidebar.collapsed .sb-name,
.sidebar.collapsed .sb-sub,
.sidebar.collapsed .live-badge,
.sidebar.collapsed .sb-item span,
.sidebar.collapsed .sb-badge,
.sidebar.collapsed .sb-uname,
.sidebar.collapsed .sb-urole {
  opacity: 0;
  width: 0;
  overflow: hidden;
}

/* 侧边栏顶部操作区 */
.sidebar-header {
  padding: 14px 12px 12px;
  border-bottom: 1px solid var(--sb-border);
  flex-shrink: 0;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  gap: 8px;
}

.header-logo {
  font-size: 15px;
  font-weight: 800;
  color: var(--sb-text);
  letter-spacing: -0.02em;
  white-space: nowrap;
  transition: opacity 0.3s, width 0.3s;
}

.sidebar.collapsed .header-logo {
  opacity: 0;
  width: 0;
}

.new-chat-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  background: rgba(255,255,255,0.22);
  color: white;
  border: 1px solid rgba(255,255,255,0.3);
  padding: 5px 11px;
  border-radius: 18px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
  font-family: 'Inter Tight', sans-serif;
}

.new-chat-btn:hover {
  background: rgba(255,255,255,0.3);
  border-color: rgba(255,255,255,0.4);
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.sidebar.collapsed .new-chat-btn {
  opacity: 0;
  width: 0;
  padding: 0;
  overflow: hidden;
}

.icon-plus {
  font-size: 16px;
  font-weight: 300;
  line-height: 1;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.12);
  border-radius: 8px;
  padding: 0 10px;
  border: 1px solid rgba(255,255,255,0.16);
  transition: all 0.2s;
}

.search-wrap:focus-within {
  background: rgba(255,255,255,0.18);
  border-color: rgba(255,255,255,0.3);
  box-shadow: 0 0 0 2px rgba(255,255,255,0.1);
}

.sidebar.collapsed .search-wrap {
  opacity: 0;
  height: 0;
  padding: 0;
  border: none;
  overflow: hidden;
}

.search-icon {
  color: rgba(255,255,255,0.6);
  font-size: 13px;
  margin-right: 6px;
  flex-shrink: 0;
}

.search-wrap input {
  border: none;
  outline: none;
  background: transparent;
  width: 100%;
  padding: 7px 0;
  font-size: 11px;
  color: white;
  font-family: 'Inter Tight', sans-serif;
}

.search-wrap input::placeholder {
  color: rgba(255,255,255,0.5);
}

/* 折叠按钮 */
.sidebar-toggle {
  position: absolute;
  top: 50%;
  right: -18px;
  width: 36px;
  height: 36px;
  background: white;
  border-radius: 50%;
  border: 2px solid var(--a1);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  z-index: 1000;
  transition: all 0.3s ease;
  transform: translateY(-50%);
}

.sidebar-toggle:hover {
  transform: translateY(-50%) scale(1.1);
  box-shadow: 0 4px 16px rgba(0,0,0,0.2);
}

.sidebar-toggle svg {
  width: 14px;
  height: 14px;
  stroke: var(--a1);
  fill: none;
  stroke-width: 3;
  transition: transform 0.3s ease;
}

.sidebar.collapsed .sidebar-toggle svg {
  transform: rotate(180deg);
}

.sb-brand{padding:22px 16px 18px;border-bottom:1px solid var(--sb-border);position:relative;}
.sb-brand::after{content:'';position:absolute;bottom:0;left:16px;right:16px;height:1px;background:linear-gradient(90deg,rgba(255,255,255,.3),transparent);}
.sb-logo{display:flex;align-items:center;gap:10px;}
.sb-logo-mark{width:30px;height:30px;border-radius:7px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 0 14px rgba(0,0,0,.15),inset 0 1px 0 rgba(255,255,255,.3);}
.sb-logo-mark svg{width:14px;height:14px;fill:none;stroke:#fff;stroke-width:2;}
.sb-name{font-size:13px;font-weight:800;color:var(--sb-text);letter-spacing:-.01em;white-space:nowrap;transition:opacity 0.3s,width 0.3s;}
.sb-sub{font-size:9px;color:var(--sb-text3);margin-top:1px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;transition:opacity 0.3s,width 0.3s;}
.live-badge{display:flex;align-items:center;gap:5px;margin-top:10px;font-size:9px;font-weight:700;color:var(--a2);letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;transition:opacity 0.3s,width 0.3s;}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--a2);animation:livePulse 1.8s ease-in-out infinite;box-shadow:0 0 6px var(--a2);}
@keyframes livePulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(.8);}}
.sb-nav{flex:1;padding:12px 8px;display:flex;flex-direction:column;gap:1px;overflow-y:auto;}
.sb-section{font-size:9px;font-weight:700;color:var(--sb-text3);letter-spacing:.1em;text-transform:uppercase;padding:10px 8px 4px;}
.sb-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:7px;font-size:12px;font-weight:500;color:var(--sb-text2);cursor:pointer;transition:all .15s;position:relative;border:none;background:none;font-family:'Inter Tight',sans-serif;width:100%;text-align:left;}
.sb-item span{white-space:nowrap;transition:opacity 0.3s,width 0.3s;}
.sb-item:hover{background:var(--sb-hover);color:var(--sb-text);}
.sb-item.active{background:var(--sb-active-bg);color:var(--sb-text);border:1px solid var(--sb-active-border);}
.sb-item.active::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:16px;background:var(--a2);border-radius:0 3px 3px 0;box-shadow:0 0 8px var(--a2);}
.sb-item svg{width:14px;height:14px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:1.8;}
.sb-badge{margin-left:auto;background:rgba(159,172,36,.3);color:#D4E84A;font-size:9px;font-weight:700;padding:1px 6px;border-radius:10px;border:1px solid rgba(159,172,36,.4);transition:opacity 0.3s,width 0.3s;}
.sb-project{padding:8px 8px 6px;border-top:1px solid var(--sb-border);margin-top:4px;}
.sb-project-item{display:flex;align-items:center;gap:7px;padding:6px 10px;border-radius:6px;font-size:11px;color:var(--sb-text3);cursor:pointer;transition:all .15s;}
.sb-project-item:hover{background:var(--sb-hover);color:var(--sb-text2);}
.sb-project-item.cur{color:var(--sb-text2);font-weight:600;}
.sb-project-dot{width:5px;height:5px;border-radius:50%;background:var(--a2);flex-shrink:0;box-shadow:0 0 5px var(--a2);}
.sb-footer{padding:12px 16px;border-top:1px solid var(--sb-border);}
.sb-user{display:flex;align-items:center;gap:8px;}
.sb-avatar{width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0;border:1px solid rgba(255,255,255,.3);}
.sb-uname{font-size:11px;font-weight:600;color:var(--sb-text);white-space:nowrap;transition:opacity 0.3s,width 0.3s;}
.sb-urole{font-size:9px;color:var(--sb-text3);white-space:nowrap;transition:opacity 0.3s,width 0.3s;}

/* ── MAIN ── */
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: auto;
  transition: flex 0.3s ease;
}

/* ── TOPBAR ── */
.topbar{height:50px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 24px;gap:12px;position:sticky;top:0;z-index:50;box-shadow:0 1px 6px rgba(23,138,183,.06);}
.topbar-left{flex:1;display:flex;align-items:center;gap:12px;}
.topbar-title{font-size:13px;font-weight:700;color:var(--text);}
.topbar-sep{width:1px;height:14px;background:var(--border2);}
.topbar-path{font-size:11px;color:var(--text3);font-family:'JetBrains Mono',monospace;}
.topbar-actions{display:flex;align-items:center;gap:8px;}
.live-clock{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--a1);background:var(--a1-dim);border:1px solid var(--border2);padding:3px 10px;border-radius:5px;letter-spacing:.04em;}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:5px;padding:6px 13px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;border:none;transition:all .15s;font-family:'Inter Tight',sans-serif;letter-spacing:.02em;}
.btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;}
.btn-primary{background:var(--a1);color:#fff;box-shadow:0 2px 10px rgba(23,138,183,.3);}
.btn-primary:hover{background:#1299CC;box-shadow:0 4px 16px rgba(23,138,183,.4);}
.btn-success{background:var(--a2);color:#fff;box-shadow:0 2px 10px rgba(159,172,36,.3);}
.btn-success:hover{background:#8A9820;}
.btn-outline{background:transparent;color:var(--a1);border:1px solid var(--border2);}
.btn-outline:hover{background:var(--a1-dim);border-color:var(--a1);}
.btn-ghost{background:transparent;color:var(--text3);border:1px solid var(--border);}
.btn-ghost:hover{background:var(--surface2);color:var(--text2);}
.btn-danger{background:transparent;color:var(--red);border:1px solid rgba(192,57,43,.3);}
.btn-danger:hover{background:var(--red-dim);}

/* ── TABS ── */
.tabs{display:flex;gap:1px;background:var(--surface2);border-radius:7px;padding:2px;border:1px solid var(--border);}
.tab{padding:4px 12px;border-radius:5px;font-size:11px;font-weight:600;color:var(--text3);cursor:pointer;transition:all .15s;border:none;background:none;font-family:'Inter Tight',sans-serif;}
.tab.active{background:var(--a1-dim2);color:var(--a1);border:1px solid var(--border2);}

/* ── PAGE ── */
.page-content{flex:1;padding:20px 24px;width:100%;}
.page-section{display:none;}
.page-section.active{display:block;}
.section{margin-bottom:28px;}
.section-hd{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px;}
.section-title{font-size:14px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:7px;letter-spacing:-.01em;}
.section-dot{width:6px;height:6px;border-radius:50%;background:var(--a1);flex-shrink:0;box-shadow:0 0 8px var(--a1);}
.section-sub{font-size:10px;color:var(--text3);margin-top:2px;letter-spacing:.02em;}

/* ── GRID ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.g5{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}
.g75{display:grid;grid-template-columns:7fr 5fr;gap:14px;}
.g57{display:grid;grid-template-columns:5fr 7fr;gap:14px;}

/* ── CARD ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:border-color .2s,box-shadow .2s;box-shadow:var(--shadow);}
.card:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);}
.card-hd{padding:12px 16px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--surface);}
.card-title{font-size:12px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:6px;}
.card-icon{width:20px;height:20px;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.card-icon svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2;}
.card-icon.a1{background:var(--a1-dim2);color:var(--a1);}
.card-icon.a2{background:var(--a2-dim2);color:#6B7A1A;}
.card-icon.a5{background:var(--a5-dim2);color:var(--a5);}
.card-body{padding:14px 16px;}
.card-meta{font-size:10px;color:var(--text3);}

/* ── STAT CARDS ── */
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px 18px;position:relative;overflow:hidden;transition:all .2s;box-shadow:var(--shadow);}
.stat-card:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);}
.stat-card-line{position:absolute;top:0;left:0;right:0;height:3px;}
.stat-card.a1 .stat-card-line{background:linear-gradient(90deg,var(--a1),transparent);}
.stat-card.a2 .stat-card-line{background:linear-gradient(90deg,var(--a2),transparent);}
.stat-card.a5 .stat-card-line{background:linear-gradient(90deg,var(--a5),transparent);}
.stat-card.a3 .stat-card-line{background:linear-gradient(90deg,var(--a3),transparent);}
.stat-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
.stat-icon svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.8;}
.stat-icon.a1{background:var(--a1-dim2);color:var(--a1);}
.stat-icon.a2{background:var(--a2-dim2);color:#6B7A1A;}
.stat-icon.a5{background:var(--a5-dim2);color:var(--a5);}
.stat-icon.a3{background:var(--a3-dim2);color:var(--a4);}
.stat-label{font-size:10px;color:var(--text3);margin-bottom:3px;letter-spacing:.03em;}
.stat-value{font-size:28px;font-weight:900;color:var(--text);letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums;}
.stat-delta{font-size:10px;font-weight:600;margin-top:5px;display:flex;align-items:center;gap:3px;}
.stat-delta.up{color:var(--a2);}
.stat-delta.flat{color:var(--text3);}

/* ── KPI ── */
.kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px 14px;transition:all .2s;position:relative;overflow:hidden;box-shadow:var(--shadow);}
.kpi-card:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);}
.kpi-card::before{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--a1),transparent);}
.kpi-card.green::before{background:linear-gradient(90deg,var(--a2),transparent);}
.kpi-card.sand::before{background:linear-gradient(90deg,var(--a3),transparent);}
.kpi-card.sky::before{background:linear-gradient(90deg,var(--a5),transparent);}
.kpi-val{font-size:22px;font-weight:900;color:var(--a1);letter-spacing:-.04em;line-height:1;margin-bottom:3px;font-variant-numeric:tabular-nums;}
.kpi-val.green{color:#6B7A1A;}
.kpi-val.sky{color:var(--a5);}
.kpi-val.sand{color:#8A6A3A;}
.kpi-label{font-size:10px;color:var(--text3);}
.kpi-delta{font-size:9px;font-weight:700;color:var(--a2);margin-top:3px;}
.kpi-delta.sky{color:var(--a5);}
.kpi-delta.sand{color:#8A6A3A;}

/* ── PROGRESS ── */
.prog-list{display:flex;flex-direction:column;gap:10px;}
.prog-hd{display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px;}
.prog-name{color:var(--text2);font-weight:500;}
.prog-val{color:var(--text);font-weight:700;font-family:'JetBrains Mono',monospace;font-size:10px;}
.prog-track{height:4px;background:var(--surface3);border-radius:2px;overflow:hidden;}
.prog-fill{height:100%;border-radius:2px;transition:width .8s ease;}

/* ── CHART ── */
.chart-wrap{position:relative;}

/* ── KW CLOUD ── */
.kw-cloud{display:flex;flex-wrap:wrap;gap:7px;padding:14px 16px;}
.kw-tag{padding:5px 12px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;transition:all .2s;border:1px solid transparent;letter-spacing:.02em;}
.kw-tag:hover{transform:translateY(-2px);}
.kw-tag.xl{font-size:14px;padding:7px 16px;} .kw-tag.lg{font-size:13px;padding:6px 14px;} .kw-tag.md{font-size:12px;padding:5px 12px;} .kw-tag.sm{font-size:11px;padding:4px 10px;} .kw-tag.xs{font-size:10px;padding:3px 9px;}
.kw-tag.ta{background:var(--a1-dim2);color:var(--a1);border-color:rgba(23,138,183,.22);}
.kw-tag.ta:hover,.kw-tag.ta.on{background:var(--a1);color:#fff;border-color:var(--a1);box-shadow:var(--glow-a1);}
.kw-tag.tb{background:var(--a2-dim2);color:#6B7A1A;border-color:rgba(159,172,36,.28);}
.kw-tag.tb:hover,.kw-tag.tb.on{background:var(--a2);color:#fff;border-color:var(--a2);box-shadow:var(--glow-a2);}
.kw-tag.tc{background:var(--a5-dim2);color:#3A7A8C;border-color:rgba(111,167,182,.28);}
.kw-tag.tc:hover,.kw-tag.tc.on{background:var(--a5);color:#fff;border-color:var(--a5);}
.kw-panel{display:none;padding:0 16px 16px;border-top:1px solid var(--border);animation:fadeIn .2s ease;}
.kw-panel.show{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(-5px);}to{opacity:1;transform:translateY(0);}}
.kw-panel-title{font-size:14px;font-weight:800;color:var(--a1);padding:12px 0 9px;display:flex;align-items:center;gap:7px;}
.kw-panel-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.kw-sub{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;}
.kw-sub-title{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;}
.tl-item{display:flex;gap:9px;padding:6px 0;border-bottom:1px solid var(--border);font-size:11px;}
.tl-item:last-child{border-bottom:none;}
.tl-date{color:var(--a1);font-weight:700;min-width:52px;flex-shrink:0;font-family:'JetBrains Mono',monospace;font-size:10px;}
.tl-text{color:var(--text2);line-height:1.5;}
.src-item{display:flex;align-items:flex-start;gap:7px;padding:6px 0;border-bottom:1px solid var(--border);font-size:11px;}
.src-item:last-child{border-bottom:none;}
.src-type{padding:1px 6px;border-radius:3px;font-size:9px;font-weight:700;flex-shrink:0;margin-top:1px;letter-spacing:.04em;text-transform:uppercase;}
.src-type.audio{background:var(--a1-dim2);color:var(--a1);}
.src-type.video{background:var(--a2-dim2);color:#6B7A1A;}
.src-type.note{background:var(--a5-dim2);color:#3A7A8C;}
.src-name{color:var(--text);font-weight:600;}
.src-loc{color:var(--text3);margin-top:1px;font-size:10px;font-family:'JetBrains Mono',monospace;}

/* ── BIZ CARDS ── */
.biz-card{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:13px;transition:all .2s;box-shadow:var(--shadow);cursor:pointer;}
.biz-card:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);transform:translateY(-2px);}
.biz-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;}
.biz-name{font-size:12px;font-weight:700;color:var(--text);}
.biz-score{font-size:20px;font-weight:900;color:var(--a1);letter-spacing:-.03em;font-variant-numeric:tabular-nums;}
.biz-score span{font-size:10px;font-weight:500;color:var(--text3);}
.biz-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:7px;}
.biz-tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;letter-spacing:.03em;}
.biz-tag.g{background:var(--a2-dim2);color:#6B7A1A;}
.biz-tag.b{background:var(--a1-dim2);color:var(--a1);}
.biz-tag.t{background:var(--a5-dim2);color:#3A7A8C;}
.biz-tag.s{background:var(--a3-dim2);color:#8A6A3A;}
.biz-desc{font-size:10px;color:var(--text3);line-height:1.6;margin-bottom:9px;}
.biz-bar-lbl{display:flex;justify-content:space-between;font-size:9px;color:var(--text3);margin-bottom:3px;}
.biz-bar-track{height:3px;background:var(--surface3);border-radius:2px;overflow:hidden;}
.biz-bar-fill{height:100%;border-radius:2px;transition:width .7s ease;}
.biz-expand-hint{font-size:9px;color:var(--a1);margin-top:7px;display:flex;align-items:center;gap:3px;opacity:.7;}

/* ── AI BOX ── */
.ai-box{background:linear-gradient(135deg,rgba(23,138,183,.05),rgba(159,172,36,.03));border:1px solid var(--border2);border-radius:9px;padding:14px 16px;position:relative;overflow:hidden;}
.ai-box::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--a1),var(--a2),transparent);}
.ai-box-hd{display:flex;align-items:center;gap:7px;margin-bottom:9px;}
.ai-badge{background:linear-gradient(90deg,var(--a1),var(--a5));color:#fff;font-size:9px;font-weight:700;padding:2px 8px;border-radius:3px;letter-spacing:.06em;}
.ai-box-title{font-size:12px;font-weight:700;color:var(--text);}
.ai-body{font-size:11px;color:var(--text2);line-height:1.75;}
.ai-body strong{color:var(--a1);}
.ai-evidence{margin-top:9px;padding-top:9px;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:4px;}
.ai-ev-label{font-size:9px;color:var(--text3);width:100%;margin-bottom:2px;}
.ev-pill{font-size:9px;font-weight:600;padding:2px 8px;border-radius:20px;background:var(--a1-dim2);color:var(--a1);border:1px solid var(--border2);font-family:'JetBrains Mono',monospace;}

/* ── FILE LIST ── */
.file-list{display:flex;flex-direction:column;gap:5px;}
.file-item{display:flex;align-items:center;gap:9px;padding:8px 11px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;transition:all .15s;}
.file-item:hover{border-color:var(--border2);background:var(--surface);}
.file-icon{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.file-icon svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;}
.file-icon.audio{background:var(--a1-dim2);color:var(--a1);}
.file-icon.video{background:var(--a2-dim2);color:#6B7A1A;}
.file-icon.doc{background:var(--a5-dim2);color:#3A7A8C;}
.file-icon.sheet{background:var(--a3-dim2);color:#8A6A3A;}
.file-info{flex:1;}
.file-name{font-size:11px;font-weight:600;color:var(--text);}
.file-meta{font-size:9px;color:var(--text3);margin-top:1px;font-family:'JetBrains Mono',monospace;}
.file-status{font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;letter-spacing:.03em;}
.file-status.done{background:var(--a2-dim2);color:#6B7A1A;}
.file-status.proc{background:var(--a1-dim2);color:var(--a1);}
.file-status.pend{background:var(--surface3);color:var(--text3);}

/* ── MODEL LAYERS ── */
.model-layer{border:1px solid var(--border);border-radius:9px;overflow:hidden;margin-bottom:9px;transition:border-color .2s;box-shadow:var(--shadow);}
.model-layer:hover{border-color:var(--border2);}
.model-layer-hd{display:flex;align-items:center;gap:9px;padding:11px 14px;cursor:pointer;background:var(--surface);transition:background .15s;}
.model-layer-hd:hover{background:var(--surface2);}
.ml-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ml-icon svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;}
.ml-icon.must{background:var(--a1-dim2);color:var(--a1);}
.ml-icon.verify{background:var(--a2-dim2);color:#6B7A1A;}
.ml-icon.opt{background:var(--a5-dim2);color:#3A7A8C;}
.ml-info{flex:1;}
.ml-name{font-size:12px;font-weight:700;color:var(--text);}
.ml-desc{font-size:10px;color:var(--text3);margin-top:1px;}
.ml-badge{font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;letter-spacing:.04em;}
.ml-badge.must{background:var(--a1-dim2);color:var(--a1);border:1px solid var(--border2);}
.ml-badge.verify{background:var(--a2-dim2);color:#6B7A1A;border:1px solid rgba(159,172,36,.3);}
.ml-badge.opt{background:var(--a5-dim2);color:#3A7A8C;border:1px solid rgba(111,167,182,.3);}
.ml-arrow{font-size:10px;color:var(--text3);transition:transform .2s;}
.model-layer.open .ml-arrow{transform:rotate(180deg);}
.model-layer-body{display:none;padding:0 14px 12px;background:var(--surface2);border-top:1px solid var(--border);}
.model-layer.open .model-layer-body{display:block;}
.ml-items{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;padding-top:10px;}
.ml-item{background:var(--surface);border:1px solid var(--border);border-radius:7px;padding:9px 11px;}
.ml-item-name{font-size:11px;font-weight:700;color:var(--text);margin-bottom:3px;}
.ml-item-desc{font-size:10px;color:var(--text3);line-height:1.5;}

/* ── SKILL CARDS ── */
.skill-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;transition:all .2s;cursor:pointer;position:relative;overflow:hidden;box-shadow:var(--shadow);}
.skill-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.skill-card.built::before{background:linear-gradient(90deg,var(--a1),var(--a5));}
.skill-card.opt::before{background:linear-gradient(90deg,var(--a2),#6B7A1A);}
.skill-card.add::before{background:linear-gradient(90deg,var(--a3),var(--a5));}
.skill-card:hover{box-shadow:var(--shadow-lg);transform:translateY(-2px);border-color:var(--border2);}
.skill-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
.skill-icon svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.6;}
.skill-icon.a1{background:var(--a1-dim2);color:var(--a1);}
.skill-icon.a2{background:var(--a2-dim2);color:#6B7A1A;}
.skill-icon.a5{background:var(--a5-dim2);color:#3A7A8C;}
.skill-name{font-size:12px;font-weight:700;color:var(--text);margin-bottom:5px;}
.skill-desc{font-size:10px;color:var(--text3);line-height:1.6;margin-bottom:9px;}
.skill-tags{display:flex;flex-wrap:wrap;gap:4px;}
.skill-tag{font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;letter-spacing:.03em;}
.skill-tag.a1{background:var(--a1-dim);color:var(--a1);}
.skill-tag.a2{background:var(--a2-dim);color:#6B7A1A;}
.skill-tag.a5{background:var(--a5-dim);color:#3A7A8C;}
.skill-status{position:absolute;top:12px;right:12px;font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;cursor:pointer;transition:all .2s;}
.skill-status.on{background:var(--a2-dim2);color:#6B7A1A;border:1px solid rgba(159,172,36,.3);}
.skill-status.on:hover{background:var(--red-dim);color:var(--red);border-color:rgba(192,57,43,.3);}
.skill-status.off{background:var(--surface3);color:var(--text3);border:1px solid var(--border);}
.skill-status.off:hover{background:var(--a2-dim2);color:#6B7A1A;border-color:rgba(159,172,36,.3);}

/* ── UPLOAD ZONE ── */
.upload-zone{border:2px dashed var(--border2);border-radius:10px;padding:32px 24px;text-align:center;background:var(--surface2);transition:all .2s;cursor:pointer;position:relative;}
.upload-zone:hover,.upload-zone.drag-over{border-color:var(--a1);background:var(--a1-dim);border-style:solid;}
.upload-zone.uploading{border-color:var(--a2);background:rgba(159,172,36,.05);}
.upload-icon{width:44px;height:44px;border-radius:10px;background:var(--a1-dim2);color:var(--a1);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;box-shadow:var(--glow-a1);}
.upload-icon svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.6;}
.upload-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:4px;}
.upload-sub{font-size:10px;color:var(--text3);}
.upload-types{display:flex;justify-content:center;gap:5px;margin-top:12px;flex-wrap:wrap;}
.upload-type{font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;background:var(--surface3);border:1px solid var(--border);color:var(--text3);font-family:'JetBrains Mono',monospace;}
.upload-progress{margin-top:14px;display:none;}
.upload-progress.show{display:block;}
.upload-prog-bar{height:4px;background:var(--surface3);border-radius:2px;overflow:hidden;margin-top:6px;}
.upload-prog-fill{height:100%;background:linear-gradient(90deg,var(--a1),var(--a2));border-radius:2px;transition:width .3s ease;width:0%;}
.upload-prog-label{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;}

/* ── HERO ── */
.hero{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 60%,rgba(23,138,183,.05) 100%);border:1px solid var(--border2);padding:28px 24px;border-radius:12px;margin-bottom:20px;position:relative;overflow:hidden;box-shadow:var(--shadow-lg);}
.hero::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--a1),var(--a2),transparent);}
.hero::after{content:'';position:absolute;top:-60px;right:-40px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(23,138,183,.05),transparent 70%);pointer-events:none;}
.hero-eyebrow{font-size:9px;font-weight:700;color:var(--a1);letter-spacing:.12em;text-transform:uppercase;margin-bottom:7px;display:flex;align-items:center;gap:6px;}
.hero-eyebrow::before{content:'';width:16px;height:1px;background:var(--a1);}
.hero-title{font-size:22px;font-weight:900;color:var(--text);letter-spacing:-.02em;line-height:1.2;margin-bottom:6px;}
.hero-sub{font-size:11px;color:var(--text3);max-width:460px;line-height:1.65;}
.hero-stats{display:flex;gap:24px;margin-top:18px;padding-top:16px;border-top:1px solid var(--border);}
.hero-stat-val{font-size:20px;font-weight:900;color:var(--text);letter-spacing:-.03em;font-variant-numeric:tabular-nums;}
.hero-stat-label{font-size:9px;color:var(--text3);margin-top:1px;letter-spacing:.04em;}

/* ── STEPS ── */
.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;position:relative;}
.steps::before{content:'';position:absolute;top:24px;left:10%;right:10%;height:1px;background:linear-gradient(90deg,var(--a1),var(--a2));z-index:0;opacity:.3;}
.step{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 5px;position:relative;z-index:1;}
.step-num{width:48px;height:48px;border-radius:50%;background:var(--surface);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;margin-bottom:9px;transition:all .2s;box-shadow:var(--shadow);}
.step-num svg{width:18px;height:18px;stroke:var(--a1);fill:none;stroke-width:1.6;}
.step:hover .step-num{border-color:var(--a1);background:var(--a1-dim);box-shadow:var(--glow-a1);transform:scale(1.06);}
.step-title{font-size:10px;font-weight:700;color:var(--text);margin-bottom:2px;}
.step-desc{font-size:9px;color:var(--text3);line-height:1.5;}

/* ── VERIFY BLOCKS ── */
.verify-block{padding:9px 11px;border-radius:7px;margin-bottom:7px;}
.verify-block:last-child{margin-bottom:0;}
.verify-block.ok{background:rgba(159,172,36,.07);border-left:2px solid var(--a2);}
.verify-block.pending{background:var(--a1-dim);border-left:2px solid var(--a1);}
.verify-block.fail{background:var(--red-dim);border-left:2px solid var(--red);}
.verify-block-title{font-size:9px;font-weight:700;margin-bottom:3px;letter-spacing:.04em;}
.verify-block.ok .verify-block-title{color:#6B7A1A;}
.verify-block.pending .verify-block-title{color:var(--a1);}
.verify-block.fail .verify-block-title{color:var(--red);}
.verify-block-body{font-size:10px;color:var(--text2);line-height:1.6;}

/* ── LEGEND ── */
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;}
.legend-item{display:flex;align-items:center;gap:4px;font-size:10px;color:var(--text3);}
.legend-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;}
.legend-line{width:12px;height:2px;border-radius:1px;flex-shrink:0;}

/* ── DATA TICKER ── */
.data-ticker{display:flex;align-items:center;gap:16px;padding:7px 16px;background:var(--surface);border-bottom:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:10px;overflow:hidden;box-shadow:0 1px 4px rgba(23,138,183,.05);}
.ticker-item{display:flex;align-items:center;gap:5px;white-space:nowrap;color:var(--text3);}
.ticker-item .val{color:var(--a1);font-weight:700;}
.ticker-item .up{color:var(--a2);}
.ticker-sep{color:var(--text4);}
.rt-indicator{display:flex;align-items:center;gap:5px;font-size:9px;font-weight:700;color:#6B7A1A;letter-spacing:.06em;text-transform:uppercase;}
.rt-dot{width:5px;height:5px;border-radius:50%;background:var(--a2);animation:livePulse 1.5s ease-in-out infinite;box-shadow:0 0 5px var(--a2);}

/* ── TABLE ── */
.table-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
th{font-size:9px;font-weight:700;color:var(--text3);text-align:left;padding:6px 10px;border-bottom:1px solid var(--border2);white-space:nowrap;letter-spacing:.06em;text-transform:uppercase;}
td{font-size:11px;color:var(--text2);padding:8px 10px;border-bottom:1px solid var(--border);}
tr:last-child td{border-bottom:none;}
tr:hover td{background:var(--surface2);}

/* ── TAGS ── */
.tag-sand{background:var(--a3-dim2);color:#8A6A3A;border:1px solid rgba(217,188,146,.4);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}
.tag-sky{background:var(--a5-dim2);color:#3A7A8C;border:1px solid rgba(111,167,182,.3);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}
.tag-green{background:var(--a2-dim2);color:#6B7A1A;border:1px solid rgba(159,172,36,.3);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}
.tag-blue{background:var(--a1-dim2);color:var(--a1);border:1px solid rgba(23,138,183,.25);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.03em;}

/* ── SCAN LINE ── */
@keyframes scanLine{0%{transform:translateY(-100%);}100%{transform:translateY(100vh);}}
.scan-overlay{position:fixed;top:0;left:210px;right:0;bottom:0;pointer-events:none;z-index:998;overflow:hidden;}
.scan-line{position:absolute;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(23,138,183,.04),transparent);animation:scanLine 10s linear infinite;}

/* ══════════════════════════════════════
   TIMELINE PAGE
══════════════════════════════════════ */
.timeline-wrap{position:relative;padding-left:28px;}
.timeline-wrap::before{content:'';position:absolute;left:10px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--a1),var(--a2),var(--a5));opacity:.3;border-radius:1px;}
.tl-group{margin-bottom:28px;}
.tl-group-label{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.tl-group-label::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--a1);flex-shrink:0;margin-left:-24px;box-shadow:0 0 8px var(--a1);}
.tl-entry{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:13px 15px;margin-bottom:8px;transition:all .2s;box-shadow:var(--shadow);position:relative;}
.tl-entry:hover{border-color:var(--border2);box-shadow:var(--shadow-lg);}
.tl-entry::before{content:'';position:absolute;left:-22px;top:18px;width:8px;height:8px;border-radius:50%;background:var(--surface);border:2px solid var(--a1);}
.tl-entry.audio::before{border-color:var(--a1);}
.tl-entry.video::before{border-color:var(--a2);}
.tl-entry.doc::before{border-color:var(--a5);}
.tl-entry.event::before{border-color:var(--a3);background:var(--a3);}
.tl-entry-hd{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
.tl-entry-date{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--a1);}
.tl-entry-type{font-size:9px;font-weight:700;padding:1px 6px;border-radius:3px;letter-spacing:.04em;text-transform:uppercase;}
.tl-entry-type.audio{background:var(--a1-dim2);color:var(--a1);}
.tl-entry-type.video{background:var(--a2-dim2);color:#6B7A1A;}
.tl-entry-type.doc{background:var(--a5-dim2);color:#3A7A8C;}
.tl-entry-type.event{background:var(--a3-dim2);color:#8A6A3A;}
.tl-entry-title{font-size:12px;font-weight:700;color:var(--text);flex:1;}
.tl-entry-body{font-size:11px;color:var(--text2);line-height:1.65;}
.tl-entry-kws{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;}
.tl-kw{font-size:9px;font-weight:600;padding:2px 7px;border-radius:20px;background:var(--a1-dim);color:var(--a1);border:1px solid var(--border2);}
.tl-kw.g{background:var(--a2-dim);color:#6B7A1A;border-color:rgba(159,172,36,.2);}
.tl-kw.s{background:var(--a5-dim);color:#3A7A8C;border-color:rgba(111,167,182,.2);}

/* ══════════════════════════════════════
   REPORT PAGE
══════════════════════════════════════ */
.report-wrap{max-width:860px;}
.report-cover{background:linear-gradient(135deg,var(--a1) 0%,var(--sb-bg2) 100%);border-radius:12px;padding:36px 40px;margin-bottom:24px;color:#fff;position:relative;overflow:hidden;}
.report-cover::after{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.06);pointer-events:none;}
.report-cover-eyebrow{font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;opacity:.7;margin-bottom:10px;}
.report-cover-title{font-size:26px;font-weight:900;letter-spacing:-.02em;line-height:1.2;margin-bottom:8px;}
.report-cover-sub{font-size:12px;opacity:.8;line-height:1.6;max-width:480px;}
.report-cover-meta{display:flex;gap:20px;margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,.2);}
.report-cover-meta-item{font-size:10px;opacity:.75;}
.report-cover-meta-item strong{display:block;font-size:14px;font-weight:800;opacity:1;margin-bottom:1px;}
.report-section{margin-bottom:24px;}
.report-section-title{font-size:13px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:8px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border2);}
.report-section-num{width:20px;height:20px;border-radius:5px;background:var(--a1);color:#fff;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.report-section-num.g{background:var(--a2);}
.report-section-num.s{background:var(--a5);}
.report-section-num.d{background:var(--a3);color:var(--a4);}
.report-p{font-size:11px;color:var(--text2);line-height:1.8;margin-bottom:10px;}
.report-p strong{color:var(--text);font-weight:700;}
.report-highlight{background:linear-gradient(135deg,rgba(23,138,183,.06),rgba(159,172,36,.04));border:1px solid var(--border2);border-radius:8px;padding:12px 16px;margin-bottom:12px;position:relative;}
.report-highlight::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--a1);border-radius:3px 0 0 3px;}
.report-highlight.green::before{background:var(--a2);}
.report-highlight.sand::before{background:var(--a3);}
.report-highlight.sky::before{background:var(--a5);}
.report-highlight-title{font-size:10px;font-weight:700;color:var(--a1);margin-bottom:5px;letter-spacing:.04em;}
.report-highlight.green .report-highlight-title{color:#6B7A1A;}
.report-highlight.sand .report-highlight-title{color:#8A6A3A;}
.report-highlight.sky .report-highlight-title{color:#3A7A8C;}
.report-highlight-body{font-size:11px;color:var(--text2);line-height:1.7;}
.report-table{width:100%;border-collapse:collapse;margin-bottom:12px;font-size:11px;}
.report-table th{background:var(--surface2);font-size:9px;font-weight:700;color:var(--text3);padding:7px 10px;text-align:left;border-bottom:1px solid var(--border2);letter-spacing:.06em;text-transform:uppercase;}
.report-table td{padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text2);}
.report-table tr:last-child td{border-bottom:none;}
.report-table tr:hover td{background:var(--surface2);}
.report-actions{display:flex;gap:8px;margin-bottom:20px;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:9px;align-items:center;}
.report-actions-label{font-size:11px;font-weight:600;color:var(--text2);flex:1;}

/* ══════════════════════════════════════
   BIZ DETAIL DRAWER
══════════════════════════════════════ */
.drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:200;display:none;backdrop-filter:blur(2px);}
.drawer-overlay.open{display:block;}
.drawer{position:fixed;right:0;top:0;bottom:0;width:520px;background:var(--surface);z-index:201;display:flex;flex-direction:column;box-shadow:-8px 0 40px rgba(23,138,183,.15);transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);}
.drawer.open{transform:translateX(0);}
.drawer-hd{padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;gap:12px;}
.drawer-close{width:28px;height:28px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all .15s;margin-left:auto;}
.drawer-close:hover{background:var(--red-dim);border-color:rgba(192,57,43,.3);}
.drawer-close svg{width:12px;height:12px;stroke:var(--text3);fill:none;stroke-width:2;}
.drawer-body{flex:1;overflow-y:auto;padding:20px 24px;}
.drawer-title{font-size:18px;font-weight:900;color:var(--text);letter-spacing:-.02em;}
.drawer-sub{font-size:11px;color:var(--text3);margin-top:3px;}
.drawer-score-big{font-size:48px;font-weight:900;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums;}
.drawer-section{margin-bottom:20px;}
.drawer-section-title{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.drawer-section-title::before{content:'';width:12px;height:2px;background:var(--a1);border-radius:1px;}
.dim-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.dim-label{font-size:11px;color:var(--text2);width:80px;flex-shrink:0;}
.dim-track{flex:1;height:6px;background:var(--surface3);border-radius:3px;overflow:hidden;}
.dim-fill{height:100%;border-radius:3px;transition:width .8s ease;}
.dim-val{font-size:11px;font-weight:700;color:var(--text);width:32px;text-align:right;font-family:'JetBrains Mono',monospace;}
.action-step{display:flex;gap:10px;padding:10px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;margin-bottom:7px;}
.action-step-num{width:20px;height:20px;border-radius:50%;background:var(--a1);color:#fff;font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.action-step-body{flex:1;}
.action-step-title{font-size:11px;font-weight:700;color:var(--text);margin-bottom:2px;}
.action-step-desc{font-size:10px;color:var(--text3);line-height:1.5;}
.risk-item{display:flex;gap:8px;padding:8px 10px;border-radius:6px;margin-bottom:6px;}
.risk-item.high{background:var(--red-dim);border-left:2px solid var(--red);}
.risk-item.mid{background:rgba(184,134,11,.08);border-left:2px solid #B8860B;}
.risk-item.low{background:var(--a2-dim);border-left:2px solid var(--a2);}
.risk-label{font-size:9px;font-weight:700;padding:1px 5px;border-radius:3px;flex-shrink:0;margin-top:1px;}
.risk-item.high .risk-label{background:var(--red-dim);color:var(--red);}
.risk-item.mid .risk-label{background:rgba(184,134,11,.12);color:#B8860B;}
.risk-item.low .risk-label{background:var(--a2-dim2);color:#6B7A1A;}
.risk-text{font-size:10px;color:var(--text2);line-height:1.5;}

/* ══════════════════════════════════════
   SKILL MODAL
══════════════════════════════════════ */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:300;display:none;align-items:center;justify-content:center;backdrop-filter:blur(3px);}
.modal-overlay.open{display:flex;}
.modal{background:var(--surface);border-radius:14px;width:520px;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(23,138,183,.2);border:1px solid var(--border2);animation:modalIn .25s cubic-bezier(.4,0,.2,1);}
@keyframes modalIn{from{opacity:0;transform:scale(.95) translateY(10px);}to{opacity:1;transform:scale(1) translateY(0);}}
.modal-hd{padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;}
.modal-title{font-size:14px;font-weight:800;color:var(--text);flex:1;}
.modal-close{width:28px;height:28px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;}
.modal-close:hover{background:var(--red-dim);}
.modal-close svg{width:12px;height:12px;stroke:var(--text3);fill:none;stroke-width:2;}
.modal-body{padding:20px 24px;overflow-y:auto;flex:1;}
.modal-ft{padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;}
.form-group{margin-bottom:14px;}
.form-label{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;display:block;}
.form-input{width:100%;padding:8px 11px;border:1px solid var(--border2);border-radius:6px;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text);background:var(--surface);transition:border-color .15s;outline:none;}
.form-input:focus{border-color:var(--a1);box-shadow:0 0 0 3px var(--a1-dim);}
.form-textarea{width:100%;padding:8px 11px;border:1px solid var(--border2);border-radius:6px;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text);background:var(--surface);resize:vertical;min-height:80px;outline:none;transition:border-color .15s;}
.form-textarea:focus{border-color:var(--a1);box-shadow:0 0 0 3px var(--a1-dim);}
.form-select{width:100%;padding:8px 11px;border:1px solid var(--border2);border-radius:6px;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text);background:var(--surface);outline:none;cursor:pointer;}
.form-select:focus{border-color:var(--a1);}
.upload-skill-zone{border:1px dashed var(--border2);border-radius:8px;padding:20px;text-align:center;background:var(--surface2);cursor:pointer;transition:all .2s;margin-top:6px;}
.upload-skill-zone:hover{border-color:var(--a1);background:var(--a1-dim);}
.upload-skill-zone p{font-size:11px;color:var(--text3);margin-top:6px;}

/* ── ANIMATIONS ── */
@keyframes countUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
.count-anim{animation:countUp .5s ease forwards;}

    /* ── SETTINGS PAGE ── */
    .settings-layout{display:flex;gap:0;min-height:calc(100vh - 120px);}
    .settings-nav{width:200px;min-width:200px;background:var(--surface);border-right:1px solid var(--border);border-radius:10px 0 0 10px;padding:8px 0;flex-shrink:0;}
    .settings-nav-hd{padding:10px 14px 6px;border-bottom:1px solid var(--border);margin-bottom:4px;}
    .settings-nav-title{font-size:9px;font-weight:700;color:var(--text4);letter-spacing:.1em;text-transform:uppercase;}
    .settings-nav-item{display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:12px;font-weight:500;color:var(--text3);cursor:pointer;transition:all .15s;border-left:2px solid transparent;}
    .settings-nav-item svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;flex-shrink:0;}
    .settings-nav-item:hover{background:var(--a1-dim);color:var(--a1);}
    .settings-nav-item.active{background:var(--a1-dim);color:var(--a1);border-left-color:var(--a1);font-weight:600;}
    .settings-nav-sep{height:1px;background:var(--border);margin:6px 14px;}
    .settings-content{flex:1;padding:20px 24px;background:var(--bg);border-radius:0 10px 10px 0;overflow-y:auto;}
    .settings-panel{display:none;}
    .settings-panel.active{display:block;}
    .settings-section{background:var(--surface);border:1px solid var(--border);border-radius:10px;margin-bottom:14px;overflow:hidden;}
    .settings-section-hd{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--surface2);}
    .settings-section-title{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--text2);}
    .settings-section-icon{width:22px;height:22px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .settings-section-icon svg{width:11px;height:11px;stroke:#fff;fill:none;stroke-width:2;}
    .settings-section-icon.a1{background:var(--a1);}
    .settings-section-icon.a2{background:var(--a2);}
    .settings-section-icon.a5{background:var(--a5);}
    .settings-section-body{padding:4px 0;}
    .settings-row{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--border);gap:16px;}
    .settings-row:last-child{border-bottom:none;}
    .settings-row-label{flex:1;min-width:0;}
    .settings-row-key{font-size:12px;font-weight:600;color:var(--text2);}
    .settings-row-desc{font-size:10px;color:var(--text4);margin-top:1px;}
    .settings-row-val{flex-shrink:0;min-width:200px;}
    .settings-input{width:100%;padding:6px 10px;border:1px solid var(--border2);border-radius:6px;font-size:12px;font-family:'Inter Tight',sans-serif;color:var(--text2);background:var(--surface);outline:none;transition:border .15s;}
    .settings-input:focus{border-color:var(--a1);box-shadow:0 0 0 2px var(--a1-dim);}
    .settings-textarea{min-height:80px;resize:vertical;line-height:1.5;}
    .settings-select{cursor:pointer;}
    .settings-toggle-row{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--border);}
    .settings-toggle-row:last-child{border-bottom:none;}
    .settings-toggle-label{font-size:12px;font-weight:600;color:var(--text2);}
    .settings-toggle-desc{font-size:10px;color:var(--text4);margin-top:1px;}
    .settings-toggle{width:36px;height:20px;border-radius:10px;border:none;cursor:pointer;position:relative;transition:background .2s;flex-shrink:0;}
    .settings-toggle.on{background:var(--a2);}
    .settings-toggle.off{background:var(--border3);}
    .settings-toggle::after{content:'';position:absolute;top:3px;width:14px;height:14px;border-radius:50%;background:#fff;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
    .settings-toggle.on::after{left:19px;}
    .settings-toggle.off::after{left:3px;}
    /* Agent persona card */
    .agent-persona-card{background:linear-gradient(135deg,var(--a1-dim) 0%,var(--a5-dim) 100%);border:1px solid var(--border2);border-radius:12px;padding:20px;margin-bottom:16px;text-align:center;}
    .agent-persona-avatar{width:52px;height:52px;border-radius:14px;background:var(--a1);display:flex;align-items:center;justify-content:center;margin:0 auto 10px;box-shadow:0 4px 14px var(--a1-glow);}
    .agent-persona-avatar svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:1.8;}
    .agent-persona-name{font-size:15px;font-weight:800;color:var(--text2);margin-bottom:3px;}
    .agent-persona-role{font-size:10px;color:var(--a1);font-weight:600;margin-bottom:8px;}
    .agent-persona-desc{font-size:11px;color:var(--text3);line-height:1.6;max-width:480px;margin:0 auto 10px;}
    .agent-persona-tags{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;}
    /* Memory */
    .memory-summary-box{background:linear-gradient(135deg,rgba(23,138,183,.06) 0%,rgba(159,172,36,.05) 100%);border:1px solid var(--border2);border-radius:12px;padding:16px;margin-bottom:16px;}
    .memory-summary-hd{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
    .memory-summary-icon{width:28px;height:28px;border-radius:8px;background:var(--a1);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .memory-summary-icon svg{width:13px;height:13px;stroke:#fff;fill:none;stroke-width:2;}
    .memory-summary-title{font-size:12px;font-weight:700;color:var(--text2);flex:1;}
    .memory-summary-auto{font-size:9px;color:var(--text4);}
    .memory-summary-text{font-size:11px;color:var(--text3);line-height:1.7;background:var(--surface);border-radius:8px;padding:10px 12px;border:1px solid var(--border);}
    .memory-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
    .memory-card{display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 12px;transition:border .15s;}
    .memory-card:hover{border-color:var(--border2);}
    .memory-card-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .memory-card-icon svg{width:12px;height:12px;stroke:#fff;fill:none;stroke-width:2;}
    .memory-card-icon.identity{background:var(--a1);}
    .memory-card-icon.project{background:var(--a2);}
    .memory-card-icon.pref{background:var(--a5);}
    .memory-card-icon.habit{background:#9B59B6;}
    .memory-card-body{flex:1;min-width:0;}
    .memory-card-key{font-size:10px;font-weight:700;color:var(--text4);text-transform:uppercase;letter-spacing:.05em;margin-bottom:2px;}
    .memory-card-val{font-size:11px;color:var(--text2);line-height:1.5;}
    .memory-card-meta{font-size:9px;color:var(--text4);margin-top:3px;}
    .memory-card-actions{display:flex;gap:3px;flex-shrink:0;}
    .memory-card-btn{width:22px;height:22px;border-radius:5px;border:1px solid var(--border);background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text4);transition:all .15s;}
    .memory-card-btn:hover{background:var(--a1-dim);color:var(--a1);border-color:var(--a1);}
    .memory-card-btn svg{width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:2;}
    .memory-add-btn{display:flex;align-items:center;gap:6px;padding:7px 14px;border:1px dashed var(--border2);border-radius:7px;background:none;cursor:pointer;font-size:11px;color:var(--text4);font-family:'Inter Tight',sans-serif;transition:all .15s;width:100%;}
    .memory-add-btn:hover{border-color:var(--a1);color:var(--a1);background:var(--a1-dim);}
    .memory-add-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;}

    /* ── WORKFLOW PAGE ── */
    .workflow-layout{display:flex;gap:16px;min-height:calc(100vh - 120px);}
    .workflow-left{flex:1;min-width:0;}
    .workflow-right{width:300px;flex-shrink:0;}
    /* Chat-to-Skill 入口 */
    .chat-to-skill{background:linear-gradient(135deg,rgba(159,172,36,.08) 0%,rgba(23,138,183,.06) 100%);border:1px solid var(--a2-dim2);border-radius:12px;padding:16px;margin-bottom:16px;}
    .chat-to-skill-hd{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
    .chat-to-skill-icon{width:36px;height:36px;border-radius:10px;background:var(--a2);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 3px 10px var(--a2-glow);}
    .chat-to-skill-icon svg{width:16px;height:16px;stroke:#fff;fill:none;stroke-width:2;}
    .chat-to-skill-title{font-size:13px;font-weight:800;color:var(--text2);}
    .chat-to-skill-sub{font-size:10px;color:var(--text4);margin-top:1px;}
    .chat-to-skill-preview{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:10px;}
    .chat-to-skill-preview-label{font-size:9px;font-weight:700;color:var(--text4);text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;}
    .chat-to-skill-steps{display:flex;flex-direction:column;gap:4px;}
    .chat-to-skill-step{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--text3);}
    .chat-to-skill-step-num{width:18px;height:18px;border-radius:50%;background:var(--a1-dim);color:var(--a1);font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .chat-to-skill-actions{display:flex;gap:8px;}
    /* Workflow card */
    .workflow-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;margin-bottom:10px;overflow:hidden;transition:border .15s,box-shadow .15s;}
    .workflow-card:hover{border-color:var(--border2);box-shadow:var(--shadow);}
    .workflow-card-hd{display:flex;align-items:center;gap:10px;padding:12px 14px;cursor:pointer;}
    .workflow-card-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .workflow-card-icon svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2;}
    .workflow-card-icon.blue{background:var(--a1);}
    .workflow-card-icon.green{background:var(--a2);}
    .workflow-card-icon.sky{background:var(--a5);}
    .workflow-card-icon.sand{background:#C0A060;}
    .workflow-card-meta{flex:1;min-width:0;}
    .workflow-card-name{font-size:12px;font-weight:700;color:var(--text2);}
    .workflow-card-desc{font-size:10px;color:var(--text4);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .workflow-card-badges{display:flex;gap:4px;flex-shrink:0;}
    .workflow-card-body{padding:0 14px 12px;display:none;}
    .workflow-card.open .workflow-card-body{display:block;}
    .workflow-steps{display:flex;flex-direction:column;gap:0;}
    .workflow-step{display:flex;gap:10px;position:relative;}
    .workflow-step:not(:last-child)::before{content:'';position:absolute;left:11px;top:24px;bottom:0;width:1px;background:var(--border2);}
    .workflow-step-num{width:22px;height:22px;border-radius:50%;background:var(--a1-dim);border:1px solid var(--a1);color:var(--a1);font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;}
    .workflow-step-body{flex:1;padding-bottom:12px;}
    .workflow-step-title{font-size:11px;font-weight:700;color:var(--text2);}
    .workflow-step-desc{font-size:10px;color:var(--text3);margin-top:2px;line-height:1.5;}
    .workflow-step-tool{display:inline-flex;align-items:center;gap:4px;font-size:9px;color:var(--a1);background:var(--a1-dim);padding:2px 7px;border-radius:4px;margin-top:4px;}
    /* Workflow stats */
    .workflow-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
    .workflow-stat{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 12px;text-align:center;}
    .workflow-stat-val{font-size:20px;font-weight:800;color:var(--a1);font-family:'JetBrains Mono',monospace;}
    .workflow-stat-label{font-size:9px;color:var(--text4);margin-top:2px;}
    /* Workflow filter */
