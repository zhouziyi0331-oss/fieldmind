            page.style.display = 'none';
        });
        
        const targetPage = document.getElementById('page-' + pageId);
        if (targetPage) {
            targetPage.classList.add('active');
            targetPage.style.display = 'block';
            console.log('✅ 页面已显示: page-' + pageId);
        } else {
            console.error('❌ 页面不存在: page-' + pageId);
        }
        
        return true;
    };
    
    // 2. 完全重写 goStep
    window.goStep = function(stepNum) {
        console.log('🟢 goStep(' + stepNum + ') 执行');
        
        const allPanels = document.querySelectorAll('.step-panel');
        allPanels.forEach(function(panel) {
            panel.classList.remove('active');
            panel.style.display = 'none';
        });
        
        const targetPanel = document.getElementById('step-' + stepNum);
        if (targetPanel) {
            targetPanel.classList.add('active');
            targetPanel.style.display = 'block';
            console.log('✅ 步骤已显示: step-' + stepNum);
            
            // 更新步骤指示器
            for (var i = 1; i <= 5; i++) {
                var circle = document.getElementById('sc-' + i);
                var label = document.getElementById('sl-' + i);
                if (circle) {
                    if (i < stepNum) {
                        circle.className = 'step-circle done';
                        circle.textContent = '✓';
                        if (label) label.className = 'step-label done';
                    } else if (i === stepNum) {
                        circle.className = 'step-circle active';
                        circle.textContent = i.toString();
                        if (label) label.className = 'step-label active';
                    } else {
                        circle.className = 'step-circle pending';
                        circle.textContent = i === 5 ? '✓' : i.toString();
                        if (label) label.className = 'step-label pending';
                    }
                }
            }
        } else {
            console.error('❌ 步骤不存在: step-' + stepNum);
        }
        
        return true;
    };
    
    // 3. 完全重写 createNewProject
    window.createNewProject = function() {
        console.log('🟣 createNewProject() 执行');
        showPage('newproject');
        setTimeout(function() {
            goStep(1);
        }, 200);
        return true;
    };
    
    // 4. 强制绑定所有按钮
    setTimeout(function() {
        console.log('🔧 强制绑定按钮事件...');
        
        // 绑定所有包含 goStep 的按钮
        document.querySelectorAll('button[onclick*="goStep"]').forEach(function(btn) {
            var match = btn.getAttribute('onclick').match(/goStep\((\d+)\)/);
            if (match) {
                var step = parseInt(match[1]);
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('🖱️ 按钮点击: goStep(' + step + ')');
                    goStep(step);
                }, true);
            }
        });
        
        // 绑定新建项目按钮
        document.querySelectorAll('[onclick*="createNewProject"]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('🖱️ 按钮点击: createNewProject()');
                createNewProject();
            }, true);
        });
        
        console.log('✅ 按钮绑定完成');
    }, 1000);
    
    // 5. 提供测试函数
    window.TEST_NEW_PROJECT = function() {
        console.log('🧪 手动测试新建项目');
        createNewProject();
    };
    
    window.TEST_GO_STEP_2 = function() {
        console.log('🧪 手动测试跳转步骤2');
        goStep(2);
    };
    
    console.log('');
    console.log('%c✅ 修复完成！现在可以测试：', 'color: green; font-size: 14px; font-weight: bold;');
    console.log('%c  1. 点击"新建项目"按钮', 'color: blue;');
    console.log('%c  2. 点击"下一步：导入资料"按钮', 'color: blue;');
    console.log('%c  或输入: TEST_NEW_PROJECT() 手动测试', 'color: orange;');
    console.log('');
    
})();
</script>


