"""
项目管理API端点
"""
from typing import List, Optional
from fastapi import APIRouter, Depends, HTTPException, Request
from sqlalchemy.orm import Session
from pydantic import BaseModel
from datetime import datetime

from app.database import get_db
from app.models.project import Project
from app.core.rate_limit import limiter, RateLimitConfig

router = APIRouter()


# ==================== 请求/响应模型 ====================
class ProjectCreate(BaseModel):
    name: str
    description: Optional[str] = None


class ProjectUpdate(BaseModel):
    name: Optional[str] = None
    description: Optional[str] = None


class ProjectResponse(BaseModel):
    id: int
    name: str
    description: Optional[str]
    documents: int
    contexts: int
    created_at: datetime
    updated_at: datetime

    class Config:
        from_attributes = True


# ==================== API端点 ====================
@router.post("/", response_model=ProjectResponse)
@limiter.limit(RateLimitConfig.PROJECT_CREATE)
async def create_project(
    request: Request,
    project: ProjectCreate,
    db: Session = Depends(get_db)
):
    """
    创建新项目
    """
    new_project = Project(
        name=project.name,
        description=project.description,
        documents=0,
        contexts=0
    )

    db.add(new_project)
    db.commit()
    db.refresh(new_project)

    return new_project


@router.get("/", response_model=dict)
@limiter.limit(RateLimitConfig.PROJECT_LIST)
async def list_projects(
    request: Request,
    skip: int = 0,
    limit: int = 50,
    db: Session = Depends(get_db)
):
    """
    获取项目列表
    """
    projects = db.query(Project).offset(skip).limit(limit).all()
    total = db.query(Project).count()

    return {
        "projects": projects,
        "total": total,
        "skip": skip,
        "limit": limit
    }


@router.get("/{project_id}", response_model=ProjectResponse)
@limiter.limit(RateLimitConfig.PROJECT_CRUD)
async def get_project(
    request: Request,
    project_id: int,
    db: Session = Depends(get_db)
):
    """
    获取项目详情
    """
    project = db.query(Project).filter(Project.id == project_id).first()

    if not project:
        raise HTTPException(status_code=404, detail="Project not found")

    return project


@router.put("/{project_id}", response_model=ProjectResponse)
@limiter.limit(RateLimitConfig.PROJECT_CRUD)
async def update_project(
    request: Request,
    project_id: int,
    update: ProjectUpdate,
    db: Session = Depends(get_db)
):
    """
    更新项目信息
    """
    project = db.query(Project).filter(Project.id == project_id).first()

    if not project:
        raise HTTPException(status_code=404, detail="Project not found")

    if update.name is not None:
        project.name = update.name
    if update.description is not None:
        project.description = update.description

    project.updated_at = datetime.utcnow()

    db.commit()
    db.refresh(project)

    return project


@router.delete("/{project_id}")
@limiter.limit(RateLimitConfig.PROJECT_CRUD)
async def delete_project(
    request: Request,
    project_id: int,
    db: Session = Depends(get_db)
):
    """
    删除项目
    """
    project = db.query(Project).filter(Project.id == project_id).first()

    if not project:
        raise HTTPException(status_code=404, detail="Project not found")

    db.delete(project)
    db.commit()

    return {"message": "Project deleted successfully"}


@router.get("/{project_id}/documents")
@limiter.limit(RateLimitConfig.DOCUMENT_LIST)
async def get_project_documents(
    request: Request,
    project_id: int,
    db: Session = Depends(get_db)
):
    """
    获取项目关联的文档
    """
    project = db.query(Project).filter(Project.id == project_id).first()

    if not project:
        raise HTTPException(status_code=404, detail="Project not found")

    # TODO: 实现项目-文档关联表查询
    return {
        "project_id": project_id,
        "documents": []
    }


@router.get("/{project_id}/contexts")
@limiter.limit(RateLimitConfig.PROJECT_LIST)
async def get_project_contexts(
    request: Request,
    project_id: int,
    db: Session = Depends(get_db)
):
    """
    获取项目关联的知识脉络
    """
    project = db.query(Project).filter(Project.id == project_id).first()

    if not project:
        raise HTTPException(status_code=404, detail="Project not found")

    # TODO: 实现项目-脉络关联表查询
    return {
        "project_id": project_id,
        "contexts": []
    }
