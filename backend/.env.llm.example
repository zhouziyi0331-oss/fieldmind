# P3 LLM 提供商配置
# 按需配置，只配置你想用的提供商即可

# ================================
# OpenAI 配置
# ================================
# 支持模型: GPT-4, GPT-4o, GPT-3.5-turbo
# 官网: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ================================
# Anthropic (Claude) 配置
# ================================
# 支持模型: Claude 3.5 Sonnet, Claude 3 Opus, Claude 3 Haiku
# 官网: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ================================
# DeepSeek 配置（国产）
# ================================
# 支持模型: deepseek-chat, deepseek-coder
# 官网: https://platform.deepseek.com/
# 特点: 性价比极高，中文友好
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ================================
# Kimi (Moonshot) 配置（国产）
# ================================
# 支持模型: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
# 官网: https://platform.moonshot.cn/
# 特点: 超长上下文，中文优化
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_DEFAULT_MODEL=moonshot-v1-8k

# ================================
# P3 路由策略配置
# ================================
# 路由策略: cost_optimized (成本优化) | performance_optimized (性能优先) | balanced (平衡)
P3_ROUTING_STRATEGY=balanced

# 自动路由规则（可选）
# simple: 简单任务 -> DeepSeek/Kimi
# medium: 中等任务 -> GPT-4o-mini/Claude Haiku
# complex: 复杂任务 -> GPT-4/Claude Sonnet
P3_AUTO_ROUTING=true

# 成本限制（可选，单位：美元/月）
P3_MONTHLY_BUDGET=100

# ================================
# 提供商优先级（从高到低）
# ================================
# 当多个提供商可用时，按此顺序选择
# 可根据个人偏好调整顺序
P3_PROVIDER_PRIORITY=deepseek,kimi,openai,anthropic
