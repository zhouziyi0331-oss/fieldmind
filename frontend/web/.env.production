# Production Environment Configuration
# FieldMind Frontend - Production Build Settings

# API Base URL - REQUIRED for production deployment
# This must be set to your production backend URL
# Examples:
#   - https://api.fieldmind.com
#   - https://fieldmind-backend.yourcompany.com
#   - https://your-domain.com/api
VITE_API_BASE_URL=https://your-production-api-url.com

# Development note:
# The code has localhost:8000 fallbacks for development convenience only.
# In production, this environment variable MUST be set to avoid runtime errors.
