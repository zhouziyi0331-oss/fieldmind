# FieldMind 环境配置文件模板
# 复制此文件为 .env 并填入实际配置

# ============================================
# 应用基础配置
# ============================================
APP_NAME=FieldMind
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ============================================
# 数据库配置
# ============================================

# SQLite (开发环境默认)
DATABASE_URL=sqlite:///./data/fieldmind.db

# PostgreSQL (生产环境)
POSTGRES_USER=fieldmind
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fieldmind

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Redis 缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ChromaDB 向量数据库
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=fieldmind_documents

# ============================================
# AI 服务配置
# ============================================

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama 本地大模型
OLLAMA_API_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 向量嵌入模型
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# HuggingFace Token (可选)
HUGGINGFACE_TOKEN=

# ============================================
# 语音识别配置
# ============================================

# 语音识别引擎: whisper 或 funasr
ASR_ENGINE=funasr

# Whisper 配置
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_USE_LOCAL=true
WHISPER_MODEL_SIZE=base

# FunASR 配置
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_HOTWORDS=口述历史 田野调查

# ============================================
# 第三方集成服务
# ============================================

# RAGFlow - RAG 服务
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=

# MinerU - PDF 解析服务
MINERU_API_URL=http://localhost:8765

# Crawl4AI - 网页爬虫服务
CRAWL4AI_API_URL=http://localhost:8080

# Mem0 - 记忆管理服务
MEM0_API_URL=http://localhost:8081

# Cognee - 知识图谱构建
COGNEE_API_URL=http://localhost:8082

# GraphRAG - 图增强RAG
GRAPHRAG_API_URL=http://localhost:8083

# Khoj - 智能搜索
KHOJ_API_URL=http://localhost:8084

# Firecrawl API (可选)
FIRECRAWL_API_KEY=

# ============================================
# 文件存储配置
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000
CHROMADB_PATH=./data/chromadb
WHOOSH_INDEX_PATH=./data/whoosh
VISUALIZATION_OUTPUT_DIR=./data/visualizations
REPORT_OUTPUT_DIR=./data/reports

# ============================================
# 安全配置
# ============================================

# JWT 密钥 (生产环境必须修改!)
SECRET_KEY=your-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS 配置
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,capacitor://localhost,ionic://localhost

# ============================================
# 监控与日志
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ============================================
# Celery 任务队列
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# 开发工具
# ============================================
ENABLE_DOCS=True
ENABLE_METRICS=True
